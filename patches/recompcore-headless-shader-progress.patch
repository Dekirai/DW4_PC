@@ -0,0 +1,71 @@
+// Copyright 2026 DW4_PC contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include "Common/SystemResource.h"
+
+#include <algorithm>
+
+#include "Common/FileUtil.h"
+
+namespace File
+{
+namespace
+{
+#ifdef MODERNGEKKO_EMBED_SYSTEM_RESOURCES
+struct SystemResource
+{
+  std::string_view path;
+  std::span<const u8> bytes;
+};
+
+#include "moderngekko_system_resources.inc"
+#endif
+}  // namespace
+
+std::span<const u8> ReadSystemResource([[maybe_unused]] std::string_view relative_path)
+{
+#ifdef MODERNGEKKO_EMBED_SYSTEM_RESOURCES
+  std::string normalized(relative_path);
+  std::ranges::replace(normalized, '\\', '/');
+  // Collapse separators only in a relative resource name, after any Sys root check.
+  // Dot segments are intentionally left intact and cannot match the allowlist.
+  normalized.erase(std::unique(normalized.begin(), normalized.end(),
+                               [](char left, char right) { return left == '/' && right == '/'; }),
+                   normalized.end());
+  for (const auto& resource : system_resources)
+  {
+    if (resource.path == normalized)
+      return resource.bytes;
+  }
+#endif
+  return {};
+}
+
+std::span<const u8> ReadSystemResourceFromPath(std::string_view path)
+{
+  std::string root = GetSysDirectory();
+  std::ranges::replace(root, '\\', '/');
+  if (!root.ends_with('/'))
+    root += '/';
+  std::string normalized(path);
+  std::ranges::replace(normalized, '\\', '/');
+  if (!normalized.starts_with(root))
+    return {};
+  path = normalized;
+  path.remove_prefix(root.size());
+  while (path.starts_with('/'))
+    path.remove_prefix(1);
+  return ReadSystemResource(path);
+}
+
+bool ReadFileToStringOrSystemResource(const std::string& path, std::string& contents)
+{
+  if (ReadFileToString(path, contents))
+    return true;
+  const auto bytes = ReadSystemResourceFromPath(path);
+  if (bytes.empty())
+    return false;
+  contents.assign(reinterpret_cast<const char*>(bytes.data()), bytes.size());
+  return true;
+}
+}  // namespace File
