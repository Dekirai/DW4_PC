diff --git a/Source/UnitTests/Common/IniFileTest.cpp b/Source/UnitTests/Common/IniFileTest.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..98d44c08b7077404ab53943544600a8553fcdc0b
--- /dev/null
+++ b/Source/UnitTests/Common/IniFileTest.cpp
@@ -0,0 +1,45 @@
+// Copyright 2026 DW4_PC contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include <gtest/gtest.h>
+
+#include "Common/IniFile.h"
+
+TEST(IniFile, MemoryResourcePreservesBomCrlfAndRawCheatLines)
+{
+  std::istringstream source("\xef\xbb\xbf[Core]\r\nCPUThread = False\r\n"
+                            "[ActionReplay]\r\n$Synthetic code\r\n01234567 89ABCDEF\r\n");
+  Common::IniFile ini;
+  ASSERT_TRUE(ini.Load(source));
+  bool cpu_thread = true;
+  ASSERT_TRUE(ini.GetIfExists("Core", "CPUThread", &cpu_thread));
+  EXPECT_FALSE(cpu_thread);
+  std::vector<std::string> codes;
+  ASSERT_TRUE(ini.GetLines("ActionReplay", &codes));
+  EXPECT_EQ(codes, (std::vector<std::string>{"$Synthetic code", "01234567 89ABCDEF"}));
+}
+
+TEST(IniFile, MemoryResourceKeepsLayerPrecedenceAndResetSemantics)
+{
+  Common::IniFile ini;
+  std::istringstream defaults("[Core]\nCPUThread = True\nSpeed = 1\n");
+  ASSERT_TRUE(ini.Load(defaults));
+  std::istringstream user("[Core]\nCPUThread = False\n");
+  ASSERT_TRUE(ini.Load(user, true));
+  bool cpu_thread = true;
+  int speed = 0;
+  ASSERT_TRUE(ini.GetIfExists("Core", "CPUThread", &cpu_thread));
+  ASSERT_TRUE(ini.GetIfExists("Core", "Speed", &speed));
+  EXPECT_FALSE(cpu_thread);
+  EXPECT_EQ(speed, 1);
+  std::istringstream failed;
+  failed.setstate(std::ios::failbit);
+  EXPECT_FALSE(ini.Load(failed, true));
+  EXPECT_TRUE(ini.Exists("Core", "Speed"));
+  EXPECT_FALSE(ini.Load(failed, false));
+  EXPECT_FALSE(ini.Exists("Core"));
+}
