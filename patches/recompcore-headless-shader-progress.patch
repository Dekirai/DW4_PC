+    {
+      if (!OwnThread()) return;
+      if (m_pending) { ++m_report.crossing_cutoff; m_pending = false; }
+      const Counter now = ReadWall();
+      if (now.valid)
+      {
+        if (IsActive()) Finish(now.value);
+        else { m_report.window_missed = true; m_report.observed_end_ns = now.value; m_report.state = State::Completed; }
+      }
+    }
+  }
+
+  // No concurrent mutation/read: only the owner or a quiesced shutdown caller.
+  const Report<Capacity>& GetReport() const noexcept { return m_report; }
+
+private:
+  static constexpr u64 MAX = (std::numeric_limits<u64>::max)();
+  u32 NextGap() noexcept
+  {
+    m_rng ^= m_rng << 13;
+    m_rng ^= m_rng >> 17;
+    m_rng ^= m_rng << 5;
+    return 1u + m_rng % (2u * m_report.config.mean_sample_stride - 1u);
+  }
+  bool OwnThread() noexcept
+  {
+    if (m_reader.ThreadId() == m_report.owner_thread_id) return true;
+    ++m_report.thread_mismatches;
+    m_report.state = State::Invalid;
+    return false;
+  }
+  Counter ReadWall() noexcept
+  {
+    Counter value = m_reader.Wall();
+    if (!value.valid || value.value < m_last_wall)
+    {
+      ++m_report.wall_failures;
+      if (value.valid) ++m_report.counter_resets;
+      m_report.last_platform_error = value.error;
+      m_report.state = State::Invalid;
+      value.valid = false;
+    }
+    else m_last_wall = value.value;
+    return value;
+  }
+  Counter ReadCycles() noexcept
+  {
+    Counter value = m_reader.Cycles();
+    if (value.thread_id != m_report.owner_thread_id)
+    {
+      ++m_report.thread_mismatches;
+      m_report.state = State::Invalid;
+      value.valid = false;
+    }
+    if (!value.valid) { ++m_report.cycle_failures; m_report.last_platform_error = value.error; }
+    return value;
+  }
+  CpuTimes ReadCpu() noexcept
+  {
+    CpuTimes value = m_reader.Cpu();
+    if (value.thread_id != m_report.owner_thread_id)
+    {
+      ++m_report.thread_mismatches;
+      m_report.state = State::Invalid;
+      value.valid = false;
+    }
+    if (!value.valid) { ++m_report.cpu_failures; m_report.last_platform_error = value.error; }
+    return value;
+  }
+  void Add(u64& total, u64 value) noexcept
+  {
+    if (value > MAX - total) { total = MAX; ++m_report.accumulation_overflows; }
+    else total += value;
+  }
+  Entry* Find(u32 pc) noexcept
+  {
+    const std::size_t first = (static_cast<u64>(pc) * 2654435761u) % Capacity;
+    for (std::size_t i = 0; i < Capacity; ++i)
+    {
+      Entry& entry = m_report.entries[(first + i) % Capacity];
+      if (entry.used && entry.pc == pc) return &entry;
+      if (!entry.used) { entry.used = true; entry.pc = pc; return &entry; }
+    }
+    return nullptr;
+  }
+  void Calibrate() noexcept
+  {
+    auto& c = m_report.calibration;
+    for (u32 i = 0; i < 16; ++i)
+    {
+      ++c.attempts;
+      const Counter w0 = ReadWall();
+      const Counter c0 = ReadCycles();
+      const Counter c1 = ReadCycles();
+      const Counter w1 = ReadWall();
+      if (m_report.state == State::Invalid) return;
+      if (w0.valid && w1.valid)
+      {
+        const u64 delta = w1.value - w0.value;
+        if (!c.valid_wall_pairs || delta < c.wall_ns_min) c.wall_ns_min = delta;
+        ++c.valid_wall_pairs;
+        Add(c.wall_ns_sum, delta);
+      }
+      if (c0.valid && c1.valid && c1.value >= c0.value)
+      {
+        const u64 delta = c1.value - c0.value;
+        if (!c.valid_cycle_pairs || delta < c.cycles_min) c.cycles_min = delta;
+        ++c.valid_cycle_pairs;
+        Add(c.cycles_sum, delta);
+        if (!delta) ++c.zero_cycle_pairs;
+      }
+      else if (c0.valid && c1.valid) ++m_report.counter_resets;
+    }
+  }
+  void Finish(u64 wall) noexcept
+  {
+    const CpuTimes cpu = ReadCpu();
+    m_report.observed_end_ns = wall;
+    m_report.cutoff_reached = wall >= m_report.scheduled_end_ns;
+    if (wall > m_report.scheduled_end_ns) m_report.cutoff_overshoot_ns = wall - m_report.scheduled_end_ns;
+    if (m_start_cpu.valid && cpu.valid)
+    {
+      if (cpu.user_100ns >= m_start_cpu.user_100ns && cpu.kernel_100ns >= m_start_cpu.kernel_100ns)
+      {
+        m_report.user_100ns = cpu.user_100ns - m_start_cpu.user_100ns;
+        m_report.kernel_100ns = cpu.kernel_100ns - m_start_cpu.kernel_100ns;
+        if (m_report.user_100ns <= MAX - m_report.kernel_100ns)
+        {
+          m_report.cpu_available = true;
+          m_report.cpu_100ns = m_report.user_100ns + m_report.kernel_100ns;
+        }
+        else ++m_report.accumulation_overflows;
+      }
+      else ++m_report.counter_resets;
+    }
+    if (m_report.state != State::Invalid) m_report.state = State::Completed;
+  }
+
+  Reader m_reader;
+  Report<Capacity> m_report{};
+  bool m_origin_set = false;
+  bool m_pending = false;
+  u32 m_rng = 0;
+  u32 m_remaining = 1;
+  u32 m_sample_pc = 0;
+  u64 m_last_wall = 0;
+  u64 m_start_wall = 0;
+  Counter m_start_cycles{};
+  CpuTimes m_start_cpu{};
+};
+} // namespace StaticRecompDispatchProbe
diff --git a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompDw4Cache.h b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompDw4Cache.h
new file mode 100644
index 0000000000000000000000000000000000000000..515f007105a848eeb0d43aa2eb73f2e2962af7d5
--- /dev/null
+++ b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompDw4Cache.h
@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <string_view>
+
+#include "Core/PowerPC/StaticRecomp/StaticRecompABI.h"
+
+namespace StaticRecompDw4Cache
+{
+struct Loop
+{
+  u32 pc;  // addi reentry after the real cache instruction.
+  u32 instruction;
+};
+inline constexpr std::array<Loop, 3> LOOPS{{
+    {0x8025d3a4u, 0x7c00186cu},  // dcbst, terminal blr
+    {0x8025d318u, 0x7c0018acu},  // dcbf, terminal sc
+    {0x8025d2ecu, 0x7c001bacu},  // dcbi, terminal blr
+}};
+
+inline const Loop* FindLoop(u32 pc)
+{
+  for (const auto& loop : LOOPS)
+    if (loop.pc == pc)
+      return &loop;
+  return nullptr;
+}
+constexpr u32 CHUNK_START = 0x8025c160u;
+constexpr u32 CHUNK_END = 0x80260160u;
+constexpr u64 CHUNK_HASH = 0x350b8c917f12ea10ull;
+constexpr u32 MAX_LINES = 256;
+constexpr u32 BAT_BYTES = 0x20000;
+
+struct Environment
+{
+  bool enabled = false;
+  bool module_active = false;
+  bool running = false;
+  bool lockstep = false;
+  bool chunk_verified = false;
+  bool chunk_has_hooks = false;
+  bool forced_fallback = false;
+  bool dcache_enabled = false;
+  u32 pending_exceptions = 0;
+  u32 generic_idle_pc = 0;
+  u32 ppc_msr = 0;
+  u32 dispatch_address = 0;
+  u32 dispatch_r3 = 0;
+  u32 dispatch_ctr = 0;
+  u64 completed_hooks = 0;
+  s64 dispatch_charge = 0;
+  s32 downcount = 0;
+  std::string_view game_id;
+  const StaticRecompModuleDesc* module = nullptr;
+  u32 chunk_index = 0;
+};
+
+struct Batch
+{
+  u32 address = 0;  // Aligned effective address of the NEXT cache instruction.
+  u32 lines = 0;
+};
+
+inline u32 ReadWord(const CPUState& cpu, u32 address)
+{
+  const u8* p = cpu.ram + (address - 0x80000000u);
+  return (static_cast<u32>(p[0]) << 24) | (static_cast<u32>(p[1]) << 16) |
+         (static_cast<u32>(p[2]) << 8) | p[3];
+}
+
+// This policy describes additional complete loop reentries AFTER one genuine
+// addi/bdnz/cache dispatch. It never consumes the final blr or dcbf's sc exit.
+inline Batch Prepare(const CPUState& cpu, const Environment& env)
+{
+  const Loop* loop = FindLoop(env.dispatch_address);
+  // The real dcb* hook and identity-IBAT invalidation path consult neither EE
+  // nor RI. Native MSR changes can leave these two chassis bits stale until
+  // SyncOut; preserve that state rather than synchronizing or changing it here.
+  // All other MSR bits must agree. Pending exceptions still reject batching,
+  // and the same timing endpoint/final real dispatch preserves their delivery.
+  constexpr u32 deferred_msr_bits = PPC_MSR_EE | PPC_MSR_RI;
+  if (!env.enabled || !env.module_active || !env.running || env.lockstep ||
+      !env.chunk_verified || env.chunk_has_hooks || env.forced_fallback ||
+      env.dcache_enabled || env.pending_exceptions != 0 || env.generic_idle_pc != 0 ||
+      env.game_id != "GDJEB2" ||
+      !loop || cpu.pc != loop->pc || env.dispatch_charge != 2 ||
+      cpu.downcount != -2 || env.completed_hooks != 1 || env.dispatch_ctr <= 1 ||
+      cpu.ctr != env.dispatch_ctr - 1 || cpu.ctr <= 1 ||
+      static_cast<u64>(env.dispatch_r3) + 32 != cpu.gpr[3] ||
+      cpu.exception != 0 || cpu.program_exception != 0 ||
+      ((cpu.msr ^ env.ppc_msr) & ~deferred_msr_bits) != 0)
+    return {};
+
+  const auto* module = env.module;
+  if (!module || std::string_view(module->game_id, 7) != std::string_view("GDJEB2\0", 7) ||
+      module->entry_point != 0x80005240u || module->num_rel_modules != 0 ||
+      !module->chunk_ranges || !module->chunk_hashes || env.chunk_index >= module->num_chunk_ranges ||
+      module->chunk_ranges[env.chunk_index].start != CHUNK_START ||
+      module->chunk_ranges[env.chunk_index].end != CHUNK_END ||
+      module->chunk_hashes[env.chunk_index] != CHUNK_HASH ||
+      !module->code_ranges || module->num_code_ranges == 0)
+    return {};
+
+  constexpr u32 required_msr = PPC_MSR_IR | PPC_MSR_DR;
+  constexpr u32 excluded_msr = PPC_MSR_POW | PPC_MSR_ILE | PPC_MSR_PR | PPC_MSR_SE |
+                               PPC_MSR_BE | PPC_MSR_IP | PPC_MSR_PM | PPC_MSR_LE;
+  if ((cpu.msr & required_msr) != required_msr || (cpu.msr & excluded_msr) != 0 ||
+      !cpu.ram || cpu.ram_size < CHUNK_END - 0x80000000u ||
+      ReadWord(cpu, loop->pc - 4) != loop->instruction ||
+      ReadWord(cpu, loop->pc) != 0x38630020u ||
+      ReadWord(cpu, loop->pc + 4) != 0x4200fff8u)
+    return {};
+
+  // The real cache instruction already charged five PPC cycles. Its two native
+  // cycles still need flushing. Leave a positive slice for a final REAL dispatch;
+  // preserve its usual 7-cycle overshoot, 3-cycle terminal addi/bdnz/blr, or
+  // 4-cycle addi/bdnz/sc with the actual system-call exception untouched.
+  const s64 remaining = static_cast<s64>(env.downcount) - 2;
+  if (remaining <= 7)
+    return {};
+  u32 lines = std::min({cpu.ctr - 1, static_cast<u32>((remaining - 1) / 7), MAX_LINES});
+  const u64 next_r3 = static_cast<u64>(cpu.gpr[3]) + 32;
+  if (next_r3 < 0x80000000ull || next_r3 >= 0x81800000ull)
+    return {};
+  const u32 address = static_cast<u32>(next_r3) & ~31u;
+  // Keep one BAT index: the integration verifies both endpoints against the
+  // actual instruction-translation API (IR), never assumes a DR mapping.
+  lines = std::min(lines, (BAT_BYTES - (address & (BAT_BYTES - 1))) / 32);
+  const u64 end = static_cast<u64>(address) + static_cast<u64>(lines) * 32;
+  if (lines == 0 || end > 0x81800000ull || end - 0x80000000ull > cpu.ram_size ||
+      static_cast<u64>(cpu.gpr[3]) + static_cast<u64>(lines) * 32 >= 0x81800000ull)
+    return {};
+  // No native code range may be invalidated early. This includes the executing
+  // chunk, whose normal per-dispatch SMC revalidation must never be skipped.
+  for (u32 i = 0; i < module->num_code_ranges; ++i)
+  {
+    const auto& code = module->code_ranges[i];
+    if (code.end <= code.start || (address < code.end && end > code.start))
+      return {};
+  }
+  return {address, lines};
+}
+
+template <typename Translate>
+bool HasIdentityMapping(const Batch& batch, Translate&& translate)
+{
+  if (batch.lines == 0)
+    return false;
+  for (const u32 address : {batch.address, batch.address + batch.lines * 32 - 1})
+  {
+    const auto mapped = translate(address);
+    if (!mapped.valid || !mapped.translated || !mapped.from_bat ||
+        mapped.address != address - 0x80000000u)
+      return false;
+  }
+  return true;
+}
+
+// Apply only after real InvalidateICacheLines has completed. Native and hook
+// costs intentionally remain separate, matching the existing chassis path.
+inline void Commit(CPUState& cpu, s32& downcount, s64& charge, const Batch& batch)
+{
+  cpu.gpr[3] += 32 * batch.lines;
+  cpu.ctr -= batch.lines;
+  downcount -= static_cast<s32>(5 * batch.lines);
+  charge += 2 * batch.lines;
+}
+}  // namespace StaticRecompDw4Cache
diff --git a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompDw4Idle.h b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompDw4Idle.h
new file mode 100644
index 0000000000000000000000000000000000000000..0f1b0020976c3a2a4c8c3eec5e15344352d49ac0
--- /dev/null
+++ b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompDw4Idle.h
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <string_view>
+
+#include "Core/PowerPC/StaticRecomp/StaticRecompABI.h"
+
+namespace StaticRecompDw4Idle
+{
+constexpr u32 LOOP_PC = 0x80261558u;
+constexpr u32 CHUNK_START = 0x80260160u;
+constexpr u32 CHUNK_END = 0x80264160u;
+constexpr u64 CHUNK_HASH = 0x00d854460830c5b1ull;
+constexpr s64 QUANTUM = 258;
+
+// All host facts are checked anew at a completed native dispatch. In particular,
+// a previous verification must not survive an SMC invalidation or state load.
+struct Environment
+{
+  bool enabled = false;
+  bool module_active = false;
+  bool running = false;
+  bool lockstep = false;
+  bool chunk_verified = false;
+  bool chunk_has_hooks = false;
+  bool forced_fallback = false;
+  u32 pending_exceptions = 0;
+  u32 generic_idle_pc = 0;
+  u32 dispatch_address = 0;
+  s64 dispatch_charge = 0;
+  s32 downcount = 0;
+  std::string_view game_id;
+  const StaticRecompModuleDesc* module = nullptr;
+  u32 chunk_index = 0;
+};
+
+inline u32 ReadWord(const CPUState& cpu, u32 address)
+{
+  const u8* p = cpu.ram + (address - 0x80000000u);
+  return (static_cast<u32>(p[0]) << 24) | (static_cast<u32>(p[1]) << 16) |
+         (static_cast<u32>(p[2]) << 8) | p[3];
+}
+
+// This returns an additional cycle charge, never a fabricated CPU state. The
+// normal dispatcher remains responsible for downcount/timebase accounting.
+inline u64 ExtraCycles(const CPUState& cpu, const Environment& env)
+{
+  if (!env.enabled || !env.module_active || !env.running || env.lockstep ||
+      !env.chunk_verified || env.chunk_has_hooks || env.forced_fallback ||
+      env.pending_exceptions != 0 || env.generic_idle_pc != 0 ||
+      env.game_id != "GDJEB2" || env.dispatch_address != LOOP_PC || cpu.pc != LOOP_PC ||
+      env.dispatch_charge != QUANTUM || cpu.downcount != -QUANTUM ||
+      env.downcount <= QUANTUM * 2 || cpu.exception != 0 || cpu.program_exception != 0)
+    return 0;
+
+  const auto* module = env.module;
+  if (!module || std::string_view(module->game_id, 7) != std::string_view("GDJEB2\0", 7) ||
+      module->entry_point != 0x80005240u || module->num_rel_modules != 0 ||
+      !module->chunk_ranges || !module->chunk_hashes || env.chunk_index >= module->num_chunk_ranges ||
+      module->chunk_ranges[env.chunk_index].start != CHUNK_START ||
+      module->chunk_ranges[env.chunk_index].end != CHUNK_END ||
+      module->chunk_hashes[env.chunk_index] != CHUNK_HASH)
+    return 0;
+
+  // The original privileged, big-endian idle context has interrupts and address
+  // translation enabled. Debug tracing, power management and pending exceptions
+  // are outside this optimization's supported execution profile.
+  constexpr u32 required_msr = PPC_MSR_EE | PPC_MSR_IR | PPC_MSR_DR;
+  constexpr u32 excluded_msr = PPC_MSR_POW | PPC_MSR_ILE | PPC_MSR_PR | PPC_MSR_SE |
+                               PPC_MSR_BE | PPC_MSR_IP | PPC_MSR_PM | PPC_MSR_LE;
+  if ((cpu.msr & required_msr) != required_msr || (cpu.msr & excluded_msr) != 0 ||
+      cpu.gpr[0] != 0 || cpu.gpr[13] != 0x80564f00u || cpu.gpr[30] != 0x80000000u ||
+      cpu.gpr[31] != 0x80514db8u || cpu.lr != LOOP_PC ||
+      (cpu.cr >> 28) != (2u | (cpu.xer >> 31)) ||
+      !cpu.ram || cpu.ram_size < 0x00565f14u)
+    return 0;
+
+  // Fresh physical memory reads: original instructions, ready mask, current
+  // thread, and both effective/physical OS context slots. A first return from
+  // OSEnableInterrupts does not pass the dispatch-address/charge gates above.
+  if (ReadWord(cpu, LOOP_PC) != 0x800d1010u ||
+      ReadWord(cpu, LOOP_PC + 4) != 0x28000000u ||
+      ReadWord(cpu, LOOP_PC + 8) != 0x4182fff8u ||
+      ReadWord(cpu, 0x80565f10u) != 0 || ReadWord(cpu, 0x800000e4u) != 0 ||
+      ReadWord(cpu, 0x800000d4u) != 0x805154e8u ||
+      ReadWord(cpu, 0x800000c0u) != 0x005154e8u)
+    return 0;
+
+  // The emitted loop returns after 86 three-instruction passes, charging 258.
+  // Elide only whole repetitions and leave 1..258 cycles for one final REAL
+  // dispatch. Its rounded overshoot and the next CoreTiming::Advance therefore
+  // match the unoptimized dispatcher, including nonmultiple slice lengths.
+  const s64 remaining = static_cast<s64>(env.downcount) - QUANTUM;
+  return static_cast<u64>(((remaining - 1) / QUANTUM) * QUANTUM);
+}
+
+// Synchronization may publish work or change the remaining timing slice. Never
+// reuse a pre-wait permission or charge; the reader must reconstruct live facts.
+template <typename Reader, typename Synchronize>
+u64 SynchronizedExtraCycles(bool sync_required, Reader&& read, Synchronize&& synchronize)
+{
+  const u64 initial = read();
+  if (initial != 0 && sync_required)
+  {
+    synchronize();
+    return read();
+  }
+  return initial;
+}
+}  // namespace StaticRecompDw4Idle
