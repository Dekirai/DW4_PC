--- /dev/null
+++ b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompDw4Idle.h
@@ -0,0 +1,110 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <string_view>
+
+#include "Core/PowerPC/StaticRecomp/StaticRecompABI.h"
+
+namespace StaticRecompDw4Idle
+{
+constexpr u32 LOOP_PC = 0x80261558u;
+constexpr u32 CHUNK_START = 0x80260160u;
+constexpr u32 CHUNK_END = 0x80264160u;
+constexpr u64 CHUNK_HASH = 0x00d854460830c5b1ull;
+constexpr s64 QUANTUM = 258;
+
+// All host facts are checked anew at a completed native dispatch. In particular,
+// a previous verification must not survive an SMC invalidation or state load.
+struct Environment
+{
+  bool enabled = false;
+  bool module_active = false;
+  bool running = false;
+  bool lockstep = false;
+  bool chunk_verified = false;
+  bool chunk_has_hooks = false;
+  bool forced_fallback = false;
+  u32 pending_exceptions = 0;
+  u32 generic_idle_pc = 0;
+  u32 dispatch_address = 0;
+  s64 dispatch_charge = 0;
+  s32 downcount = 0;
+  std::string_view game_id;
+  const StaticRecompModuleDesc* module = nullptr;
+  u32 chunk_index = 0;
+};
+
+inline u32 ReadWord(const CPUState& cpu, u32 address)
+{
+  const u8* p = cpu.ram + (address - 0x80000000u);
+  return (static_cast<u32>(p[0]) << 24) | (static_cast<u32>(p[1]) << 16) |
+         (static_cast<u32>(p[2]) << 8) | p[3];
+}
+
+// This returns an additional cycle charge, never a fabricated CPU state. The
+// normal dispatcher remains responsible for downcount/timebase accounting.
+inline u64 ExtraCycles(const CPUState& cpu, const Environment& env)
+{
+  if (!env.enabled || !env.module_active || !env.running || env.lockstep ||
+      !env.chunk_verified || env.chunk_has_hooks || env.forced_fallback ||
+      env.pending_exceptions != 0 || env.generic_idle_pc != 0 ||
+      env.game_id != "GDJEB2" || env.dispatch_address != LOOP_PC || cpu.pc != LOOP_PC ||
+      env.dispatch_charge != QUANTUM || cpu.downcount != -QUANTUM ||
+      env.downcount <= QUANTUM * 2 || cpu.exception != 0 || cpu.program_exception != 0)
+    return 0;
+
+  const auto* module = env.module;
+  if (!module || std::string_view(module->game_id, 7) != std::string_view("GDJEB2\0", 7) ||
+      module->entry_point != 0x80005240u || module->num_rel_modules != 0 ||
+      !module->chunk_ranges || !module->chunk_hashes || env.chunk_index >= module->num_chunk_ranges ||
+      module->chunk_ranges[env.chunk_index].start != CHUNK_START ||
+      module->chunk_ranges[env.chunk_index].end != CHUNK_END ||
+      module->chunk_hashes[env.chunk_index] != CHUNK_HASH)
+    return 0;
+
+  // The original privileged, big-endian idle context has interrupts and address
+  // translation enabled. Debug tracing, power management and pending exceptions
+  // are outside this optimization's supported execution profile.
+  constexpr u32 required_msr = PPC_MSR_EE | PPC_MSR_IR | PPC_MSR_DR;
+  constexpr u32 excluded_msr = PPC_MSR_POW | PPC_MSR_ILE | PPC_MSR_PR | PPC_MSR_SE |
+                               PPC_MSR_BE | PPC_MSR_IP | PPC_MSR_PM | PPC_MSR_LE;
+  if ((cpu.msr & required_msr) != required_msr || (cpu.msr & excluded_msr) != 0 ||
+      cpu.gpr[0] != 0 || cpu.gpr[13] != 0x80564f00u || cpu.gpr[30] != 0x80000000u ||
+      cpu.gpr[31] != 0x80514db8u || cpu.lr != LOOP_PC ||
+      (cpu.cr >> 28) != (2u | (cpu.xer >> 31)) ||
+      !cpu.ram || cpu.ram_size < 0x00565f14u)
+    return 0;
+
+  // Fresh physical memory reads: original instructions, ready mask, current
+  // thread, and both effective/physical OS context slots. A first return from
+  // OSEnableInterrupts does not pass the dispatch-address/charge gates above.
+  if (ReadWord(cpu, LOOP_PC) != 0x800d1010u ||
+      ReadWord(cpu, LOOP_PC + 4) != 0x28000000u ||
+      ReadWord(cpu, LOOP_PC + 8) != 0x4182fff8u ||
+      ReadWord(cpu, 0x80565f10u) != 0 || ReadWord(cpu, 0x800000e4u) != 0 ||
+      ReadWord(cpu, 0x800000d4u) != 0x805154e8u ||
+      ReadWord(cpu, 0x800000c0u) != 0x005154e8u)
+    return 0;
+
+  // The emitted loop returns after 86 three-instruction passes, charging 258.
+  // Elide only whole repetitions and leave 1..258 cycles for one final REAL
+  // dispatch. Its rounded overshoot and the next CoreTiming::Advance therefore
+  // match the unoptimized dispatcher, including nonmultiple slice lengths.
+  const s64 remaining = static_cast<s64>(env.downcount) - QUANTUM;
+  return static_cast<u64>(((remaining - 1) / QUANTUM) * QUANTUM);
+}
+
+// Synchronization may publish work or change the remaining timing slice. Never
+// reuse a pre-wait permission or charge; the reader must reconstruct live facts.
+template <typename Reader, typename Synchronize>
+u64 SynchronizedExtraCycles(bool sync_required, Reader&& read, Synchronize&& synchronize)
+{
+  const u64 initial = read();
+  if (initial != 0 && sync_required)
+  {
+    synchronize();
+    return read();
+  }
+  return initial;
+}
+}  // namespace StaticRecompDw4Idle
