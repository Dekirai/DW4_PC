+namespace StaticRecompDispatchProbe
+{
+using u64 = std::uint64_t;
+using u32 = std::uint32_t;
+constexpr u64 NS_PER_SECOND = 1000000000;
+struct Counter
+{
+  bool valid = false;
+  u64 value = 0;
+  u32 thread_id = 0;
+  u32 error = 0;
+};
+struct CpuTimes
+{
+  bool valid = false;
+  u64 user_100ns = 0;
+  u64 kernel_100ns = 0;
+  u32 thread_id = 0;
+  u32 error = 0;
+};
+
+// All methods are called only by the owning emulation thread. Never transfer
+// GetCurrentThread's pseudo-handle to a status, shutdown or sampling thread.
+struct WindowsReader
+{
+  Counter Wall() const noexcept
+  {
+    const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                        std::chrono::steady_clock::now().time_since_epoch()).count();
+    return {ns >= 0, ns >= 0 ? static_cast<u64>(ns) : 0, 0, 0};
+  }
+  u32 ThreadId() const noexcept
+  {
+#ifdef _WIN32
+    return GetCurrentThreadId();
+#else
+    return 0;
+#endif
+  }
+  Counter Cycles() const noexcept
+  {
+#ifdef _WIN32
+    ULONG64 cycles = 0;
+    const u32 id = GetCurrentThreadId();
+    const bool ok = QueryThreadCycleTime(GetCurrentThread(), &cycles) != 0;
+    return {ok, cycles, id, ok ? 0u : GetLastError()};
+#else
+    return {};
+#endif
+  }
+  CpuTimes Cpu() const noexcept
+  {
+#ifdef _WIN32
+    FILETIME creation{}, exit{}, kernel{}, user{};
+    const u32 id = GetCurrentThreadId();
+    const bool ok = GetThreadTimes(GetCurrentThread(), &creation, &exit, &kernel, &user) != 0;
+    return {ok, (static_cast<u64>(user.dwHighDateTime) << 32) | user.dwLowDateTime,
+            (static_cast<u64>(kernel.dwHighDateTime) << 32) | kernel.dwLowDateTime,
+            id, ok ? 0u : GetLastError()};
+#else
+    return {};
+#endif
+  }
+};
+
+struct Config
+{
+  bool enabled = false;
+  u64 start_delay_ns = 0;
+  u64 duration_ns = 15 * NS_PER_SECOND;
