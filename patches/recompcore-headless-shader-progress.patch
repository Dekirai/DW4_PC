 void CubebStream::StateCallback(cubeb_stream* stream, void* user_data, cubeb_state state)
 {
+  const auto* const self = static_cast<CubebStream*>(user_data);
+  auto& telemetry = self->m_mixer->GetTelemetryOwner()->device;
+  telemetry.last_state.store(static_cast<std::int32_t>(state), std::memory_order_relaxed);
+  switch (state)
+  {
+  case CUBEB_STATE_STARTED:
+    telemetry.state_started.fetch_add(1, std::memory_order_relaxed);
+    break;
+  case CUBEB_STATE_STOPPED:
+    telemetry.state_stopped.fetch_add(1, std::memory_order_relaxed);
+    break;
+  case CUBEB_STATE_DRAINED:
+    telemetry.state_drained.fetch_add(1, std::memory_order_relaxed);
+    break;
+  case CUBEB_STATE_ERROR:
+    telemetry.state_errors.fetch_add(1, std::memory_order_relaxed);
+    break;
+  }
 }
 
