+StaticRecompDispatchProbe::Config ReadDispatchProbeConfig()
+{
+  StaticRecompDispatchProbe::Config config;
+  const char* duration_text = std::getenv("STATICRECOMP_CPU_PROBE_SECONDS");
+  if (!duration_text)
+    return config;
+  const auto parse_seconds = [](const char* text, unsigned maximum, unsigned& value) {
+    if (!text || !*text)
+      return false;
+    const char* end = text + std::strlen(text);
+    const auto result = std::from_chars(text, end, value);
+    return result.ec == std::errc{} && result.ptr == end && value <= maximum;
+  };
+  unsigned duration = 0;
+  unsigned delay = 0;
+  const char* delay_text = std::getenv("STATICRECOMP_CPU_PROBE_DELAY_SECONDS");
+  if (!parse_seconds(duration_text, 30, duration) || duration == 0 ||
+      (delay_text && !parse_seconds(delay_text, 85, delay)))
+  {
+    std::fprintf(stderr, "[staticrecomp] cpu-probe configuration rejected\n");
+    return config;
+  }
+  config.enabled = true;
+  config.duration_ns = duration * StaticRecompDispatchProbe::NS_PER_SECOND;
+  config.start_delay_ns = delay * StaticRecompDispatchProbe::NS_PER_SECOND;
+  return config;
+}
+
+void WriteDispatchProbeReport(const StaticRecompDispatchProbe::Probe<>& probe)
+{
+  const auto& r = probe.GetReport();
+  if (!r.config.enabled)
+    return;
+  const auto relative = [&](u64 time) { return time >= r.origin_ns ? time - r.origin_ns : 0; };
+  const bool complete = r.state == StaticRecompDispatchProbe::State::Completed &&
+                        !r.window_missed && r.observed_end_ns >= r.scheduled_end_ns;
+  const u64 failures = r.wall_failures + r.cycle_failures + r.cpu_failures +
+                       r.thread_mismatches + r.counter_resets + r.accumulation_overflows +
+                       r.nested_rejections + r.unmatched_ends;
+  std::ostringstream summary;
+  summary << "complete=" << complete << " thread_cpu_valid=" << r.cpu_available
+          << " thread_id=" << r.owner_thread_id << " delay_ns=" << r.config.start_delay_ns
+          << " duration_ns=" << r.config.duration_ns
+          << " start_ns=" << relative(r.observed_start_ns) << " end_ns=" << relative(r.observed_end_ns)
+          << " cpu_100ns=" << r.cpu_100ns
+          << " opportunities=" << r.opportunities << " samples=" << r.accepted
+          << " failures=" << failures << " overflow=" << r.table_overflow_samples
+          << " seed=" << r.config.seed << " stride=" << r.config.mean_sample_stride
+          << " calibration_samples=" << r.calibration.valid_cycle_pairs
+          << " calibration_cycles=" << r.calibration.cycles_sum
+          << " calibration_wall_ns=" << r.calibration.wall_ns_sum;
+  std::fprintf(stderr, "[staticrecomp] cpu-probe: %s\n", summary.str().c_str());
+  for (const auto& entry : r.entries)
+  {
+    if (!entry.used)
+      continue;
+    std::fprintf(stderr,
+        "[staticrecomp] cpu-probe-site: key=%08x samples=%llu cycles=%llu wall_ns=%llu "
+        "zero_cycles=%llu failures=%llu\n", entry.pc,
+        static_cast<unsigned long long>(entry.samples),
+        static_cast<unsigned long long>(entry.cycles),
+        static_cast<unsigned long long>(entry.wall_ns),
+        static_cast<unsigned long long>(entry.zero_cycle_samples),
+        static_cast<unsigned long long>(entry.samples - entry.cycle_samples));
+  }
+}
