+
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+
+namespace AudioCommon
+{
+// Diagnostics only: these counters never participate in audio or save-state decisions.
+// Fields in a snapshot are nearby relaxed observations, not one atomic transaction.
+inline constexpr std::uint64_t AUDIO_ACTIVITY_WINDOW_NS = 250'000'000;
+
+template <typename Sample>
+std::uint64_t CountNonzeroAudioFrames(const Sample* samples, std::size_t frames,
+                                    std::size_t channels)
+{
+  std::uint64_t nonzero_frames = 0;
+  for (std::size_t frame = 0; frame < frames; ++frame)
+  {
+    bool nonzero = false;
+    for (std::size_t channel = 0; channel < channels; ++channel)
+      nonzero |= samples[frame * channels + channel] != Sample{};
+    nonzero_frames += nonzero;
+  }
+  return nonzero_frames;
+}
+
+inline std::uint64_t AudioTelemetryNowNs()
+{
+  return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+      std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+inline void AudioTelemetryMax(std::atomic<std::uint64_t>& counter, std::uint64_t value)
+{
+  auto old = counter.load(std::memory_order_relaxed);
+  while (old < value && !counter.compare_exchange_weak(old, value, std::memory_order_relaxed))
+  {
+  }
+}
+
+struct MixerSourceTelemetrySnapshot
+{
+  std::uint64_t push_calls = 0;
+  std::uint64_t pushed_frames = 0;
+  std::uint64_t pushed_nonzero_frames = 0;
+  std::uint64_t accepted_frames = 0;
+  std::uint64_t enqueued_granules = 0;
+  std::uint64_t queue_full_dropped_granules = 0;
+  std::uint64_t queue_trimmed_granules = 0;
+  std::uint64_t active_empty_events = 0;
+  std::uint64_t active_replay_events = 0;
+  std::uint64_t active_fade_events = 0;
+  std::uint64_t active_mixed_output_frames = 0;
+  std::uint64_t active_faded_output_frames = 0;
+  std::uint64_t last_push_age_ns = 0;
+  std::uint32_t sample_rate_dividend = 0;
+  std::uint32_t sample_rate_divisor = 0;
+  bool recently_active = false;
+};
+
+class MixerSourceTelemetry final
+{
+public:
+  void RecordPush(std::uint64_t frames, std::uint64_t nonzero_frames, bool accepted,
+                  std::uint32_t dividend, std::uint32_t divisor, std::uint64_t now)
+  {
+    push_calls.fetch_add(1, std::memory_order_relaxed);
+    pushed_frames.fetch_add(frames, std::memory_order_relaxed);
+    pushed_nonzero_frames.fetch_add(nonzero_frames, std::memory_order_relaxed);
+    sample_rate_dividend.store(dividend, std::memory_order_relaxed);
+    sample_rate_divisor.store(divisor, std::memory_order_relaxed);
+    if (frames != 0)
+      last_push_ns.store(now, std::memory_order_relaxed);
+    if (accepted)
+    {
+      accepted_frames.fetch_add(frames, std::memory_order_relaxed);
+      if (nonzero_frames != 0)
+        last_signal_ns.store(now, std::memory_order_relaxed);
+    }
+  }
+
+  // DTK feeds silent blocks even when it is stopped. Never treat those blocks,
+  // never-fed sources, or paused execution as evidence of audible starvation.
+  // This explicit recent-signal window is not a game's logical stream state.
+  bool IsActive(std::uint64_t now, bool running) const
+  {
+    const auto signal = last_signal_ns.load(std::memory_order_relaxed);
+    return running && signal != 0 && now >= signal && now - signal <= AUDIO_ACTIVITY_WINDOW_NS;
+  }
+
+  void RecordEmpty(bool active, bool replay, bool fade)
+  {
+    if (!active)
+      return;
+    active_empty_events.fetch_add(1, std::memory_order_relaxed);
+    if (replay)
+      active_replay_events.fetch_add(1, std::memory_order_relaxed);
+    if (fade)
+      active_fade_events.fetch_add(1, std::memory_order_relaxed);
+  }
+
+  MixerSourceTelemetrySnapshot Snapshot(std::uint64_t now) const
+  {
+    MixerSourceTelemetrySnapshot result;
+    result.push_calls = push_calls.load(std::memory_order_relaxed);
+    result.pushed_frames = pushed_frames.load(std::memory_order_relaxed);
+    result.pushed_nonzero_frames = pushed_nonzero_frames.load(std::memory_order_relaxed);
+    result.accepted_frames = accepted_frames.load(std::memory_order_relaxed);
+    result.enqueued_granules = enqueued_granules.load(std::memory_order_relaxed);
+    result.queue_full_dropped_granules = queue_full_dropped_granules.load(std::memory_order_relaxed);
+    result.queue_trimmed_granules = queue_trimmed_granules.load(std::memory_order_relaxed);
+    result.active_empty_events = active_empty_events.load(std::memory_order_relaxed);
+    result.active_replay_events = active_replay_events.load(std::memory_order_relaxed);
+    result.active_fade_events = active_fade_events.load(std::memory_order_relaxed);
+    result.active_mixed_output_frames = active_mixed_output_frames.load(std::memory_order_relaxed);
+    result.active_faded_output_frames = active_faded_output_frames.load(std::memory_order_relaxed);
+    const auto push = last_push_ns.load(std::memory_order_relaxed);
+    result.last_push_age_ns = push != 0 && now >= push ? now - push : 0;
+    result.sample_rate_dividend = sample_rate_dividend.load(std::memory_order_relaxed);
+    result.sample_rate_divisor = sample_rate_divisor.load(std::memory_order_relaxed);
+    result.recently_active = IsActive(now, true);
+    return result;
+  }
+
+  std::atomic<std::uint64_t> enqueued_granules{0};
+  std::atomic<std::uint64_t> queue_full_dropped_granules{0};
+  std::atomic<std::uint64_t> queue_trimmed_granules{0};
+  std::atomic<std::uint64_t> active_mixed_output_frames{0};
+  std::atomic<std::uint64_t> active_faded_output_frames{0};
+
+private:
+  std::atomic<std::uint64_t> push_calls{0}, pushed_frames{0}, pushed_nonzero_frames{0};
+  std::atomic<std::uint64_t> accepted_frames{0}, last_push_ns{0}, last_signal_ns{0};
+  std::atomic<std::uint64_t> active_empty_events{0}, active_replay_events{0}, active_fade_events{0};
+  std::atomic<std::uint32_t> sample_rate_dividend{0}, sample_rate_divisor{0};
+};
+
+enum class AudioTelemetryBackend : std::uint32_t
+{
+  Unknown = 0,
+  Cubeb = 1,
+  Null = 2,
+};
+
+struct DeviceTelemetrySnapshot
+{
+  AudioTelemetryBackend backend = AudioTelemetryBackend::Unknown;
+  bool init_complete = false;
+  bool init_succeeded = false;
+  bool start_complete = false;
+  bool start_succeeded = false;
+  bool running_requested = false;
+  bool volume_apply_complete = false;
+  bool volume_apply_succeeded = false;
+  std::uint32_t sample_rate = 0, channels = 0, sample_bits = 0;
+  std::int32_t requested_volume_percent = 100;
+  std::int32_t last_state = -1;
+  std::uint64_t callbacks = 0, callback_frames = 0, nonzero_output_frames = 0;
+  std::uint64_t callback_interval_count = 0, callback_interval_sum_ns = 0;
+  std::uint64_t callback_interval_max_ns = 0, callback_work_sum_ns = 0, callback_work_max_ns = 0;
+  std::uint64_t callback_gaps_over_two_periods = 0, callback_work_over_period = 0;
+  std::uint64_t state_started = 0, state_stopped = 0, state_drained = 0, state_errors = 0;
+  std::uint64_t operation_errors = 0;
+};
+
+class DeviceTelemetry final
+{
+public:
+  bool CanStart(bool require_silent) const
+  {
+    return !require_silent || (volume_apply_complete.load(std::memory_order_acquire) &&
+                              volume_apply_succeeded.load(std::memory_order_relaxed) &&
+                              requested_volume_percent.load(std::memory_order_relaxed) == 0);
+  }
+
+  // Cubeb serializes data callbacks for a stream. Only this method accesses the
+  // previous-callback fields; start/stop requests invalidate them via an epoch.
+  void RecordCallback(std::uint64_t begin, std::uint64_t end, std::uint64_t frames,
+                      std::uint64_t nonzero_frames, std::uint64_t epoch)
+  {
+    const auto rate = sample_rate.load(std::memory_order_relaxed);
+    if (previous_begin != 0 && previous_epoch == epoch && begin >= previous_begin)
+    {
+      const auto interval = begin - previous_begin;
+      callback_interval_count.fetch_add(1, std::memory_order_relaxed);
+      callback_interval_sum_ns.fetch_add(interval, std::memory_order_relaxed);
+      AudioTelemetryMax(callback_interval_max_ns, interval);
+      if (rate != 0 && previous_frames != 0 && interval > previous_frames * 2'000'000'000 / rate)
+        callback_gaps_over_two_periods.fetch_add(1, std::memory_order_relaxed);
+    }
+    const auto work = end >= begin ? end - begin : 0;
+    callback_work_sum_ns.fetch_add(work, std::memory_order_relaxed);
+    AudioTelemetryMax(callback_work_max_ns, work);
+    if (rate != 0 && frames != 0 && work > frames * 1'000'000'000 / rate)
+      callback_work_over_period.fetch_add(1, std::memory_order_relaxed);
+    callbacks.fetch_add(1, std::memory_order_relaxed);
+    callback_frames.fetch_add(frames, std::memory_order_relaxed);
+    nonzero_output_frames.fetch_add(nonzero_frames, std::memory_order_relaxed);
+    previous_begin = begin;
+    previous_frames = frames;
+    previous_epoch = epoch;
+  }
+
+  DeviceTelemetrySnapshot Snapshot() const
+  {
+    DeviceTelemetrySnapshot result;
+    result.init_complete = init_complete.load(std::memory_order_acquire);
+    // Init publishes the selected backend before its release store. Acquire
+    // completion first so a completed stream cannot retain a stale backend.
+    result.backend = backend.load(std::memory_order_relaxed);
+    result.init_succeeded = init_succeeded.load(std::memory_order_relaxed);
+    result.start_complete = start_complete.load(std::memory_order_acquire);
+    result.start_succeeded = start_succeeded.load(std::memory_order_relaxed);
+    result.running_requested = running_requested.load(std::memory_order_relaxed);
+    result.volume_apply_complete = volume_apply_complete.load(std::memory_order_acquire);
+    result.volume_apply_succeeded = volume_apply_succeeded.load(std::memory_order_relaxed);
+    result.sample_rate = sample_rate.load(std::memory_order_relaxed);
+    result.channels = channels.load(std::memory_order_relaxed);
+    result.sample_bits = sample_bits.load(std::memory_order_relaxed);
+    result.requested_volume_percent = requested_volume_percent.load(std::memory_order_relaxed);
+    result.last_state = last_state.load(std::memory_order_relaxed);
+    result.callbacks = callbacks.load(std::memory_order_relaxed);
+    result.callback_frames = callback_frames.load(std::memory_order_relaxed);
+    result.nonzero_output_frames = nonzero_output_frames.load(std::memory_order_relaxed);
+    result.callback_interval_count = callback_interval_count.load(std::memory_order_relaxed);
+    result.callback_interval_sum_ns = callback_interval_sum_ns.load(std::memory_order_relaxed);
+    result.callback_interval_max_ns = callback_interval_max_ns.load(std::memory_order_relaxed);
+    result.callback_work_sum_ns = callback_work_sum_ns.load(std::memory_order_relaxed);
+    result.callback_work_max_ns = callback_work_max_ns.load(std::memory_order_relaxed);
+    result.callback_gaps_over_two_periods = callback_gaps_over_two_periods.load(std::memory_order_relaxed);
+    result.callback_work_over_period = callback_work_over_period.load(std::memory_order_relaxed);
+    result.state_started = state_started.load(std::memory_order_relaxed);
+    result.state_stopped = state_stopped.load(std::memory_order_relaxed);
+    result.state_drained = state_drained.load(std::memory_order_relaxed);
+    result.state_errors = state_errors.load(std::memory_order_relaxed);
+    result.operation_errors = operation_errors.load(std::memory_order_relaxed);
+    return result;
+  }
+
+  std::atomic<AudioTelemetryBackend> backend{AudioTelemetryBackend::Unknown};
+  std::atomic<bool> init_complete{false}, init_succeeded{false};
+  std::atomic<bool> start_complete{false}, start_succeeded{false}, running_requested{false};
+  std::atomic<bool> volume_apply_complete{false}, volume_apply_succeeded{false};
+  std::atomic<std::uint32_t> sample_rate{0}, channels{0}, sample_bits{0};
+  std::atomic<std::int32_t> requested_volume_percent{100}, last_state{-1};
+  std::atomic<std::uint64_t> state_started{0}, state_stopped{0}, state_drained{0}, state_errors{0};
+  std::atomic<std::uint64_t> operation_errors{0}, timing_epoch{0};
+
+private:
+  std::atomic<std::uint64_t> callbacks{0}, callback_frames{0}, nonzero_output_frames{0};
+  std::atomic<std::uint64_t> callback_interval_count{0}, callback_interval_sum_ns{0};
+  std::atomic<std::uint64_t> callback_interval_max_ns{0}, callback_work_sum_ns{0}, callback_work_max_ns{0};
+  std::atomic<std::uint64_t> callback_gaps_over_two_periods{0}, callback_work_over_period{0};
+  std::uint64_t previous_begin = 0, previous_frames = 0, previous_epoch = 0;
+};
+
+struct MixerTelemetrySnapshot
+{
+  MixerSourceTelemetrySnapshot dma, dtk;
+  std::uint32_t output_sample_rate = 0;
+};
+
+struct AudioTelemetrySnapshot
+{
+  bool available = false, stream_alive = false;
+  std::uint64_t generation = 0;
+  MixerTelemetrySnapshot mixer;
+  DeviceTelemetrySnapshot device;
+};
+
+struct AudioTelemetryCounters final
+{
+  MixerSourceTelemetry dma, dtk;
+  DeviceTelemetry device;
+  std::atomic<std::uint32_t> output_sample_rate{0};
+  std::atomic<bool> stream_alive{false};
+  std::uint64_t generation = 0;
+
+  AudioTelemetrySnapshot Snapshot() const
+  {
+    const auto now = AudioTelemetryNowNs();
+    AudioTelemetrySnapshot result;
+    result.available = true;
+    result.stream_alive = stream_alive.load(std::memory_order_relaxed);
+    result.generation = generation;
+    result.mixer = {dma.Snapshot(now), dtk.Snapshot(now), output_sample_rate.load(std::memory_order_relaxed)};
+    result.device = device.Snapshot();
+    return result;
+  }
+};
+
+namespace detail
+{
+inline std::mutex audio_telemetry_mutex;
+inline std::shared_ptr<AudioTelemetryCounters> audio_telemetry;
+inline std::uint64_t audio_telemetry_generation = 0;
+inline std::atomic<bool> require_silent_audio_start{false};
+}  // namespace detail
+
+// An explicit silent device diagnostic may fail closed before playback starts.
+// The frontend scopes this opt-in to one run; ordinary audio remains unchanged.
+inline void SetRequireSilentAudioStart(bool required)
+{
+  detail::require_silent_audio_start.store(required, std::memory_order_relaxed);
+}
+
+inline bool IsSilentAudioStartRequired()
+{
+  return detail::require_silent_audio_start.load(std::memory_order_relaxed);
+}
+
+inline void RegisterAudioTelemetry(const std::shared_ptr<AudioTelemetryCounters>& telemetry)
+{
+  std::lock_guard lock(detail::audio_telemetry_mutex);
+  telemetry->generation = ++detail::audio_telemetry_generation;
+  telemetry->stream_alive.store(true, std::memory_order_relaxed);
+  detail::audio_telemetry = telemetry;
+}
+
+// Retain diagnostics after stream destruction. Readers copy this shared owner,
+// never a SoundStream/Mixer pointer; callbacks never acquire the registry mutex.
+inline AudioTelemetrySnapshot GetAudioTelemetrySnapshot()
+{
+  std::shared_ptr<AudioTelemetryCounters> telemetry;
+  {
+    std::lock_guard lock(detail::audio_telemetry_mutex);
+    telemetry = detail::audio_telemetry;
+  }
+  return telemetry ? telemetry->Snapshot() : AudioTelemetrySnapshot{};
+}
+}  // namespace AudioCommon
