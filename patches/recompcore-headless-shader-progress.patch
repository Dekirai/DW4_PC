diff --git a/Source/Core/VideoCommon/ComposedFrameCapture.h b/Source/Core/VideoCommon/ComposedFrameCapture.h
new file mode 100644
index 0000000000000000000000000000000000000000..e91a66a9c5734b908ab971305cb19b0a91720e52
--- /dev/null
+++ b/Source/Core/VideoCommon/ComposedFrameCapture.h
@@ -0,0 +1,165 @@
+// Copyright 2026 Dolphin Emulator Project
+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#pragma once
+
+#include <cstddef>
+#include <limits>
+#include <mutex>
+#include <optional>
+#include <span>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+
+namespace VideoCommon
+{
+enum class ComposedCaptureState
+{
+  Idle,
+  Pending,
+  Capturing,
+  Succeeded,
+  Failed,
+};
+
+struct ComposedCaptureResult
+{
+  u64 id = 0;
+  ComposedCaptureState state = ComposedCaptureState::Idle;
+  bool supported = false;
+  bool retired = false;
+  u32 width = 0;
+  u32 height = 0;
+  std::string path;
+  std::string error;
+  std::string support_error = "No compatible Vulkan surface has been initialized.";
+};
+
+// One session-owned diagnostic channel, with at most one outstanding capture. This class owns no
+// Runtime, presenter, texture, or GPU pointers. Its short mutex sections perform no I/O or callbacks.
+// The host polls Snapshot and applies its own finite diagnostic deadline; Retire prevents new work
+// and cancels publication from a readback already in flight. Stop video before releasing the session.
+class ComposedFrameCapture final
+{
+public:
+  // A nonzero id is acknowledged even when the backend is unavailable: Snapshot reports Failed.
+  // Zero means invalid input, another outstanding request, a retired session, or exhausted ids.
+  u64 Request(std::string path)
+  {
+    std::lock_guard lock(m_mutex);
+    if (path.empty() || path.find('\0') != std::string::npos || m_result.retired ||
+        m_result.state == ComposedCaptureState::Pending ||
+        m_result.state == ComposedCaptureState::Capturing ||
+        m_result.id == std::numeric_limits<u64>::max())
+      return 0;
+
+    ++m_result.id;
+    m_result.path = std::move(path);
+    m_result.width = 0;
+    m_result.height = 0;
+    m_result.state = m_result.supported ? ComposedCaptureState::Pending :
+                                         ComposedCaptureState::Failed;
+    m_result.error = m_result.supported ? std::string{} : m_result.support_error;
+    return m_result.id;
+  }
+
+  ComposedCaptureResult Snapshot() const
+  {
+    std::lock_guard lock(m_mutex);
+    return m_result;
+  }
+
+  void Retire()
+  {
+    std::lock_guard lock(m_mutex);
+    m_result.retired = true;
+    m_result.supported = false;
+    m_result.support_error = "The composed capture session has retired.";
+    FailOutstanding(m_result.support_error);
+  }
+
+  // Renderer-only endpoints, called on the video owner thread, never under the ImGui mutex.
+  void SetSupport(bool supported, std::string error = {})
+  {
+    std::lock_guard lock(m_mutex);
+    if (m_result.retired)
+      return;
+    m_result.supported = supported;
+    m_result.support_error = supported ? std::string{} : std::move(error);
+    if (!supported)
+      FailOutstanding(m_result.support_error);
+  }
+
+  std::optional<ComposedCaptureResult> TakeRequest()
+  {
+    std::lock_guard lock(m_mutex);
+    if (m_result.retired || !m_result.supported ||
+        m_result.state != ComposedCaptureState::Pending)
+      return std::nullopt;
+    m_result.state = ComposedCaptureState::Capturing;
+    return m_result;
+  }
+
+  void Complete(u64 id, u32 width, u32 height, std::string error = {})
+  {
+    std::lock_guard lock(m_mutex);
+    if (m_result.retired || m_result.id != id ||
+        m_result.state != ComposedCaptureState::Capturing)
+      return;
+    m_result.width = width;
+    m_result.height = height;
+    m_result.state = error.empty() ? ComposedCaptureState::Succeeded : ComposedCaptureState::Failed;
+    m_result.error = std::move(error);
+  }
+
+private:
+  void FailOutstanding(const std::string& error)
+  {
+    if (m_result.state == ComposedCaptureState::Pending ||
+        m_result.state == ComposedCaptureState::Capturing)
+    {
+      m_result.state = ComposedCaptureState::Failed;
+      m_result.error = error;
+    }
+  }
+
+  mutable std::mutex m_mutex;
+  ComposedCaptureResult m_result;
+};
+
+// Diagnostic allocation cap, independent of the backend's maximum render target dimensions.
+inline constexpr size_t MAX_COMPOSED_CAPTURE_BYTES = 256 * 1024 * 1024;
+
+// SavePNG accepts RGBA byte order. Preserve the source row orientation and alpha; remove staging
+// row padding and explicitly swizzle BGRA SDR surfaces. No HDR/tone-map approximation is performed.
+inline bool ConvertComposedCaptureToRGBA(std::span<const u8> source, size_t stride, u32 width,
+                                         u32 height, bool bgra, std::vector<u8>* rgba)
+{
+  const u64 row_bytes = static_cast<u64>(width) * 4;
+  if (!rgba || width == 0 || height == 0 || row_bytes > stride ||
+      static_cast<u64>(width) * height > MAX_COMPOSED_CAPTURE_BYTES / 4 ||
+      static_cast<u64>(height - 1) > (std::numeric_limits<size_t>::max() - row_bytes) / stride ||
+      static_cast<u64>(height - 1) * stride + row_bytes > source.size())
+    return false;
+
+  rgba->resize(static_cast<size_t>(row_bytes * height));
+  for (u32 y = 0; y < height; ++y)
+  {
+    const u8* src = source.data() + static_cast<size_t>(y) * stride;
+    u8* dst = rgba->data() + static_cast<size_t>(y) * static_cast<size_t>(row_bytes);
+    for (u32 x = 0; x < width; ++x)
+    {
+      dst[0] = src[bgra ? 2 : 0];
+      dst[1] = src[1];
+      dst[2] = src[bgra ? 0 : 2];
+      dst[3] = src[3];
+      src += 4;
+      dst += 4;
+    }
+  }
+  return true;
+}
+}  // namespace VideoCommon
