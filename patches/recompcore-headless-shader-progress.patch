diff --git a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompDw4Cache.h b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompDw4Cache.h
new file mode 100644
index 0000000000000000000000000000000000000000..ee7ca8fb244360fd460d1ed406d573d98928133b
--- /dev/null
+++ b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompDw4Cache.h
@@ -0,0 +1,142 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <algorithm>
+#include <string_view>
+
+#include "Core/PowerPC/StaticRecomp/StaticRecompABI.h"
+
+namespace StaticRecompDw4Cache
+{
+constexpr u32 LOOP_PC = 0x8025d3a4u;
+constexpr u32 CHUNK_START = 0x8025c160u;
+constexpr u32 CHUNK_END = 0x80260160u;
+constexpr u64 CHUNK_HASH = 0x350b8c917f12ea10ull;
+constexpr u32 MAX_LINES = 256;
+constexpr u32 BAT_BYTES = 0x20000;
+
+struct Environment
+{
+  bool enabled = false;
+  bool module_active = false;
+  bool running = false;
+  bool lockstep = false;
+  bool chunk_verified = false;
+  bool chunk_has_hooks = false;
+  bool forced_fallback = false;
+  bool dcache_enabled = false;
+  u32 pending_exceptions = 0;
+  u32 generic_idle_pc = 0;
+  u32 ppc_msr = 0;
+  u32 dispatch_address = 0;
+  u32 dispatch_r3 = 0;
+  u32 dispatch_ctr = 0;
+  u64 completed_hooks = 0;
+  s64 dispatch_charge = 0;
+  s32 downcount = 0;
+  std::string_view game_id;
+  const StaticRecompModuleDesc* module = nullptr;
+  u32 chunk_index = 0;
+};
+
+struct Batch
+{
+  u32 address = 0;  // Aligned effective address of the NEXT dcbst.
+  u32 lines = 0;
+};
+
+inline u32 ReadWord(const CPUState& cpu, u32 address)
+{
+  const u8* p = cpu.ram + (address - 0x80000000u);
+  return (static_cast<u32>(p[0]) << 24) | (static_cast<u32>(p[1]) << 16) |
+         (static_cast<u32>(p[2]) << 8) | p[3];
+}
+
+// This policy describes additional complete A4 -> A4 dispatches AFTER one
+// genuine addi/bdnz/dcbst dispatch. It never consumes the final loop exit.
+inline Batch Prepare(const CPUState& cpu, const Environment& env)
+{
+  if (!env.enabled || !env.module_active || !env.running || env.lockstep ||
+      !env.chunk_verified || env.chunk_has_hooks || env.forced_fallback ||
+      env.dcache_enabled || env.pending_exceptions != 0 || env.generic_idle_pc != 0 ||
+      env.game_id != "GDJEB2" ||
+      env.dispatch_address != LOOP_PC || cpu.pc != LOOP_PC || env.dispatch_charge != 2 ||
+      cpu.downcount != -2 || env.completed_hooks != 1 || env.dispatch_ctr <= 1 ||
+      cpu.ctr != env.dispatch_ctr - 1 || cpu.ctr <= 1 ||
+      static_cast<u64>(env.dispatch_r3) + 32 != cpu.gpr[3] ||
+      cpu.exception != 0 || cpu.program_exception != 0 || cpu.msr != env.ppc_msr)
+    return {};
+
+  const auto* module = env.module;
+  if (!module || std::string_view(module->game_id, 7) != std::string_view("GDJEB2\0", 7) ||
+      module->entry_point != 0x80005240u || module->num_rel_modules != 0 ||
+      !module->chunk_ranges || !module->chunk_hashes || env.chunk_index >= module->num_chunk_ranges ||
+      module->chunk_ranges[env.chunk_index].start != CHUNK_START ||
+      module->chunk_ranges[env.chunk_index].end != CHUNK_END ||
+      module->chunk_hashes[env.chunk_index] != CHUNK_HASH ||
+      !module->code_ranges || module->num_code_ranges == 0)
+    return {};
+
+  constexpr u32 required_msr = PPC_MSR_EE | PPC_MSR_IR | PPC_MSR_DR;
+  constexpr u32 excluded_msr = PPC_MSR_POW | PPC_MSR_ILE | PPC_MSR_PR | PPC_MSR_SE |
+                               PPC_MSR_BE | PPC_MSR_IP | PPC_MSR_PM | PPC_MSR_LE;
+  if ((cpu.msr & required_msr) != required_msr || (cpu.msr & excluded_msr) != 0 ||
+      !cpu.ram || cpu.ram_size < CHUNK_END - 0x80000000u ||
+      ReadWord(cpu, LOOP_PC - 4) != 0x7c00186cu ||
+      ReadWord(cpu, LOOP_PC) != 0x38630020u || ReadWord(cpu, LOOP_PC + 4) != 0x4200fff8u)
+    return {};
+
+  // The real dcbst has already charged five PPC cycles. Its pending two native
+  // cycles still need flushing. Leave a positive slice for a final REAL dispatch;
+  // preserve its usual 7-cycle overshoot (or 3-cycle terminal addi/bdnz/blr).
+  const s64 remaining = static_cast<s64>(env.downcount) - 2;
+  if (remaining <= 7)
+    return {};
+  u32 lines = std::min({cpu.ctr - 1, static_cast<u32>((remaining - 1) / 7), MAX_LINES});
+  const u64 next_r3 = static_cast<u64>(cpu.gpr[3]) + 32;
+  if (next_r3 < 0x80000000ull || next_r3 >= 0x81800000ull)
+    return {};
+  const u32 address = static_cast<u32>(next_r3) & ~31u;
+  // Keep one BAT index: the integration verifies both endpoints against the
+  // actual instruction-translation API (IR), never assumes a DR mapping.
+  lines = std::min(lines, (BAT_BYTES - (address & (BAT_BYTES - 1))) / 32);
+  const u64 end = static_cast<u64>(address) + static_cast<u64>(lines) * 32;
+  if (lines == 0 || end > 0x81800000ull || end - 0x80000000ull > cpu.ram_size ||
+      static_cast<u64>(cpu.gpr[3]) + static_cast<u64>(lines) * 32 >= 0x81800000ull)
+    return {};
+  // No native code range may be invalidated early. This includes the executing
+  // chunk, whose normal per-dispatch SMC revalidation must never be skipped.
+  for (u32 i = 0; i < module->num_code_ranges; ++i)
+  {
+    const auto& code = module->code_ranges[i];
+    if (code.end <= code.start || (address < code.end && end > code.start))
+      return {};
+  }
+  return {address, lines};
+}
+
+template <typename Translate>
+bool HasIdentityMapping(const Batch& batch, Translate&& translate)
+{
+  if (batch.lines == 0)
+    return false;
+  for (const u32 address : {batch.address, batch.address + batch.lines * 32 - 1})
+  {
+    const auto mapped = translate(address);
+    if (!mapped.valid || !mapped.translated || !mapped.from_bat ||
+        mapped.address != address - 0x80000000u)
+      return false;
+  }
+  return true;
+}
+
+// Apply only after real InvalidateICacheLines has completed. Native and hook
+// costs intentionally remain separate, matching the existing chassis path.
+inline void Commit(CPUState& cpu, s32& downcount, s64& charge, const Batch& batch)
+{
+  cpu.gpr[3] += 32 * batch.lines;
+  cpu.ctr -= batch.lines;
+  downcount -= static_cast<s32>(5 * batch.lines);
+  charge += 2 * batch.lines;
+}
+}  // namespace StaticRecompDw4Cache
diff --git a/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompDw4Idle.h b/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompDw4Idle.h
