@@ -2,9 +2,47 @@
 
 #include <memory>
 
+#include "AudioCommon/AudioTelemetry.h"
+
 class BootSessionData;
 
 namespace moderngekko::detail {
 void SetExternalUICommon(bool external);
 void SetBootSessionData(std::unique_ptr<BootSessionData> boot_session_data);
+
+struct HeadlessAudioCheck
+{
+  bool ready = false;
+  const char* failure = nullptr;
+};
+
+// Asynchronous boot must confirm a newly registered real stream, not a selected
+// config string or a retained snapshot from the previous runtime instance.
+inline HeadlessAudioCheck CheckHeadlessAudio(const AudioCommon::AudioTelemetrySnapshot& audio,
+                                           std::uint64_t previous_generation,
+                                           bool require_silent = false)
+{
+  if (!audio.available || audio.generation <= previous_generation)
+    return {};
+  const auto& device = audio.device;
+  if (device.backend == AudioCommon::AudioTelemetryBackend::Null)
+    return {false, "requested headless Cubeb audio fell back to NullSound"};
+  if (device.init_complete && !device.init_succeeded)
+    return {false, "requested headless Cubeb audio failed to initialize"};
+  if (device.start_complete && !device.start_succeeded)
+    return {false, "requested headless Cubeb audio failed to start"};
+  if (require_silent && device.volume_apply_complete && !device.volume_apply_succeeded)
+    return {false, "headless Cubeb audio could not apply zero device volume"};
+  if (require_silent && device.start_complete && device.start_succeeded &&
+      (!device.volume_apply_complete || device.requested_volume_percent != 0))
+    return {false, "headless Cubeb audio did not confirm silent device output"};
+  if (device.operation_errors != 0 || device.state_errors != 0)
+    return {false, "requested headless Cubeb audio reported a device error"};
+  if (device.init_complete && device.backend != AudioCommon::AudioTelemetryBackend::Cubeb)
+    return {false, "requested headless Cubeb audio initialized a different backend"};
+  return {audio.stream_alive && device.init_complete && device.init_succeeded &&
+              device.start_complete && device.start_succeeded &&
+              device.backend == AudioCommon::AudioTelemetryBackend::Cubeb,
+          nullptr};
+}
 } // namespace moderngekko::detail
