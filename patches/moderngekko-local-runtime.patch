+#pragma once
+
+#include <filesystem>
+#include <memory>
+#include <string>
+
+class Platform;
+namespace VideoCommon {
+class ComposedFrameCapture;
+}
+
+namespace moderngekko::detail {
+class InGameMenu;
+
+// Explicit Windows diagnostic only. All methods run on the HWND owner thread. The caller supplies
+// an already configured hidden platform, a live menu and its diagnostic capture channel, then ticks
+// this driver from the platform's UI callback. It never injects global/physical input or shows a window.
+// Construct before boot so the owned video-event listener observes real game presentation progress.
+// Keyboard checks require the wrapper's fresh empty Player 1 profile. While
+// paused they exercise native bindings, disk reload and the core input gate,
+// then verify Player 2 attachment after resume and restore the original profile.
+class InGameMenuSmoke final {
+public:
+  InGameMenuSmoke(Platform& platform, std::shared_ptr<InGameMenu> menu,
+                 std::shared_ptr<VideoCommon::ComposedFrameCapture> capture,
+                 std::filesystem::path output_directory);
+  ~InGameMenuSmoke();
+  InGameMenuSmoke(const InGameMenuSmoke&) = delete;
+  InGameMenuSmoke& operator=(const InGameMenuSmoke&) = delete;
+
+  // Host-thread nonblocking state machine, with a 60-second steady-clock deadline. Completion or
+  // failure writes ingame-menu-smoke.json and requests an immediate platform-loop stop. The caller
+  // retains its normal core shutdown/join path and an external process watchdog.
+  void Tick();
+  bool Finished() const;
+  bool Passed() const;
+  std::string Error() const;
+
+private:
+  struct Impl;
+  std::unique_ptr<Impl> m_impl;
+};
+} // namespace moderngekko::detail
