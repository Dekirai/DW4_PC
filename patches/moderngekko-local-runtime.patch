+bool ValidateImportTree(const DiscIO::FileInfo& directory, unsigned depth,
+                        std::uint64_t* entries, std::uint64_t* bytes, std::string* error)
+{
+  if (depth > 32)
+  {
+    *error = "disc directory nesting exceeds the supported limit";
+    return false;
+  }
+  std::unordered_set<std::string> names;
+  for (const auto& entry : directory)
+  {
+    const std::string name = entry.GetName();
+    std::string folded = name;
+    std::ranges::transform(folded, folded.begin(), [](unsigned char c) {
+      return c >= 'A' && c <= 'Z' ? static_cast<char>(c - 'A' + 'a') : static_cast<char>(c);
+    });
+    if (!moderngekko::frontend::SafeImportComponent(name) || !names.insert(folded).second)
+    {
+      *error = "disc contains an unsafe or duplicate host filename";
+      return false;
+    }
+    if (++*entries > 100000)
+    {
+      *error = "disc file count exceeds the supported limit";
+      return false;
+    }
+    if (entry.IsDirectory())
+    {
+      if (!ValidateImportTree(entry, depth + 1, entries, bytes, error))
+        return false;
+    }
+    else if ((*bytes += entry.GetSize()) > 4ull * 1024 * 1024 * 1024)
+    {
+      *error = "disc file sizes exceed the supported import limit";
+      return false;
+    }
+  }
+  return true;
+}
