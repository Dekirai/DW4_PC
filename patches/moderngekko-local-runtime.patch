+struct InGameMenu::Impl : std::enable_shared_from_this<Impl> {
+  explicit Impl(HostActions actions_) : actions(std::move(actions_)), generation(++s_next_generation) {}
+
+  struct View {
+    bool running = false, paused = false, netplay = false, muted = false, fullscreen = false;
+    bool vsync = false, ssaa = false, hires = false;
+    int scale = 1;
+    u32 msaa = 1;
+    AspectMode aspect = AspectMode::Auto;
+    std::vector<fs::path> states;
+    std::string message;
+    std::string last_action;
+    std::vector<InGameMenuButtonRect> buttons;
+    KeyboardControlsSnapshot controls;
+    std::uint64_t controls_revision = 0;
+    bool controls_panel_open = false;
+  };
+
+  HostActions actions; // Host-thread callbacks, immutable for this session.
+  const std::uint64_t generation;
+  InGameMenuInput input;
+  mutable std::mutex mutex;
+  View view;
+  std::atomic<bool> pending_action{false}, redraw_outstanding{false}, redraw_needed{false};
+  std::atomic<bool> refresh_states{true};
+  std::atomic<bool> refresh_controls{true};
+  std::atomic<std::uint64_t> draw_frames{0}, actions_queued{0}, actions_completed{0};
+  std::atomic<std::uint64_t> controls_rendered_revision{0};
+  Clock::time_point next_snapshot{}, next_redraw{}, next_state_refresh{}; // Host only.
+  std::time_t last_save_time = 0;
+  std::size_t save_sequence = 0;
+  std::string selected_state; // Video only; UTF-8 identity, not an unchecked path from input.
+  bool drawn_open = false;
+  int controls_player = 0; // Video only; each slot retains independent bindings.
+  std::uint64_t controls_revision = 0;
+  KeyboardBindings controls_draft;
+  bool controls_dirty = false;
+  std::array<bool, 8> modifiers{}; // Video only.
+
+  bool IsLive(std::uint64_t expected) const {
+    return generation == expected && input.IsAlive();
+  }
+
+  void Message(std::string text) {
+    std::lock_guard lock(mutex);
+    view.message = std::move(text);
+  }
+
+  void Queue(std::string name, std::function<void(Impl&, Core::System&)> action) {
+    if (!input.IsAlive() || pending_action.exchange(true))
+      return;
+    ++actions_queued;
+    const std::weak_ptr<Impl> weak = weak_from_this();
+    const auto expected = generation;
+    // Only enqueuing occurs under ImGui's lock. Host callbacks may pause/lock
+    // the CPU/GPU, so none may execute inline on the drawing thread.
+    Core::QueueHostJob([weak, expected, name = std::move(name), action = std::move(action)]
+                       (Core::System& system) {
+      const auto self = weak.lock();
+      if (!self || !self->IsLive(expected))
+        return;
+      if (Core::IsRunning(system)) {
+        {
+          std::lock_guard lock(self->mutex);
+          self->view.last_action = name;
+        }
+        try {
+          action(*self, system);
+        } catch (const std::exception& error) {
+          self->Message(std::string("Action failed: ") + error.what());
+        }
+        ++self->actions_completed; // Host dispatch, not asynchronous state-file completion.
+      }
+      self->pending_action.store(false);
+      self->next_snapshot = {};
+      self->redraw_needed.store(true);
+    });
+  }
+
+  void SettingsChanged() {
+    if (actions.on_settings_changed)
+      actions.on_settings_changed();
+    Message("Settings applied to this session.");
+  }
+
+  void SaveState(Core::System& system) {
+    if (NetPlay::IsNetPlayRunning()) {
+      Message("Save states are unavailable during online play.");
+      return;
+    }
+    const fs::path directory = fs::u8path(File::GetUserPath(D_STATESAVES_IDX));
+    if (directory.empty())
+      throw std::runtime_error("The save-state directory is unavailable.");
+    fs::create_directories(directory);
+    const std::time_t now = std::time(nullptr);
+    if (now != last_save_time) {
+      last_save_time = now;
+      save_sequence = 0;
+    }
+    fs::path path;
+    for (unsigned attempts = 0; attempts < 10000; ++attempts) {
+      path = directory / State::Layout::TimestampedName(now, save_sequence++, State::Layout::MANUAL_PREFIX);
+      if (!fs::exists(path))
+        break;
+      path.clear();
+    }
+    if (path.empty())
+      throw std::runtime_error("Cannot allocate a new save-state filename.");
+    State::SaveAs(system, PathToString(path));
+    Message("Save requested. The game reports completion on screen.");
+    next_state_refresh = Clock::now() + std::chrono::seconds(2);
+  }
+
+  void LoadState(Core::System& system, const fs::path& path) {
+    if (NetPlay::IsNetPlayRunning()) {
+      Message("Loading states is unavailable during online play.");
+      return;
+    }
+    const fs::path directory = fs::u8path(File::GetUserPath(D_STATESAVES_IDX));
+    // GetUserPath conventionally has a trailing separator; path comparison
+    // alone would reject every listed file even though the directory is equal.
+    if (!fs::equivalent(path.parent_path(), directory) || path.extension() != State::Layout::EXTENSION ||
+        !fs::is_regular_file(path))
+      throw std::runtime_error("The selected save state is no longer available.");
+    State::LoadAs(system, PathToString(path));
+    Message("Load requested. The game reports the result on screen.");
+  }
+
+  void RedrawPaused(Core::System& system) {
+    const auto now = Clock::now();
+    if (Core::GetState(system) != Core::State::Paused || now < next_redraw ||
+        (!input.IsOpen() && !redraw_needed.load()) || redraw_outstanding.exchange(true))
+      return;
+    redraw_needed.store(false);
+    next_redraw = now + std::chrono::milliseconds(33);
+    const std::weak_ptr<Impl> weak = weak_from_this();
+    const auto expected = generation;
+    Core::RunOnCPUThread(system, [weak, expected] {
+      const auto self = weak.lock();
+      if (!self || !self->IsLive(expected))
+        return;
+      // AsyncRequests has a single CPU producer. A host/window timer must not
+      // push directly into it, including while the emulation CPU is stepping.
+      AsyncRequests::GetInstance()->PushEvent([weak, expected] {
+        const auto owner = weak.lock();
+        if (!owner)
+          return;
+        if (owner->IsLive(expected) &&
+            Core::GetState(Core::System::GetInstance()) == Core::State::Paused && g_presenter)
+          g_presenter->Present(nullptr);
+        owner->redraw_outstanding.store(false);
+      });
+    });
+  }
+
+  void Tick() {
+    if (!input.IsAlive())
+      return;
+    auto& system = Core::System::GetInstance();
+    const auto now = Clock::now();
+    if (now >= next_snapshot) {
+      const auto state = Core::GetState(system);
+      const bool running = state == Core::State::Running || state == Core::State::Paused;
+      View update;
+      update.running = running;
+      update.paused = state == Core::State::Paused;
+      update.netplay = NetPlay::IsNetPlayRunning();
+      update.fullscreen = actions.is_fullscreen && actions.is_fullscreen();
+      if (running) {
+        update.muted = Config::Get(Config::MAIN_AUDIO_MUTED);
+        update.vsync = Config::Get(Config::GFX_VSYNC);
+        update.scale = Config::Get(Config::GFX_EFB_SCALE);
+        update.aspect = Config::Get(Config::GFX_ASPECT_RATIO);
+        update.msaa = Config::Get(Config::GFX_MSAA);
+        update.ssaa = Config::Get(Config::GFX_SSAA);
+        update.hires = Config::Get(Config::GFX_HIRES_TEXTURES);
+      }
+      {
+        std::lock_guard lock(mutex);
+        update.states = std::move(view.states);
+        update.buttons = std::move(view.buttons);
+        update.message = std::move(view.message);
+        update.last_action = std::move(view.last_action);
+        update.controls = std::move(view.controls);
+        update.controls_revision = view.controls_revision;
+        update.controls_panel_open = view.controls_panel_open;
+        view = std::move(update);
+      }
+      next_snapshot = now + std::chrono::milliseconds(50);
+    }
+    if (input.IsOpen() && (refresh_states.exchange(false) ||
+        (next_state_refresh != Clock::time_point{} && now >= next_state_refresh))) {
+      next_state_refresh = {};
+      const fs::path directory = fs::u8path(File::GetUserPath(D_STATESAVES_IDX));
+      auto files = State::Layout::List(directory);
+      // Keep rendering/snapshots bounded even if a developer has a large archive.
+      if (files.size() > 128)
+        files.resize(128);
+      std::lock_guard lock(mutex);
+      view.states = std::move(files);
+    }
+    if (input.IsOpen() && refresh_controls.exchange(false)) {
+      auto controls = ReadKeyboardControls();
+      std::lock_guard lock(mutex);
+      view.controls = std::move(controls);
+      ++view.controls_revision;
+    }
+    RedrawPaused(system);
+  }
+};
+
+std::shared_ptr<InGameMenu> InGameMenu::Create(HostActions actions) {
+  return std::shared_ptr<InGameMenu>(new InGameMenu(std::move(actions)));
+}
+InGameMenu::InGameMenu(HostActions actions) : m_impl(std::make_shared<Impl>(std::move(actions))) {}
+InGameMenu::~InGameMenu() { m_impl->input.Retire(); }
+bool InGameMenu::IsOpen() const { return m_impl->input.IsOpen(); }
+bool InGameMenu::BlocksGameInput() const { return IsOpen(); }
+void InGameMenu::Retire() { m_impl->input.Retire(); }
+bool InGameMenu::HandleInput(const FrontendUI::InputEvent& event) {
+  const bool was_open = IsOpen();
+  const bool consumed = m_impl->input.Handle(event);
+  if (!was_open && IsOpen()) {
+    m_impl->refresh_states.store(true);
+    m_impl->refresh_controls.store(true);
+  }
+  if (consumed || was_open)
+    m_impl->redraw_needed.store(true);
+  return consumed;
+}
+void InGameMenu::Tick() { m_impl->Tick(); }
