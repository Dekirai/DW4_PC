+void InGameMenu::Draw() {
+  auto& self = *m_impl;
+  if (!self.input.IsAlive() || !ImGui::GetCurrentContext())
+    return;
+  if (!self.input.IsOpen()) {
+    self.drawn_open = false;
+    std::lock_guard lock(self.mutex);
+    self.view.buttons.clear();
+    return;
+  }
+  ++self.draw_frames;
+  Impl::View view;
+  {
+    std::lock_guard lock(self.mutex);
+    view = self.view;
+  }
+  std::vector<InGameMenuButtonRect> buttons;
+  const bool pending = self.pending_action.load();
+  const bool active = view.running && !pending;
+  const auto& io = ImGui::GetIO();
+  if (!self.drawn_open) {
+    ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * 0.5f, io.DisplaySize.y * 0.5f),
+                            ImGuiCond_Always, ImVec2(0.5f, 0.5f));
+    ImGui::SetNextWindowFocus();
+  }
+  self.drawn_open = true;
+  ImGui::SetNextWindowSize(ImVec2(std::max(1.0f, std::min(650.0f, io.DisplaySize.x - 24.0f)),
+                                std::max(1.0f, std::min(650.0f, io.DisplaySize.y - 24.0f))), ImGuiCond_FirstUseEver);
+  auto record = [&](const char* id, bool enabled) {
+    const auto min = ImGui::GetItemRectMin();
+    const auto max = ImGui::GetItemRectMax();
+    buttons.push_back({id, min.x, min.y, max.x - min.x, max.y - min.y,
+                       enabled && ImGui::IsItemVisible()});
+  };
+  auto button = [&](const char* label, const char* id, bool enabled) {
+    ImGui::BeginDisabled(!enabled);
+    const bool pressed = ImGui::Button(label);
+    record(id, enabled);
+    ImGui::EndDisabled();
+    return pressed;
+  };
+  bool open = true;
+  bool controls_panel_open = false;
+  if (ImGui::Begin("Digimon World 4 - Settings", &open, ImGuiWindowFlags_NoCollapse)) {
+    ImGui::TextUnformatted("F1 or Escape closes this menu. Opening it keeps the game running.");
+    ImGui::Text("Session: %s%s", view.paused ? "Paused" : "Running", view.netplay ? " | Online" : "");
+    if (button(view.paused ? "Resume" : "Pause", view.paused ? "resume" : "pause", active && !view.netplay)) {
+      const bool pause = !view.paused;
+      self.Queue(pause ? "pause" : "resume", [pause](Impl& owner, Core::System& system) {
+        if (NetPlay::IsNetPlayRunning()) {
+          owner.Message("Pause is unavailable during online play.");
+          return;
+        }
+        Core::SetState(system, pause ? Core::State::Paused : Core::State::Running);
+        owner.Message(Core::GetState(system) == Core::State::Paused ? "Game paused." : "Game running.");
+      });
+    }
+    ImGui::SameLine();
+    if (button(view.muted ? "Unmute" : "Mute", "mute",
+               active && (!view.muted || self.actions.allow_audio_unmute))) {
+      const bool mute = !view.muted;
+      self.Queue("mute", [mute](Impl& owner, Core::System& system) {
+        if (!mute && !owner.actions.allow_audio_unmute)
+          return;
+        const std::weak_ptr<Impl> weak = owner.weak_from_this();
+        const auto generation = owner.generation;
+        Core::RunOnCPUThread(system, [weak, generation, mute] {
+          const auto session = weak.lock();
+          if (!session || !session->IsLive(generation))
+            return;
+          Config::SetCurrent(Config::MAIN_AUDIO_MUTED, mute);
+          AudioCommon::UpdateSoundStream(Core::System::GetInstance());
+        });
+        owner.Message(mute ? "Mute requested." : "Unmute requested.");
+      });
+    }
+    ImGui::SameLine();
+    if (button(view.fullscreen ? "Windowed" : "Fullscreen", "fullscreen",
+               active && static_cast<bool>(self.actions.toggle_fullscreen))) {
+      self.Queue("fullscreen", [](Impl& owner, Core::System&) {
+        if (owner.actions.toggle_fullscreen)
+          owner.actions.toggle_fullscreen();
+      });
+    }
+    if (view.netplay)
+      ImGui::TextWrapped("Pause, save states and graphics changes are disabled during online play.");
+    if (!self.actions.allow_audio_unmute)
+      ImGui::TextDisabled("This diagnostic session requires silent audio.");
+
+    const bool controls_open = ImGui::CollapsingHeader("Controls");
+    controls_panel_open = controls_open;
+    record("controls_expand", active);
+    if (controls_open) {
+      if (self.controls_revision != view.controls_revision) {
+        self.controls_revision = view.controls_revision;
+        self.controls_draft = view.controls.players[static_cast<std::size_t>(self.controls_player)];
+        self.controls_dirty = false;
+      }
+      ImGui::TextWrapped("Keyboard bindings are added alongside this player's saved controller bindings.");
+      ImGui::TextDisabled("F1 and Escape are reserved for the menu. Changes are saved with your profile.");
+      ImGui::BeginDisabled(!active || view.netplay);
+      const char* players[] = {"Player 1", "Player 2", "Player 3", "Player 4"};
+      if (ImGui::Combo("Player", &self.controls_player, players, 4)) {
+        self.controls_draft = view.controls.players[static_cast<std::size_t>(self.controls_player)];
+        self.controls_dirty = false;
+      }
+      if (!view.controls.error.empty())
+        ImGui::TextWrapped("%s", view.controls.error.c_str());
+      const auto device = std::ranges::find(view.controls.devices, self.controls_draft.device,
+                                            &KeyboardDevice::qualifier);
+      if (device == view.controls.devices.end())
+        ImGui::TextWrapped("Keyboard unavailable. Refresh after connecting your input device.");
+      if (ImGui::BeginCombo("Input device", device == view.controls.devices.end() ? "Unavailable" : "Keyboard and mouse")) {
+        for (std::size_t i = 0; i < view.controls.devices.size(); ++i) {
+          const auto& keyboard = view.controls.devices[i];
+          const auto label = "Keyboard and mouse " + std::to_string(i + 1);
+          if (ImGui::Selectable(label.c_str(), self.controls_draft.device == keyboard.qualifier)) {
+            self.controls_draft.device = keyboard.qualifier;
+            self.controls_dirty = true;
+          }
+        }
+        ImGui::EndCombo();
+      }
+      if (ImGui::BeginChild("keyboard_bindings", ImVec2(0, 180), ImGuiChildFlags_Borders)) {
+        for (std::size_t i = 0; i < kKeyboardActions.size(); ++i) {
+          auto& key = self.controls_draft.keys[i];
+          ImGui::PushID(static_cast<int>(i));
+          ImGui::SetNextItemWidth(180);
+          if (ImGui::BeginCombo(kKeyboardActions[i].label, KeyboardKeyLabel(key).c_str())) {
+            if (ImGui::Selectable("Unbound", key.empty())) { key.clear(); self.controls_dirty = true; }
+            if (device != view.controls.devices.end())
+              for (const auto& name : device->keys)
+                if (ImGui::Selectable(KeyboardKeyLabel(name).c_str(), key == name)) { key = name; self.controls_dirty = true; }
+            ImGui::EndCombo();
+          }
+          ImGui::PopID();
+        }
+      }
+      ImGui::EndChild();
+      if (button("Keyboard defaults", "controls_defaults", active && !view.netplay && device != view.controls.devices.end())) {
+        self.controls_draft = DefaultKeyboardBindings(self.controls_draft.device);
+        self.controls_dirty = true;
+      }
+      ImGui::SameLine();
+      if (button("Clear keyboard", "controls_clear", active && !view.netplay)) {
+        self.controls_draft.keys.fill({});
+        self.controls_dirty = true;
+      }
+      if (button("Apply and save", "controls_apply", active && !view.netplay && self.controls_dirty && view.controls.error.empty())) {
+        const auto bindings = self.controls_draft;
+        const auto player = static_cast<std::size_t>(self.controls_player);
+        self.Queue("controls_apply", [bindings, player](Impl& owner, Core::System&) {
+          const auto error = ApplyKeyboardControls(player, bindings);
+          owner.Message(error.empty() ? "Player " + std::to_string(player + 1) + " keyboard bindings saved." : error);
+          owner.refresh_controls.store(true);
+        });
+      }
+      ImGui::SameLine();
+      if (button("Reload bindings", "controls_reload", active && !view.netplay))
+        self.refresh_controls.store(true);
+      if (self.controls_dirty)
+        ImGui::TextDisabled("Changes have not been applied. Switching players or reloading discards them.");
+      ImGui::EndDisabled();
+    }
+
+    ImGui::SeparatorText("Save states");
+    if (button("Save new state", "save_state", active && !view.netplay))
+      self.Queue("save_state", [](Impl& owner, Core::System& system) { owner.SaveState(system); });
+    ImGui::SameLine();
+    if (button("Refresh list", "refresh_states", active))
+      self.refresh_states.store(true);
+    if (self.selected_state.empty() && !view.states.empty())
+      self.selected_state = PathToString(view.states.front());
+    const auto selected = std::find_if(view.states.begin(), view.states.end(), [&](const fs::path& path) {
+      return PathToString(path) == self.selected_state;
+    });
+    const std::string selected_label = selected == view.states.end() ? "Select a state" : PathToString(selected->filename());
+    ImGui::SetNextItemWidth(-1);
+    if (ImGui::BeginCombo("##saved_states", selected_label.c_str())) {
+      for (const auto& path : view.states) {
+        const std::string name = PathToString(path.filename());
+        if (ImGui::Selectable(name.c_str(), PathToString(path) == self.selected_state))
+          self.selected_state = PathToString(path);
+      }
+      ImGui::EndCombo();
+    }
+    if (button("Load selected state", "load_state", active && !view.netplay && selected != view.states.end())) {
+      const fs::path path = *selected;
+      self.Queue("load_state", [path](Impl& owner, Core::System& system) { owner.LoadState(system, path); });
+    }
+    ImGui::TextDisabled("Newest 128 states. Loading replaces your current game progress.");
+
+    ImGui::SeparatorText("Graphics");
+    ImGui::TextDisabled("Changes apply to this session. Game speed is unchanged.");
+    ImGui::BeginDisabled(!active || view.netplay);
+    const int max_scale = std::min(12, static_cast<int>(g_backend_info.MaxTextureSize / 640));
+    const std::string current_scale = view.scale == 0 ? "Automatic" :
+      std::to_string(view.scale) + "x (" + std::to_string(view.scale * 640) + " x " + std::to_string(view.scale * 528) + ")";
+    if (ImGui::BeginCombo("Internal resolution", current_scale.c_str())) {
+      for (int scale : {1, 2, 3, 4, 5, 6, 8, 10, 12}) {
+        if (scale > max_scale)
+          continue;
+        const std::string label = std::to_string(scale) + "x (" + std::to_string(scale * 640) + " x " + std::to_string(scale * 528) + ")";
+        if (ImGui::Selectable(label.c_str(), view.scale == scale))
+          self.Queue("internal_resolution", [scale](Impl& owner, Core::System&) {
+            if (!NetPlay::IsNetPlayRunning()) {
+              Config::SetCurrent(Config::GFX_EFB_SCALE, scale);
+              owner.SettingsChanged();
+            }
+          });
+      }
+      ImGui::EndCombo();
+    }
+    if (ImGui::BeginCombo("Aspect ratio", AspectName(view.aspect))) {
+      for (const auto aspect : {AspectMode::Auto, AspectMode::ForceStandard, AspectMode::ForceWide, AspectMode::Stretch}) {
+        if (ImGui::Selectable(AspectName(aspect), view.aspect == aspect))
+          self.Queue("aspect_ratio", [aspect](Impl& owner, Core::System&) {
+            if (!NetPlay::IsNetPlayRunning()) {
+              Config::SetCurrent(Config::GFX_ASPECT_RATIO, aspect);
+              owner.SettingsChanged();
+            }
+          });
+      }
+      ImGui::EndCombo();
+    }
+    const std::string aa_label = view.msaa <= 1 ? "Off" : std::to_string(view.msaa) + (view.ssaa ? "x SSAA" : "x MSAA");
+    if (ImGui::BeginCombo("Anti-aliasing", aa_label.c_str())) {
+      for (const u32 samples : g_backend_info.AAModes) {
+        const std::string label = samples <= 1 ? "Off" : std::to_string(samples) + "x MSAA";
+        if (ImGui::Selectable(label.c_str(), view.msaa == samples && !view.ssaa))
+          self.Queue("anti_aliasing", [samples](Impl& owner, Core::System&) {
+            if (!NetPlay::IsNetPlayRunning()) {
+              const Config::ConfigChangeCallbackGuard guard;
+              Config::SetCurrent(Config::GFX_MSAA, samples);
+              Config::SetCurrent(Config::GFX_SSAA, false);
+              owner.SettingsChanged();
+            }
+          });
+      }
+      ImGui::EndCombo();
+    }
+    bool vsync = view.vsync;
+    if (ImGui::Checkbox("VSync", &vsync))
+      self.Queue("vsync", [vsync](Impl& owner, Core::System&) {
+        if (!NetPlay::IsNetPlayRunning()) {
+          Config::SetCurrent(Config::GFX_VSYNC, vsync);
+          owner.SettingsChanged();
+        }
+      });
+    bool hires = view.hires;
+    if (ImGui::Checkbox("Load installed HD texture packs", &hires))
+      self.Queue("hd_textures", [hires](Impl& owner, Core::System&) {
+        if (!NetPlay::IsNetPlayRunning()) {
+          Config::SetCurrent(Config::GFX_HIRES_TEXTURES, hires);
+          owner.SettingsChanged();
+        }
+      });
+    ImGui::EndDisabled();
+    ImGui::Separator();
+    if (!view.message.empty())
+      ImGui::TextWrapped("%s", view.message.c_str());
+    if (pending)
+      ImGui::TextDisabled("Applying action...");
+    if (button("Close menu", "close", true))
+      open = false;
+    ImGui::SameLine();
+    if (button("Exit game", "exit", active && static_cast<bool>(self.actions.request_shutdown)))
+      self.Queue("exit", [](Impl& owner, Core::System&) {
+        if (owner.actions.request_shutdown)
+          owner.actions.request_shutdown();
+      });
+  }
+  ImGui::End();
+  if (!open) {
+    self.input.Close();
+    self.redraw_needed.store(true);
+  }
+  {
+    std::lock_guard lock(self.mutex);
+    self.view.buttons = std::move(buttons);
+    self.view.controls_panel_open = controls_panel_open;
+    if (controls_panel_open)
+      self.controls_rendered_revision.store(self.controls_revision);
+  }
+}
+
+InGameMenuSnapshot InGameMenu::Snapshot() const {
+  const auto& self = *m_impl;
+  InGameMenuSnapshot snapshot;
+  snapshot.generation = self.generation;
+  snapshot.alive = self.input.IsAlive();
+  snapshot.open = self.input.IsOpen();
+  snapshot.capture = snapshot.open;
+  snapshot.input_events = self.input.Events();
+  snapshot.input_overflows = self.input.Overflows();
+  snapshot.draw_frames = self.draw_frames.load();
+  snapshot.actions_queued = self.actions_queued.load();
+  snapshot.actions_completed = self.actions_completed.load();
+  std::lock_guard lock(self.mutex);
+  snapshot.paused = self.view.paused;
+  snapshot.netplay = self.view.netplay;
+  snapshot.controls_panel_open = self.input.IsOpen() && self.view.controls_panel_open;
+  snapshot.controls_action_count = snapshot.controls_panel_open ? kKeyboardActions.size() : 0;
+  snapshot.controls_rendered_revision = self.controls_rendered_revision.load();
+  snapshot.last_action = self.view.last_action;
+  snapshot.message = self.view.message;
+  snapshot.buttons = self.view.buttons;
+  return snapshot;
+}
+} // namespace moderngekko::detail
