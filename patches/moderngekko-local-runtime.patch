+    MENU_KEY(LeftShift, LeftShift); MENU_KEY(RightShift, RightShift);
+    MENU_KEY(LeftAlt, LeftAlt); MENU_KEY(RightAlt, RightAlt);
+    MENU_KEY(LeftSuper, LeftSuper); MENU_KEY(RightSuper, RightSuper);
+    MENU_KEY(Apostrophe, Apostrophe); MENU_KEY(Comma, Comma); MENU_KEY(Minus, Minus);
+    MENU_KEY(Period, Period); MENU_KEY(Slash, Slash); MENU_KEY(Semicolon, Semicolon);
+    MENU_KEY(Equal, Equal); MENU_KEY(LeftBracket, LeftBracket); MENU_KEY(Backslash, Backslash);
+    MENU_KEY(RightBracket, RightBracket); MENU_KEY(GraveAccent, GraveAccent);
+    MENU_KEY(CapsLock, CapsLock); MENU_KEY(ScrollLock, ScrollLock); MENU_KEY(NumLock, NumLock);
+    MENU_KEY(PrintScreen, PrintScreen); MENU_KEY(Pause, Pause);
