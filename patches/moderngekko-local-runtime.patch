+// Copyright 2026 DW4_PC contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "DolphinNoGUI/UIInput.h"
+
+namespace moderngekko::detail {
+
+struct InGameMenuButtonRect {
+  std::string id;
+  float x = 0, y = 0, width = 0, height = 0;
+  bool enabled = false;
+};
+
+struct InGameMenuSnapshot {
+  std::uint64_t generation = 0;
+  bool alive = false;
+  bool open = false;
+  bool capture = false;
+  bool paused = false;
+  bool netplay = false;
+  bool controls_panel_open = false;
+  std::size_t controls_action_count = 0;
+  std::uint64_t controls_rendered_revision = 0;
+  std::uint64_t input_events = 0;
+  std::uint64_t input_overflows = 0;
+  std::uint64_t draw_frames = 0;
+  std::uint64_t actions_queued = 0;
+  std::uint64_t actions_completed = 0;
+  std::string last_action;
+  std::string message;
+  std::vector<InGameMenuButtonRect> buttons;
+};
+
+class InGameMenu final {
+public:
+  struct HostActions {
+    // Called only on the host/window owner thread, before Retire().
+    std::function<void()> toggle_fullscreen;
+    std::function<bool()> is_fullscreen;
+    std::function<void()> request_shutdown;
+    std::function<void()> on_settings_changed;
+    bool allow_audio_unmute = true;
+  };
+
+  static std::shared_ptr<InGameMenu> Create(HostActions actions);
+  ~InGameMenu();
+  InGameMenu(const InGameMenu&) = delete;
+  InGameMenu& operator=(const InGameMenu&) = delete;
+
+  // Host thread. F1/Escape update modal capture synchronously, before native
+  // hotkeys run; other events enter a bounded queue. No ImGui calls occur here.
+  bool HandleInput(const FrontendUI::InputEvent& event);
+  void Tick();
+  // Call before stopping the core/destroying the platform. Queued jobs retain
+  // weak session ownership and cannot invoke platform callbacks after this.
+  void Retire();
+
+  // Video owner thread, with the existing OnScreenUI ImGui mutex already held.
+  // BeginFrame runs before NewFrame; Draw runs before Render. Neither waits
+  // for host/CPU work or acquires the ImGui mutex again.
+  void BeginFrame();
+  void Draw();
+
+  bool IsOpen() const;
+  bool BlocksGameInput() const;
+  InGameMenuSnapshot Snapshot() const;
+
+private:
+  struct Impl;
+  explicit InGameMenu(HostActions actions);
+  std::shared_ptr<Impl> m_impl;
+};
+} // namespace moderngekko::detail
diff --git a/src/runtime/ingame_menu_controls.cpp b/src/runtime/ingame_menu_controls.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..6897bc4fbd1d04cb6346c4049468c0cd607fcc8d
--- /dev/null
+++ b/src/runtime/ingame_menu_controls.cpp
@@ -0,0 +1,317 @@
+// Copyright 2026 DW4_PC contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "ingame_menu_controls.h"
+
+#include "Common/FileUtil.h"
+#include "Common/IniFile.h"
+#include "Common/Config/Config.h"
+#include "Core/HW/GCPad.h"
+#include "Core/Config/ConfigManager.h"
+#include "Core/Config/MainSettings.h"
+#include "Core/Core.h"
+#include "Core/HW/SI/SI.h"
+#include "Core/HW/SI/SI_Device.h"
+#include "Core/NetPlay/NetPlayProto.h"
+#include "Core/System.h"
+#include "InputCommon/ControlReference/ControlReference.h"
+#include "InputCommon/ControllerEmu/ControllerEmu.h"
+#include "InputCommon/ControllerInterface/ControllerInterface.h"
+#include "InputCommon/InputConfig.h"
+
+#include <algorithm>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <string_view>
+#include <utility>
+
+namespace moderngekko::detail {
+namespace {
+std::string ConfigPath() { return File::GetUserPath(D_CONFIG_IDX) + "GCPadNew.ini"; }
+std::string PlayerSection(std::size_t player) { return "GCPad" + std::to_string(player + 1); }
+std::string KeyboardSection(std::size_t player) { return "Keyboard" + std::to_string(player + 1); }
+
+std::string Read(const Common::IniFile::Section& section, const std::string& key) {
+  std::string value;
+  section.Get(key, &value);
+  return value;
+}
+bool HasBindings(const KeyboardBindings& bindings) {
+  return std::ranges::any_of(bindings.keys, [](const auto& key) { return !key.empty(); });
+}
+bool HasProfileOverride(std::size_t player) {
+  return SConfig::GetInstance().LoadGameIni().Exists(
+      "Controls", "PadProfile" + std::to_string(player + 1));
+}
+bool HasGamepadAssignment(const Common::IniFile::Section& pad,
+                         const Common::IniFile::Section& metadata) {
+  const auto device = Read(metadata, "GamepadDevice");
+  if (Read(metadata, "GamepadAssigned") != "True" || device != Read(pad, "Device") ||
+      device.size() > 4096 || device.find_first_of("\r\n") != std::string::npos ||
+      device.find('\0') != std::string::npos)
+    return false;
+  ciface::Core::DeviceQualifier qualifier;
+  qualifier.FromString(device);
+  return qualifier.source == "SDL" && qualifier.cid >= 0 && !qualifier.name.empty() &&
+         qualifier.ToString() == device;
+}
+void SetPort(std::size_t player, SerialInterface::SIDevices device) {
+  // The saved keyboard metadata owns this session overlay. Runtime.ini's base
+  // port settings stay intact, and SI applies its atomic request on its owner.
+  const Config::ConfigChangeCallbackGuard guard;
+  Config::SetCurrent(Config::GetInfoForSIDevice(static_cast<int>(player)), device);
+  auto& system = Core::System::GetInstance();
+  if (Core::IsRunning(system))
+    system.GetSerialInterface().ChangeDevice(device, static_cast<int>(player));
+}
+std::string Combined(const std::string& base, const std::string& device, const std::string& key) {
+  if (key.empty())
+    return base;
+  const std::string keyboard = "`" + device + ":" + key + "`";
+  return base.empty() ? keyboard : "(" + base + ") | " + keyboard;
+}
+
+std::vector<KeyboardDevice> Devices() {
+  std::vector<KeyboardDevice> result;
+  // GetAllDevices returns shared owners; hotplug cannot destroy these inputs
+  // during enumeration. Do not hold the controller-state lock while enumerating.
+  for (const auto& device : g_controller_interface.GetAllDevices()) {
+    if (device->GetSource() != "DInput" || device->GetName() != "Keyboard Mouse")
+      continue;
+    KeyboardDevice item{device->GetQualifiedName(), {}};
+    for (const auto* input : device->Inputs()) {
+      const std::string name = input->GetName();
+      // F1 and Escape belong to the menu. Relative/cursor axes are not keys.
+      if (input->IsHidden() || !input->IsDetectable() || name == "F1" || name == "ESCAPE" ||
+          name.starts_with("Cursor ") || name.starts_with("Axis ") || name.starts_with("RelativeMouse ") ||
+          name.find_first_of("`\r\n:") != std::string::npos)
+        continue;
+      item.keys.push_back(name);
+    }
+    std::ranges::sort(item.keys);
+    item.keys.erase(std::unique(item.keys.begin(), item.keys.end()), item.keys.end());
+    result.push_back(std::move(item));
+  }
+  return result;
+}
+
+KeyboardBindings ReadBindings(const Common::IniFile::Section& live,
+                              const Common::IniFile::Section* metadata) {
+  KeyboardBindings result;
+  if (!metadata)
+    return result;
+  result.device = Read(*metadata, "Device");
+  for (std::size_t i = 0; i < kKeyboardActions.size(); ++i) {
+    const std::string setting = kKeyboardActions[i].setting;
+    const auto key = Read(*metadata, "Key/" + setting);
+    const auto base = Read(*metadata, "Base/" + setting);
+    // A game-specific or externally edited profile is authoritative. Only
+    // identify keyboard expressions that this editor still owns exactly.
+    if (Read(live, setting) == Combined(base, result.device, key))
+      result.keys[i] = key;
+  }
+  return result;
+}
+
+std::string Apply(std::size_t player, const KeyboardBindings& bindings, bool fresh_profile) {
+  if (player >= 4 || !Pad::IsInitialized())
+    return "The selected player's controls are unavailable.";
+  if (NetPlay::IsNetPlayRunning())
+    return "Controls cannot be changed during online play.";
+  if (HasProfileOverride(player))
+    return "A game-specific input profile overrides this player. Remove that override before editing here.";
+  const auto devices = Devices();
+  if (HasBindings(bindings)) {
+    const auto device = std::ranges::find(devices, bindings.device, &KeyboardDevice::qualifier);
+    if (device == devices.end())
+      return "The selected keyboard is unavailable. Refresh the device list.";
+    for (const auto& key : bindings.keys)
+      if (!key.empty() && std::ranges::find(device->keys, key) == device->keys.end())
+        return "A selected key is unavailable or reserved for the menu.";
+  }
+  const std::string path = ConfigPath();
+  Common::IniFile file;
+  if (File::Exists(path) && !file.Load(path))
+    return "Could not read the saved controller profile. Existing bindings were kept.";
+  Common::IniFile::Section desired(PlayerSection(player));
+  if (const auto* saved = file.GetSection(PlayerSection(player)))
+    desired = *saved;
+  auto* metadata = file.GetOrCreateSection(KeyboardSection(player));
+  {
+    auto state_lock = ControllerEmu::EmulatedController::GetStateLock();
+    auto* controller = Pad::GetConfig()->GetController(static_cast<int>(player));
+    controller->SaveConfig(&desired);
+  }
+  const KeyboardBindings previous = ReadBindings(desired, metadata);
+  const auto current_port = Config::Get(Config::GetInfoForSIDevice(static_cast<int>(player)));
+  const bool owned_port = Read(*metadata, "ManagedPort") == "True" &&
+                         current_port == SerialInterface::SIDEVICE_GC_CONTROLLER;
+  int original_port = static_cast<int>(current_port);
+  if (owned_port) {
+    if (HasGamepadAssignment(desired, *metadata))
+      original_port = static_cast<int>(SerialInterface::SIDEVICE_GC_CONTROLLER);
+    else if (!metadata->Get("OriginalPort", &original_port) || original_port < 0 ||
+             original_port >= SerialInterface::SIDEVICE_COUNT)
+      return "The saved keyboard port setting is invalid. Existing controls were kept.";
+  }
+  const auto desired_port = HasBindings(bindings) ? SerialInterface::SIDEVICE_GC_CONTROLLER :
+      owned_port ? static_cast<SerialInterface::SIDevices>(original_port) : current_port;
+  std::string original_connection = Read(desired, "Options/Always Connected");
+  if (Read(*metadata, "ManagedAlwaysConnected") == "True" && original_connection == "True")
+    original_connection = Read(*metadata, "OriginalAlwaysConnected");
+  for (std::size_t i = 0; i < kKeyboardActions.size(); ++i) {
+    const std::string setting = kKeyboardActions[i].setting;
+    const std::string base = fresh_profile ? "" : !previous.keys[i].empty() ?
+        Read(*metadata, "Base/" + setting) : Read(desired, setting);
+    const std::string expression = Combined(base, bindings.device, bindings.keys[i]);
+    InputReference checked;
+    if (checked.SetExpression(expression))
+      return "A controller binding could not be parsed. Existing bindings were kept.";
+    desired.Set(setting, expression, "");
+    metadata->Set("Base/" + setting, base);
+    metadata->Set("Key/" + setting, bindings.keys[i]);
+  }
+  if (fresh_profile) {
+    desired.Set("Device", bindings.device);
+    desired.Set("Main Stick/Calibration", "100.00");
+    desired.Set("C-Stick/Calibration", "100.00");
+  }
+  desired.Set("Options/Always Connected", HasBindings(bindings) ? "True" : original_connection, "");
+  metadata->Set("Device", bindings.device);
+  metadata->Set("OriginalAlwaysConnected", original_connection);
+  metadata->Set("ManagedAlwaysConnected", HasBindings(bindings) ? "True" : "False");
+  metadata->Set("ManagedPort", HasBindings(bindings) ? "True" : "False");
+  metadata->Set("OriginalPort", original_port);
+  *file.GetOrCreateSection(PlayerSection(player)) = desired;
+  // Only the selected player's section is replaced. Unknown settings, gamepad
+  // expressions, and all other player slots remain in this same native profile.
+  // IniFile::Save uses a temporary file and rename; unlike InputConfig::SaveConfig
+  // it returns failure, so the live controls remain unchanged if persistence fails.
+  if (!File::CreateFullPath(path) || !file.Save(path))
+    return "Could not save the controller profile. Check the save folder's permissions and free space.";
+  {
+    auto state_lock = ControllerEmu::EmulatedController::GetStateLock();
+    state_lock.unlock();
+    std::unique_lock device_lock(g_controller_interface.GetDevicesMutex(), std::defer_lock);
+    std::lock(state_lock, device_lock);
+    auto* controller = Pad::GetConfig()->GetController(static_cast<int>(player));
+    controller->LoadConfig(&desired);
+    controller->UpdateReferences(g_controller_interface);
+  }
+  SetPort(player, desired_port);
+  return {};
+}
+} // namespace
+
+KeyboardBindings DefaultKeyboardBindings(const std::string& device) {
+  KeyboardBindings result;
+  result.device = device;
+  for (std::size_t i = 0; i < kKeyboardActions.size(); ++i)
+    result.keys[i] = kKeyboardActions[i].default_key;
+  return result;
+}
+
+std::string KeyboardKeyLabel(const std::string& key) {
+  static constexpr std::pair<std::string_view, std::string_view> labels[]{
+      {"LCONTROL", "Left Ctrl"}, {"RCONTROL", "Right Ctrl"},
+      {"LMENU", "Left Alt"}, {"RMENU", "Right Alt"},
+      {"LSHIFT", "Left Shift"}, {"RSHIFT", "Right Shift"},
+      {"LWIN", "Left Windows"}, {"RWIN", "Right Windows"},
+      {"RETURN", "Enter"}, {"SPACE", "Space"}, {"BACK", "Backspace"},
+      {"UP", "Up arrow"}, {"DOWN", "Down arrow"},
+      {"LEFT", "Left arrow"}, {"RIGHT", "Right arrow"},
+      {"PRIOR", "Page Up"}, {"NEXT", "Page Down"},
+      {"HOME", "Home"}, {"END", "End"}, {"INSERT", "Insert"}, {"DELETE", "Delete"},
+      {"TAB", "Tab"}, {"CAPITAL", "Caps Lock"}, {"NUMLOCK", "Num Lock"},
+      {"SCROLL", "Scroll Lock"}, {"NUMPADENTER", "Numpad Enter"},
+      {"Click 0", "Mouse left"}, {"Click 1", "Mouse right"},
+      {"Click 2", "Mouse middle"}, {"Click 3", "Mouse button 4"},
+      {"Click 4", "Mouse button 5"}, {"Click 5", "Mouse button 6"},
+      {"Click 6", "Mouse button 7"}, {"Click 7", "Mouse button 8"}};
+  if (key.empty())
+    return "Unbound";
+  for (const auto& [native, label] : labels)
+    if (native == key)
+      return std::string(label);
+  if (key.starts_with("NUMPAD"))
+    return "Numpad " + key.substr(6);
+  return key;
+}
+
+KeyboardControlsSnapshot ReadKeyboardControls() {
+  KeyboardControlsSnapshot result;
+  result.devices = Devices();
+  if (!Pad::IsInitialized()) {
+    result.error = "Controller settings are not ready.";
+    return result;
+  }
+  Common::IniFile file;
+  if (File::Exists(ConfigPath()) && !file.Load(ConfigPath())) {
+    result.error = "Could not read the saved controller profile.";
+    return result;
+  }
+  const auto lock = ControllerEmu::EmulatedController::GetStateLock();
+  for (std::size_t i = 0; i < result.players.size(); ++i) {
+    Common::IniFile::Section live;
+    Pad::GetConfig()->GetController(static_cast<int>(i))->SaveConfig(&live);
+    result.players[i] = ReadBindings(live, file.GetSection(KeyboardSection(i)));
+    if (result.players[i].device.empty() && !result.devices.empty())
+      result.players[i].device = result.devices.front().qualifier;
+  }
+  return result;
+}
+
+std::string ApplyKeyboardControls(std::size_t player, const KeyboardBindings& bindings) {
+  return Apply(player, bindings, false);
+}
+
+std::string InitializeKeyboardControls(bool allow_default, const std::filesystem::path& game_root) {
+  if (NetPlay::IsNetPlayRunning())
+    return {};
+  auto game_ini = SConfig::GetInstance().LoadGameIni();
+  if (!game_root.empty()) {
+    // Game metadata is not installed in SConfig until BootCore. Read only the
+    // disc identity needed to respect named input profiles before that point.
+    std::array<unsigned char, 8> header{};
+    std::ifstream boot(game_root / "sys" / "boot.bin", std::ios::binary);
+    boot.read(reinterpret_cast<char*>(header.data()), header.size());
+    const auto identity_end = header.begin() + 6;
+    if (!boot || !std::all_of(header.begin(), identity_end, [](unsigned char value) {
+          return (value >= 'A' && value <= 'Z') || (value >= '0' && value <= '9');
+        }))
+      return "Could not read the game identity for its input profiles.";
+    const std::string game_id(header.begin(), identity_end);
+    game_ini = SConfig::LoadGameIni(game_id, header[7]);
+  }
+  const auto profile_override = [&](std::size_t player) {
+    return game_ini.Exists("Controls", "PadProfile" + std::to_string(player + 1));
+  };
+  Common::IniFile file;
+  if (File::Exists(ConfigPath())) {
+    if (!file.Load(ConfigPath()))
+      return "Could not read the saved controller profile.";
+    for (std::size_t player = 0; player < 4; ++player) {
+      const auto* saved = file.GetSection(PlayerSection(player));
+      const auto* metadata = file.GetSection(KeyboardSection(player));
+      if (saved && metadata && !profile_override(player) &&
+          (HasGamepadAssignment(*saved, *metadata) ||
+           (Read(*metadata, "ManagedPort") == "True" &&
+            HasBindings(ReadBindings(*saved, metadata)))))
+        SetPort(player, SerialInterface::SIDEVICE_GC_CONTROLLER);
+    }
+    // Even an explicitly cleared keyboard profile remains cleared on restart.
+    if (file.Exists(KeyboardSection(0)))
+      return {};
+    if (const auto* saved = file.GetSection(PlayerSection(0)))
+      for (const auto& action : kKeyboardActions)
+        if (!Read(*saved, action.setting).empty())
+          return {};
+  }
+  if (!allow_default || profile_override(0))
+    return {};
+  const auto devices = Devices();
+  if (devices.empty())
+    return "No keyboard input device is available. Configure a controller before playing.";
+  return Apply(0, DefaultKeyboardBindings(devices.front().qualifier), true);
+}
+} // namespace moderngekko::detail
diff --git a/src/runtime/ingame_menu_controls.h b/src/runtime/ingame_menu_controls.h
new file mode 100644
index 0000000000000000000000000000000000000000..94b3f31f7cba0807cddf6eaacae82fd894c6c31b
--- /dev/null
+++ b/src/runtime/ingame_menu_controls.h
@@ -0,0 +1,59 @@
+// Copyright 2026 DW4_PC contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace moderngekko::detail {
+struct KeyboardAction {
+  const char* setting;
+  const char* label;
+  const char* default_key;
+};
+// Input names match the native Windows DInput keyboard device. Sticks retain
+// separate directional and modifier controls, and analog triggers stay editable.
+inline constexpr std::array<KeyboardAction, 24> kKeyboardActions{{
+    {"Buttons/A", "A", "SPACE"}, {"Buttons/B", "B", "LCONTROL"},
+    {"Buttons/X", "X", "E"}, {"Buttons/Y", "Y", "R"},
+    {"Buttons/Z", "Z", "Q"}, {"Buttons/Start", "Start", "RETURN"},
+    {"Main Stick/Up", "Move up", "W"}, {"Main Stick/Down", "Move down", "S"},
+    {"Main Stick/Left", "Move left", "A"}, {"Main Stick/Right", "Move right", "D"},
+    {"Main Stick/Modifier", "Move slowly", "LMENU"},
+    {"C-Stick/Up", "C stick up", "I"}, {"C-Stick/Down", "C stick down", "K"},
+    {"C-Stick/Left", "C stick left", "J"}, {"C-Stick/Right", "C stick right", "L"},
+    {"C-Stick/Modifier", "C stick modifier", ""},
+    {"Triggers/L", "L", "LSHIFT"}, {"Triggers/R", "R", "F"},
+    {"Triggers/L-Analog", "L analog", "LSHIFT"}, {"Triggers/R-Analog", "R analog", "F"},
+    {"D-Pad/Up", "D-pad up", "UP"}, {"D-Pad/Down", "D-pad down", "DOWN"},
+    {"D-Pad/Left", "D-pad left", "LEFT"}, {"D-Pad/Right", "D-pad right", "RIGHT"},
+}};
+
+struct KeyboardBindings {
+  std::string device;
+  std::array<std::string, kKeyboardActions.size()> keys;
+  bool operator==(const KeyboardBindings&) const = default;
+};
+struct KeyboardDevice {
+  std::string qualifier;
+  std::vector<std::string> keys;
+};
+struct KeyboardControlsSnapshot {
+  std::array<KeyboardBindings, 4> players;
+  std::vector<KeyboardDevice> devices;
+  std::string error;
+};
+
+KeyboardBindings DefaultKeyboardBindings(const std::string& device);
+std::string KeyboardKeyLabel(const std::string& key);
+// Host thread only. These access the actual Pad configuration, never ImGui.
+KeyboardControlsSnapshot ReadKeyboardControls();
+std::string ApplyKeyboardControls(std::size_t player, const KeyboardBindings& bindings);
+// Call after UICommon::InitControllers, before boot reloads the Pad profile.
+// Headless/hidden diagnostics pass false. Existing profiles are preserved.
+std::string InitializeKeyboardControls(bool allow_default,
+                                       const std::filesystem::path& game_root = {});
+} // namespace moderngekko::detail
diff --git a/src/runtime/ingame_menu_input.hpp b/src/runtime/ingame_menu_input.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..18b764ee59ba283b3aa9e5ce02c5742cd3e43b8f
--- /dev/null
+++ b/src/runtime/ingame_menu_input.hpp
@@ -0,0 +1,106 @@
+// Copyright 2026 DW4_PC contributors
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+
+#include "DolphinNoGUI/UIInput.h"
+
+namespace moderngekko::detail {
+
+// Standard-library-only input policy, shared by the real menu and its tests.
+// Reset is delivered separately, so overflow cannot strand a held ImGui key.
+class InGameMenuInput {
+public:
+  static constexpr std::size_t Capacity = 512;
+  struct Batch {
+    std::array<FrontendUI::InputEvent, Capacity> events{};
+    std::size_t size = 0;
+    bool reset = false;
+  };
+
+  bool Handle(const FrontendUI::InputEvent& event) {
+    using namespace FrontendUI;
+    std::lock_guard lock(m_mutex);
+    if (!m_alive.load())
+      return false;
+    ++m_events;
+    if (event.kind == InputKind::Key && event.key == Key::F1) {
+      if (event.down && !event.repeat)
+        SetOpenLocked(!m_open.load());
+      return true;
+    }
+    if (event.kind == InputKind::Key && event.key == Key::Escape && m_open.load()) {
+      if (event.down && !event.repeat)
+        SetOpenLocked(false);
+      return true;
+    }
+    if (event.kind == InputKind::Reset ||
+        (event.kind == InputKind::Focus && !event.down)) {
+      m_size = 0;
+      m_reset = true;
+    }
+    if (event.kind == InputKind::Focus || event.kind == InputKind::Reset || m_open.load())
+      PushLocked(event);
+    return m_open.load();
+  }
+
+  void Close() {
+    std::lock_guard lock(m_mutex);
+    SetOpenLocked(false);
+  }
+  void Retire() {
+    std::lock_guard lock(m_mutex);
+    m_alive.store(false);
+    SetOpenLocked(false);
+  }
+  bool IsOpen() const { return m_alive.load() && m_open.load(); }
+  bool IsAlive() const { return m_alive.load(); }
+  std::uint64_t Events() const { return m_events.load(); }
+  std::uint64_t Overflows() const { return m_overflows.load(); }
+  Batch Drain() {
+    std::lock_guard lock(m_mutex);
+    Batch batch;
+    batch.size = m_size;
+    batch.reset = m_reset;
+    for (std::size_t i = 0; i < m_size; ++i)
+      batch.events[i] = m_queue[i];
+    m_size = 0;
+    m_reset = false;
+    return batch;
+  }
+
+private:
+  void SetOpenLocked(bool open) {
+    m_open.store(open);
+    m_size = 0;
+    m_reset = true;
+  }
+  void PushLocked(const FrontendUI::InputEvent& event) {
+    using FrontendUI::InputKind;
+    if (event.kind == InputKind::MousePosition && m_size != 0 &&
+        m_queue[m_size - 1].kind == InputKind::MousePosition) {
+      m_queue[m_size - 1] = event;
+      return;
+    }
+    if (m_size == Capacity) {
+      m_size = 0;
+      m_reset = true;
+      ++m_overflows;
+    }
+    m_queue[m_size++] = event;
+  }
+  std::mutex m_mutex;
+  std::array<FrontendUI::InputEvent, Capacity> m_queue{};
+  std::size_t m_size = 0;
+  bool m_reset = true;
+  std::atomic<bool> m_alive{true};
+  std::atomic<bool> m_open{false};
+  std::atomic<std::uint64_t> m_events{0};
+  std::atomic<std::uint64_t> m_overflows{0};
+};
+} // namespace moderngekko::detail
