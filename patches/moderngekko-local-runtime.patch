+void InGameMenu::BeginFrame() {
+  auto& self = *m_impl;
+  if (!self.input.IsAlive() || !ImGui::GetCurrentContext())
+    return;
+  auto& io = ImGui::GetIO();
+  io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard;
+  io.MouseDrawCursor = self.input.IsOpen();
+  const auto batch = self.input.Drain();
+  if (batch.reset) {
+    // ImGui can retain transitions for later frames when its input trickle
+    // queue is enabled. Clearing only held state would let those reassert it.
+    io.ClearEventsQueue();
+    io.ClearInputKeys();
+    io.ClearInputMouse();
+    self.modifiers.fill(false);
+  }
+  using namespace FrontendUI;
+  for (std::size_t i = 0; i < batch.size; ++i) {
+    const auto& event = batch.events[i];
+    switch (event.kind) {
+      case InputKind::Key: {
+        if (event.repeat)
+          break; // ImGui owns repeat timing from the original down transition.
+        const ImGuiKey key = ToImGuiKey(event.key);
+        if (key != ImGuiKey_None)
+          io.AddKeyEvent(key, event.down);
+        if (event.key >= Key::LeftCtrl && event.key <= Key::RightSuper) {
+          self.modifiers[static_cast<std::size_t>(event.key) - static_cast<std::size_t>(Key::LeftCtrl)] = event.down;
+          io.AddKeyEvent(ImGuiMod_Ctrl, self.modifiers[0] || self.modifiers[1]);
+          io.AddKeyEvent(ImGuiMod_Shift, self.modifiers[2] || self.modifiers[3]);
+          io.AddKeyEvent(ImGuiMod_Alt, self.modifiers[4] || self.modifiers[5]);
+          io.AddKeyEvent(ImGuiMod_Super, self.modifiers[6] || self.modifiers[7]);
+        }
+        break;
+      }
+      case InputKind::Character:
+        if (event.character > 0 && event.character <= 0x10ffff &&
+            (event.character < 0xd800 || event.character > 0xdfff))
+          io.AddInputCharacter(event.character);
+        break;
+      case InputKind::MousePosition:
+        if (std::isfinite(event.x) && std::isfinite(event.y))
+          io.AddMousePosEvent(event.x, event.y);
+        break;
+      case InputKind::MouseButton:
+        if (event.button >= 0 && event.button < 5)
+          io.AddMouseButtonEvent(event.button, event.down);
+        break;
+      case InputKind::MouseWheel:
+        if (std::isfinite(event.x) && std::isfinite(event.y))
+          io.AddMouseWheelEvent(event.x, event.y);
+        break;
+      case InputKind::Focus: io.AddFocusEvent(event.down); break;
+      case InputKind::Reset: break; // Drain's reset flag already released every key/button.
+    }
+  }
+}
