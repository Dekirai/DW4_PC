+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <filesystem>
+#include <new>
+#include <string>
+#include <system_error>
+#include <vector>
+
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#endif
+
+namespace moderngekko::frontend {
+namespace portable_profile_detail {
+inline constexpr std::uint64_t kMaximumConfigBytes = 4u * 1024u * 1024u;
+
+inline std::string PathText(const std::filesystem::path& path) {
+  const auto utf8 = path.u8string();
+  return {reinterpret_cast<const char*>(utf8.data()), utf8.size()};
+}
+
+inline bool Fail(std::string* error, const std::string& message) {
+  if (error)
+    *error = message;
+  return false;
+}
+
+#if defined(_WIN32)
+class Handle {
+public:
+  explicit Handle(HANDLE value = INVALID_HANDLE_VALUE) : value_(value) {}
+  ~Handle() { if (value_ != INVALID_HANDLE_VALUE) CloseHandle(value_); }
+  Handle(const Handle&) = delete;
+  Handle& operator=(const Handle&) = delete;
+  HANDLE get() const { return value_; }
+  explicit operator bool() const { return value_ != INVALID_HANDLE_VALUE; }
+private:
+  HANDLE value_;
+};
+
+inline bool WindowsFailure(std::string* error, const char* operation,
+                           const std::filesystem::path& path, DWORD code) {
+  return Fail(error, std::string(operation) + " '" + PathText(path) +
+      "' (Windows error " + std::to_string(code) + ": " +
+      std::system_category().message(static_cast<int>(code)) +
+      "). Check profile permissions and close programs editing its configuration, then retry. "
+      "The legacy file and saves have not been changed.");
+}
+
+enum class FileState { Missing, Regular, Invalid, Failed };
+
+inline FileState InspectFile(const std::filesystem::path& path, std::string* error) {
+  const Handle file(CreateFileW(path.c_str(), FILE_READ_ATTRIBUTES,
+      FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
+      FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_BACKUP_SEMANTICS, nullptr));
+  if (!file) {
+    const DWORD code = GetLastError();
+    if (code == ERROR_FILE_NOT_FOUND || code == ERROR_PATH_NOT_FOUND)
+      return FileState::Missing;
+    WindowsFailure(error, "Cannot inspect configuration", path, code);
+    return FileState::Failed;
+  }
+  BY_HANDLE_FILE_INFORMATION info{};
+  if (!GetFileInformationByHandle(file.get(), &info)) {
+    WindowsFailure(error, "Cannot inspect configuration", path, GetLastError());
+    return FileState::Failed;
+  }
+  if ((info.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) != 0 ||
+      GetFileType(file.get()) != FILE_TYPE_DISK) {
+    Fail(error, "Configuration must be a regular file, not a directory or symbolic link: '" +
+        PathText(path) + "'. Move the invalid entry aside and retry; it has not been changed.");
+    return FileState::Invalid;
+  }
+  return FileState::Regular;
+}
+
+// Cleanup names the opened file object, never a pathname another process could
+// replace. Successful publication disarms cleanup before this handle closes.
+class TemporaryFile {
+public:
+  explicit TemporaryFile(HANDLE value) : handle_(value) {}
+  ~TemporaryFile() {
+    if (!published_) {
+      FILE_DISPOSITION_INFO disposition{};
+      disposition.DeleteFile = TRUE;
+      SetFileInformationByHandle(handle_.get(), FileDispositionInfo, &disposition,
+                                sizeof(disposition));
+    }
+  }
+  HANDLE get() const { return handle_.get(); }
+  void Published() { published_ = true; }
+private:
+  Handle handle_;
+  bool published_ = false;
+};
+
+inline bool CopyLegacy(const std::filesystem::path& config_directory,
+                       const std::filesystem::path& legacy,
+                       const std::filesystem::path& destination,
+                       std::string* error) {
+  // Holding the directory without delete sharing prevents its rename/replacement
+  // during creation and publication. Reparse-point directories are rejected.
+  const Handle directory(CreateFileW(config_directory.c_str(), FILE_READ_ATTRIBUTES,
+      FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr, OPEN_EXISTING,
+      FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OPEN_REPARSE_POINT, nullptr));
+  if (!directory)
+    return WindowsFailure(error, "Cannot open configuration directory", config_directory, GetLastError());
+  BY_HANDLE_FILE_INFORMATION directory_info{};
+  if (!GetFileInformationByHandle(directory.get(), &directory_info))
+    return WindowsFailure(error, "Cannot inspect configuration directory", config_directory, GetLastError());
+  if ((directory_info.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) == 0 ||
+      (directory_info.dwFileAttributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0)
+    return Fail(error, "Configuration directory must be a real directory, not a symbolic link: '" +
+                       PathText(config_directory) + "'. No files were changed.");
+
+  // Deny concurrent writes and deletion for the complete read. OPEN_REPARSE_POINT
+  // plus handle inspection also closes the source symlink check/open race.
+  const Handle source(CreateFileW(legacy.c_str(), GENERIC_READ, FILE_SHARE_READ,
+      nullptr, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT | FILE_FLAG_SEQUENTIAL_SCAN |
+      FILE_FLAG_BACKUP_SEMANTICS, nullptr));
+  if (!source)
+    return WindowsFailure(error, "Cannot safely read legacy configuration", legacy, GetLastError());
+  BY_HANDLE_FILE_INFORMATION source_info{};
+  if (!GetFileInformationByHandle(source.get(), &source_info))
+    return WindowsFailure(error, "Cannot inspect legacy configuration", legacy, GetLastError());
+  if ((source_info.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) != 0 ||
+      GetFileType(source.get()) != FILE_TYPE_DISK)
+    return Fail(error, "Legacy configuration must be a regular file, not a directory or symbolic link: '" +
+                       PathText(legacy) + "'. No files were changed.");
+  const std::uint64_t size = (static_cast<std::uint64_t>(source_info.nFileSizeHigh) << 32) |
+      source_info.nFileSizeLow;
+  if (size > kMaximumConfigBytes)
+    return Fail(error, "Legacy configuration exceeds the 4 MiB migration limit: '" +
+                       PathText(legacy) + "'. Review its contents before retrying; no files were changed.");
+
+  static std::atomic<std::uint64_t> sequence{0};
+  HANDLE created = INVALID_HANDLE_VALUE;
+  std::filesystem::path temporary_path;
+  for (unsigned attempt = 0; attempt < 64; ++attempt) {
+    temporary_path = config_directory / (L".Runtime.ini.migrate-" +
+        std::to_wstring(GetCurrentProcessId()) + L"-" + std::to_wstring(GetTickCount64()) +
+        L"-" + std::to_wstring(sequence.fetch_add(1, std::memory_order_relaxed)) + L".tmp");
+    created = CreateFileW(temporary_path.c_str(), GENERIC_WRITE | DELETE,
+        0, nullptr, CREATE_NEW, FILE_ATTRIBUTE_NORMAL | FILE_FLAG_SEQUENTIAL_SCAN, nullptr);
+    if (created != INVALID_HANDLE_VALUE)
+      break;
+    const DWORD code = GetLastError();
+    if (code != ERROR_FILE_EXISTS && code != ERROR_ALREADY_EXISTS)
+      return WindowsFailure(error, "Cannot create migration temporary file", temporary_path, code);
+  }
+  if (created == INVALID_HANDLE_VALUE)
+    return Fail(error, "Cannot allocate a unique configuration migration file in '" +
+                       PathText(config_directory) + "'. Close other migration attempts and retry.");
+  TemporaryFile temporary(created);
+  std::array<unsigned char, 64u * 1024u> buffer{};
+  std::uint64_t copied = 0;
+  while (copied < size) {
+    const DWORD requested = static_cast<DWORD>((size - copied) < buffer.size() ?
+        size - copied : buffer.size());
+    DWORD received = 0;
+    if (!ReadFile(source.get(), buffer.data(), requested, &received, nullptr))
+      return WindowsFailure(error, "Cannot read legacy configuration", legacy, GetLastError());
+    if (received == 0 || received > requested)
+      return Fail(error, "Legacy configuration changed or ended during migration: '" +
+                         PathText(legacy) + "'. Close programs editing it and retry.");
+    DWORD offset = 0;
+    while (offset < received) {
+      DWORD written = 0;
+      if (!WriteFile(temporary.get(), buffer.data() + offset, received - offset, &written, nullptr))
+        return WindowsFailure(error, "Cannot write migrated configuration", temporary_path, GetLastError());
+      if (written == 0 || written > received - offset)
+        return WindowsFailure(error, "Cannot complete migrated configuration", temporary_path, ERROR_WRITE_FAULT);
+      offset += written;
+    }
+    copied += received;
+  }
+  DWORD extra = 0;
+  if (!ReadFile(source.get(), buffer.data(), 1, &extra, nullptr))
+    return WindowsFailure(error, "Cannot finish reading legacy configuration", legacy, GetLastError());
+  if (extra != 0)
+    return Fail(error, "Legacy configuration grew during migration: '" + PathText(legacy) +
+                       "'. Close programs editing it and retry.");
+  if (!FlushFileBuffers(temporary.get()))
+    return WindowsFailure(error, "Cannot flush migrated configuration", temporary_path, GetLastError());
+
+  // FileRenameInfo with ReplaceIfExists=FALSE atomically publishes the complete
+  // opened file, or fails without replacing a racing destination. Keeping the
+  // handle avoids a temporary-path substitution race. See Microsoft's
+  // FILE_RENAME_INFO documentation for the no-replace contract.
+  const std::wstring name = destination.wstring();
+  if (name.size() > 32767)
+    return Fail(error, "Runtime configuration path exceeds the Windows path limit. Choose a shorter user directory.");
+  const std::size_t name_bytes = name.size() * sizeof(wchar_t);
+  const std::size_t rename_bytes = offsetof(FILE_RENAME_INFO, FileName) + name_bytes + sizeof(wchar_t);
+  static_assert(alignof(std::uint64_t) >= alignof(FILE_RENAME_INFO));
+  std::vector<std::uint64_t> rename_storage((rename_bytes + sizeof(std::uint64_t) - 1) / sizeof(std::uint64_t));
+  auto* rename = new (rename_storage.data()) FILE_RENAME_INFO{};
+  rename->ReplaceIfExists = FALSE;
+  rename->RootDirectory = nullptr;
+  rename->FileNameLength = static_cast<DWORD>(name_bytes);
+  std::memcpy(reinterpret_cast<unsigned char*>(rename_storage.data()) + offsetof(FILE_RENAME_INFO, FileName),
+              name.c_str(), name_bytes + sizeof(wchar_t));
+  if (!SetFileInformationByHandle(temporary.get(), FileRenameInfo, rename,
+                                 static_cast<DWORD>(rename_bytes))) {
+    const DWORD code = GetLastError();
+    // Another process may already have installed a configuration. Preserve it
+    // and treat the migration as complete only after checking its file type.
+    const FileState state = InspectFile(destination, error);
+    if (state == FileState::Regular)
+      return true;
+    if (state == FileState::Invalid || state == FileState::Failed)
+      return false;
+    return WindowsFailure(error, "Cannot publish migrated configuration", destination, code);
+  }
+  temporary.Published();
+  return true;
+}
+#endif
+} // namespace portable_profile_detail
+
+// Preserve every existing current configuration and every legacy/save file.
+// Copy bytes without parsing: malformed INI text remains available for the
+// normal configuration loader to diagnose, with the original retained.
+inline bool MigrateLegacyRuntimeConfig(const std::filesystem::path& user_directory,
+                                      std::string* error) {
+  using namespace portable_profile_detail;
+  if (error)
+    error->clear();
+  try {
+    if (user_directory.empty())
+      return Fail(error, "Cannot migrate configuration without a user directory.");
+    const auto config_directory = std::filesystem::absolute(user_directory) / "Config";
+    const auto destination = config_directory / "Runtime.ini";
+    const auto legacy = config_directory / "Dolphin.ini";
+#if defined(_WIN32)
+    const FileState current = InspectFile(destination, error);
+    if (current == FileState::Regular)
+      return true;
+    if (current != FileState::Missing)
+      return false;
+    const DWORD directory_attributes = GetFileAttributesW(config_directory.c_str());
+    if (directory_attributes == INVALID_FILE_ATTRIBUTES) {
+      const DWORD code = GetLastError();
+      if (code == ERROR_FILE_NOT_FOUND || code == ERROR_PATH_NOT_FOUND)
+        return true;
+      return WindowsFailure(error, "Cannot inspect configuration directory", config_directory, code);
+    }
+    if ((directory_attributes & FILE_ATTRIBUTE_DIRECTORY) == 0 ||
+        (directory_attributes & FILE_ATTRIBUTE_REPARSE_POINT) != 0)
+      return Fail(error, "Configuration path must be a real directory: '" + PathText(config_directory) +
+                         "'. Move the invalid entry aside and retry; no files were changed.");
+    const FileState old = InspectFile(legacy, error);
+    if (old == FileState::Missing)
+      return true;
+    if (old != FileState::Regular)
+      return false;
+    return CopyLegacy(config_directory, legacy, destination, error);
+#else
+    std::error_code status_error;
+    const auto current = std::filesystem::symlink_status(destination, status_error);
+    if (!status_error && std::filesystem::is_regular_file(current))
+      return true;
+    if (!status_error && std::filesystem::exists(current))
+      return Fail(error, "Runtime.ini must be a regular file, not a directory or symbolic link.");
+    if (status_error && status_error != std::errc::no_such_file_or_directory)
+      return Fail(error, "Cannot inspect Runtime.ini: " + status_error.message());
+    status_error.clear();
+    const auto old = std::filesystem::symlink_status(legacy, status_error);
+    if (status_error == std::errc::no_such_file_or_directory ||
+        (!status_error && !std::filesystem::exists(old)))
+      return true;
+    if (status_error)
+      return Fail(error, "Cannot inspect Dolphin.ini: " + status_error.message());
+    return Fail(error, "Automatic legacy configuration migration requires Windows. Close the application, "
+                       "copy Config/Dolphin.ini to Config/Runtime.ini without replacing an existing file, then retry.");
+#endif
+  } catch (const std::exception& exception) {
+    return Fail(error, std::string("Cannot safely migrate runtime configuration: ") + exception.what() +
+                       ". Check the user directory and retry; the legacy file and saves were not changed.");
+  }
+}
+} // namespace moderngekko::frontend
