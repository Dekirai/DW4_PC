+// Preserve raw lines outside the exact settings changed by controller selection.
+// Effective lookup follows Common::IniFile: case-insensitive section/key names,
+// last duplicate wins, a leading UTF-8 BOM is ignored, and outer quotes strip.
+class ControllerProfile {
+public:
+  explicit ControllerProfile(const std::string& bytes) {
+    std::string section;
+    for (std::size_t start = 0; start < bytes.size();) {
+      const auto end = bytes.find('\n', start);
+      const auto length = end == std::string::npos ? bytes.size() - start : end - start + 1;
+      if (lines.size() >= 65536 || length > 65536)
+        throw std::runtime_error("controller profile has too many lines or an oversized line");
+      Line line{bytes.substr(start, length), section, {}, {}, false};
+      std::string text = line.raw;
+      if (start == 0 && text.starts_with("\xef\xbb\xbf"))
+        text.erase(0, 3);
+      if (end != std::string::npos && lines.empty())
+        newline = text.ends_with("\r\n") ? "\r\n" : "\n";
+      if (!text.empty() && text.front() == '[') {
+        const auto close = text.find(']');
+        if (close != std::string::npos) {
+          section = Lower(text.substr(1, close - 1));
+          line.section = section;
+          line.header = true;
+        }
+      } else if (!section.empty() && !text.empty() &&
+                 std::string_view("#$*+").find(text.front()) == std::string_view::npos) {
+        const auto equals = text.find('=');
+        if (equals != std::string::npos) {
+          line.key = Lower(Trim(text.substr(0, equals)));
+          line.value = Trim(text.substr(equals + 1));
+          if (line.value.size() >= 2 && line.value.front() == '"' && line.value.back() == '"')
+            line.value = line.value.substr(1, line.value.size() - 2);
+        }
+      }
+      lines.push_back(std::move(line));
+      start += length;
+    }
+  }
+
+  std::string Get(const std::string& section, const std::string& key) const {
+    const auto normalized_section = Lower(section), normalized_key = Lower(key);
+    const auto found = std::find_if(lines.rbegin(), lines.rend(), [&](const Line& line) {
+      return line.section == normalized_section && line.key == normalized_key;
+    });
+    return found == lines.rend() ? std::string{} : found->value;
+  }
+
+  bool Has(const std::string& section, const std::string& key) const {
+    const auto normalized_section = Lower(section), normalized_key = Lower(key);
+    return std::ranges::any_of(lines, [&](const Line& line) {
+      return line.section == normalized_section && line.key == normalized_key;
+    });
+  }
+
+  void Set(const std::string& section, const std::string& key, const std::string& value) {
+    const auto normalized_section = Lower(section), normalized_key = Lower(key);
+    for (auto line = lines.rbegin(); line != lines.rend(); ++line) {
+      if (line->section != normalized_section || line->key != normalized_key)
+        continue;
+      const auto ending = line->raw.ends_with("\r\n") ? "\r\n" :
+                          line->raw.ends_with('\n') ? "\n" : "";
+      line->raw = key + " = " + value + ending;
+      line->value = value;
+      return;
+    }
+    std::size_t insertion = lines.size();
+    bool found_section = false;
+    for (std::size_t i = 0; i < lines.size(); ++i) {
+      if (lines[i].section == normalized_section) {
+        insertion = i + 1;
+        found_section = true;
+      }
+    }
+    if (insertion != 0 && !lines[insertion - 1].raw.ends_with('\n'))
+      lines[insertion - 1].raw += newline;
+    if (!found_section) {
+      lines.push_back({"[" + section + "]" + newline, normalized_section, {}, {}, true});
+      insertion = lines.size();
+    }
+    lines.insert(lines.begin() + static_cast<std::ptrdiff_t>(insertion),
+                 {key + " = " + value + newline, normalized_section, normalized_key, value, false});
+  }
+
+  std::vector<std::pair<std::string, std::string>> Settings(const std::string& section) const {
+    std::vector<std::pair<std::string, std::string>> result;
+    const auto normalized_section = Lower(section);
+    for (const auto& line : lines)
+      if (line.section == normalized_section && !line.key.empty())
+        result.emplace_back(Trim(line.raw.substr(0, line.raw.find('='))), line.value);
+    return result;
+  }
+
+  std::string Serialize() const {
+    std::string result;
+    for (const auto& line : lines)
+      result += line.raw;
+    return result;
+  }
+
+private:
+  struct Line {
+    std::string raw, section, key, value;
+    bool header;
+  };
+  std::vector<Line> lines;
+  std::string newline = "\n";
+};
+
+std::string KeyboardExpression(const std::string& base, const std::string& device,
+                               const std::string& key) {
+  if (key.empty())
+    return base;
+  const auto keyboard = "`" + device + ":" + key + "`";
+  return base.empty() ? keyboard : "(" + base + ") | " + keyboard;
+}
+
+bool ValidSDLDevice(const std::string& device) {
+  if (!device.starts_with("SDL/") || device.size() > 4096)
+    return false;
+  const auto separator = device.find('/', 4);
+  if (separator == std::string::npos || separator + 1 == device.size())
+    return false;
+  int index = -1;
+  const auto result = std::from_chars(device.data() + 4, device.data() + separator, index);
+  return result.ec == std::errc{} && result.ptr == device.data() + separator && index >= 0 &&
+         std::ranges::all_of(device, [](unsigned char value) { return value >= 32 && value != 127; });
+}
+
+bool WriteControllerProfile(const fs::path& destination, const std::string& bytes,
+                            std::string* message) {
+  static std::atomic<std::uint64_t> sequence{0};
+  const auto token = std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()) +
+                     "-" + std::to_string(sequence.fetch_add(1));
+  const auto temporary_path = destination.parent_path() / (".controller-update-" + token + ".tmp");
+  const auto fail = [&](const char* operation) {
+    if (message)
+      *message = std::string(operation) + "; existing controller bindings were kept";
+    return false;
+  };
+#ifdef _WIN32
+  struct Temporary {
+    HANDLE handle;
+    bool published = false;
+    ~Temporary() {
+      if (handle == INVALID_HANDLE_VALUE)
+        return;
+      if (!published) {
+        FILE_DISPOSITION_INFO disposition{TRUE};
+        SetFileInformationByHandle(handle, FileDispositionInfo, &disposition, sizeof(disposition));
+      }
+      CloseHandle(handle);
+    }
+  } temporary{CreateFileW(temporary_path.c_str(), GENERIC_WRITE | DELETE, 0, nullptr, CREATE_NEW,
+                           FILE_ATTRIBUTE_NORMAL, nullptr)};
+  if (temporary.handle == INVALID_HANDLE_VALUE)
+    return fail("can't create controller profile temporary file");
+  DWORD written = 0;
+  if (!WriteFile(temporary.handle, bytes.data(), static_cast<DWORD>(bytes.size()), &written, nullptr) ||
+      written != bytes.size() || !FlushFileBuffers(temporary.handle))
+    return fail("can't write controller profile temporary file");
+  // Rename the opened temporary file, so publication/cleanup never follows a
+  // substituted temporary pathname. An open/read-only destination can reject
+  // this operation without receiving a partial write.
+  const auto name = fs::absolute(destination).wstring();
+  if (name.size() > 32767)
+    return fail("controller profile path is too long");
+  const auto name_bytes = name.size() * sizeof(wchar_t);
+  const auto rename_bytes = offsetof(FILE_RENAME_INFO, FileName) + name_bytes + sizeof(wchar_t);
+  std::vector<std::uint64_t> storage((rename_bytes + sizeof(std::uint64_t) - 1) / sizeof(std::uint64_t));
+  static_assert(alignof(std::uint64_t) >= alignof(FILE_RENAME_INFO));
+  auto* rename = new (storage.data()) FILE_RENAME_INFO{};
+  rename->ReplaceIfExists = TRUE;
+  rename->FileNameLength = static_cast<DWORD>(name_bytes);
+  std::memcpy(reinterpret_cast<unsigned char*>(storage.data()) + offsetof(FILE_RENAME_INFO, FileName),
+              name.c_str(), name_bytes + sizeof(wchar_t));
+  if (!SetFileInformationByHandle(temporary.handle, FileRenameInfo, rename, static_cast<DWORD>(rename_bytes)))
+    return fail("can't publish controller profile; close applications editing it and check folder permissions");
+  temporary.published = true;
+  return true;
+#else
+  FILE* temporary = std::fopen(temporary_path.c_str(), "wx");
+  if (!temporary)
+    return fail("can't create controller profile temporary file");
+  const bool written = std::fwrite(bytes.data(), 1, bytes.size(), temporary) == bytes.size() &&
+                       std::fflush(temporary) == 0 && fsync(fileno(temporary)) == 0;
+  const bool closed = std::fclose(temporary) == 0;
+  std::error_code ec;
+  if (written && closed)
+    fs::rename(temporary_path, destination, ec);
+  if (written && closed && !ec)
+    return true;
+  fs::remove(temporary_path, ec);
+  return fail("can't publish controller profile; check folder permissions");
+#endif
+}
+
+bool MergeControllerProfile(const fs::path& destination, const std::string& defaults,
+                            std::size_t players, std::string* message) {
+  try {
+    constexpr std::uintmax_t maximum_bytes = 4u * 1024u * 1024u;
+    std::error_code ec;
+    const auto status = fs::symlink_status(destination, ec);
+    if (ec && ec != std::errc::no_such_file_or_directory)
+      throw std::runtime_error("can't inspect controller profile: " + ec.message());
+    const bool exists = fs::exists(status);
+    std::string existing;
+    if (exists) {
+      if (!fs::is_regular_file(status))
+        throw std::runtime_error("controller profile must be a regular file");
+      const auto size = fs::file_size(destination);
+      if (size > maximum_bytes)
+        throw std::runtime_error("controller profile exceeds the 4 MiB size limit");
+      std::ifstream input(destination, std::ios::binary);
+      existing.resize(static_cast<std::size_t>(size));
+      if (!input.read(existing.data(), static_cast<std::streamsize>(size)) ||
+          input.peek() != std::char_traits<char>::eof() || existing.find('\0') != std::string::npos)
+        throw std::runtime_error("can't read controller profile completely");
+    }
+    ControllerProfile merged(existing), generated(defaults);
+    for (std::size_t player = 0; player < players; ++player) {
+      const auto section = std::string(ControllerSectionPrefix().substr(1)) + std::to_string(player + 1);
+      const auto selected_device = generated.Get(section, "Device");
+      if (!ValidSDLDevice(selected_device)) {
+        // A pre-existing keyboard can remain in the local-player list when
+        // another SDL gamepad is added. Never generate SDL inputs for it.
+        if (exists && !selected_device.starts_with("SDL/") &&
+            merged.Get(section, "Device") == selected_device)
+          continue;
+        throw std::runtime_error("select a valid connected SDL gamepad");
+      }
+#ifdef MODERNGEKKO_GAMECUBE_CONTROLLERS
+      const auto metadata = "Keyboard" + std::to_string(player + 1);
+      // Selecting a physical pad is a saved port assignment of its own. The
+      // runtime validates this exact device match before using that intent.
+      merged.Set(metadata, "GamepadAssigned", "True");
+      merged.Set(metadata, "GamepadDevice", selected_device);
+#endif
+      for (const auto& [setting, value] : generated.Settings(section)) {
+        if (setting == "Device") {
+          merged.Set(section, "Device", value);
+          continue;
+        }
+        const auto current = merged.Get(section, setting);
+#ifdef MODERNGEKKO_GAMECUBE_CONTROLLERS
+        const auto key = merged.Get(metadata, "Key/" + setting);
+        const auto base = merged.Get(metadata, "Base/" + setting);
+        const auto keyboard = merged.Get(metadata, "Device");
+        if ((merged.Has(metadata, "Key/" + setting) || merged.Has(metadata, "Base/" + setting)) &&
+            current == KeyboardExpression(base, keyboard, key)) {
+          const auto preserved_base = base.empty() ? value : base;
+          merged.Set(section, setting, KeyboardExpression(preserved_base, keyboard, key));
+          merged.Set(metadata, "Base/" + setting, preserved_base);
+          continue;
+        }
+#endif
+        // An explicit empty mapping is a deliberate unbound control. Add
+        // defaults only for absent settings, except the owned keyboard Base
+        // case above, where selecting a gamepad intentionally adds its input.
+        if (!merged.Has(section, setting))
+          merged.Set(section, setting, value);
+      }
+    }
+    const auto result = merged.Serialize();
+    if (result.size() > maximum_bytes)
+      throw std::runtime_error("merged controller profile exceeds the 4 MiB size limit");
+    return WriteControllerProfile(destination, result, message);
+  } catch (const std::exception& error) {
+    if (message)
+      *message = std::string(error.what()) + "; existing controller bindings were kept";
+    return false;
+  }
+}
