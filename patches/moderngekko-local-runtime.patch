+#!/usr/bin/env python3
+"""Embed only redistributable service resources for the supported DW4 build."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+
+
+REQUIRED_RESOURCES = (
+    "GC/dsp_coef.bin",
+    "GC/dsp_rom.bin",
+    "GC/font_japanese.bin",
+    "GC/font_western.bin",
+    "Resources/OSD_Font.ttf",
+    "GameSettings/GDJEB2.ini",
+    "codehandler.bin",
+)
+MAX_RESOURCE_BYTES = 4 * 1024 * 1024
+MAX_TOTAL_BYTES = 8 * 1024 * 1024
+
+
+def collect_resources(sys_directory: Path, game_settings_override: Path | None = None):
+    root = sys_directory.resolve(strict=True)
+    names = set(REQUIRED_RESOURCES)
+    for name in ("G.ini", "GDJ.ini"):
+        if (root / "GameSettings" / name).is_file():
+            names.add(f"GameSettings/{name}")
+    for path in (root / "GameSettings").glob("GDJEB2r*.ini"):
+        if re.fullmatch(r"GDJEB2r[0-9]+\.ini", path.name):
+            names.add(f"GameSettings/{path.name}")
+
+    override = None
+    if game_settings_override is not None:
+        override = game_settings_override.resolve(strict=True)
+        if override.name != "GDJEB2.ini":
+            raise ValueError("The supported game settings override must be named GDJEB2.ini")
+
+    resources = []
+    total = 0
+    for name in sorted(names):
+        source = override if name == "GameSettings/GDJEB2.ini" and override else root / name
+        source = source.resolve(strict=True)
+        if source != override:
+            try:
+                source.relative_to(root)
+            except ValueError:
+                raise ValueError(f"System resource escapes the source tree: {name}") from None
+        size = source.stat().st_size
+        if not 0 < size <= MAX_RESOURCE_BYTES:
+            raise ValueError(f"System resource has an invalid size: {name} ({size})")
+        if name == "GC/dsp_coef.bin" and size != 4096:
+            raise ValueError("DSP coefficients must contain exactly 4096 bytes")
+        if name == "GC/dsp_rom.bin" and size != 8192:
+            raise ValueError("DSP ROM must contain exactly 8192 bytes")
+        total += size
+        if total > MAX_TOTAL_BYTES:
+            raise ValueError("Embedded system resources exceed the total byte bound")
+        with source.open("rb") as stream:
+            contents = stream.read(size + 1)
+        if len(contents) != size:
+            raise ValueError(f"System resource changed while being read: {name}")
+        resources.append((name, contents))
+    return resources
+
+
+def generate(sys_directory: Path, output: Path, manifest: Path,
+             game_settings_override: Path | None = None):
+    resources = collect_resources(sys_directory, game_settings_override)
+    lines = ["// Generated by embed_system_resources.py. Do not edit.",
+             "// Contains redistributable service resources only; no original game assets."]
+    records = []
+    for index, (name, contents) in enumerate(resources):
+        digest = hashlib.sha256(contents).hexdigest()
+        lines.append(f"// {name}: {len(contents)} bytes, SHA-256 {digest}")
+        lines.append(f"alignas(16) static constexpr u8 system_resource_{index}[] = {{")
+        for offset in range(0, len(contents), 24):
+            lines.append("  " + ", ".join(f"0x{byte:02x}" for byte in contents[offset:offset + 24]) + ",")
+        lines.append("};")
+        records.append({"path": name, "bytes": len(contents), "sha256": digest})
+    lines.append("static constexpr SystemResource system_resources[] = {")
+    for index, (name, _) in enumerate(resources):
+        lines.append(f'  {{"{name}", system_resource_{index}}},')
+    lines.append("};")
+    output.parent.mkdir(parents=True, exist_ok=True)
+    manifest.parent.mkdir(parents=True, exist_ok=True)
+    with output.open("w", encoding="utf-8", newline="\n") as stream:
+        stream.write("\n".join(lines) + "\n")
+    with manifest.open("w", encoding="utf-8", newline="\n") as stream:
+        stream.write(json.dumps({"schema": 1, "game_id": "GDJEB2", "resources": records},
+                                indent=2) + "\n")
+    return records
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--sys-directory", required=True, type=Path)
+    parser.add_argument("--output", required=True, type=Path)
+    parser.add_argument("--manifest", required=True, type=Path)
+    parser.add_argument("--game-settings-override", type=Path)
+    args = parser.parse_args()
+    try:
+        records = generate(args.sys_directory, args.output, args.manifest, args.game_settings_override)
+    except (OSError, ValueError) as error:
+        parser.error(str(error))
+    print(f"Embedded {len(records)} system resources ({sum(item['bytes'] for item in records)} bytes)")
+
+
+if __name__ == "__main__":
+    main()
