+++ b/tools/test_embed_system_resources.py
@@ -0,0 +1,109 @@
+#!/usr/bin/env python3
+"""Bounded resource-generation and byte-identity checks; never builds or launches a game."""
+
+import hashlib
+import json
+from pathlib import Path
+import re
+import tempfile
+import unittest
+
+import embed_system_resources as embed
+
+
+def decode_generated(path):
+    text = path.read_text(encoding="utf-8")
+    arrays = {}
+    for match in re.finditer(r"system_resource_(\d+)\[\] = \{(.*?)\};", text, re.S):
+        arrays[match[1]] = bytes(int(value, 16) for value in re.findall(r"0x([0-9a-f]{2})", match[2]))
+    return {name: arrays[index] for name, index in
+            re.findall(r'\{"([^"]+)", system_resource_(\d+)\}', text)}
+
+
+class EmbeddingTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name) / "Sys"
+        for index, name in enumerate(embed.REQUIRED_RESOURCES):
+            size = 4096 if name.endswith("dsp_coef.bin") else 8192 if name.endswith("dsp_rom.bin") else 37
+            path = self.root / name
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_bytes(bytes((index + offset) % 256 for offset in range(size)))
+        self.output = Path(self.temporary.name) / "out" / "resources.inc"
+        self.manifest = self.output.with_suffix(".json")
+
+    def test_exact_bytes_and_only_allowlisted_files(self):
+        (self.root / "main.dol").write_bytes(b"must not be embedded")
+        (self.root / "GameSettings" / "OTHER.ini").write_text("must not be embedded")
+        embed.generate(self.root, self.output, self.manifest)
+        decoded = decode_generated(self.output)
+        self.assertEqual(set(decoded), set(embed.REQUIRED_RESOURCES))
+        for name, data in decoded.items():
+            self.assertEqual(data, (self.root / name).read_bytes())
+        for record in json.loads(self.manifest.read_text())["resources"]:
+            self.assertEqual(record["bytes"], len(decoded[record["path"]]))
+            self.assertEqual(record["sha256"], hashlib.sha256(decoded[record["path"]]).hexdigest())
+
+    def test_prefix_revision_and_override_selection(self):
+        for name in ("G.ini", "GDJ.ini", "GDJEB2r0.ini", "GDJEB2r12.ini", "GDJEB2random.ini"):
+            (self.root / "GameSettings" / name).write_text(name)
+        override = Path(self.temporary.name) / "GDJEB2.ini"
+        override.write_text("[Core]\nCPUThread = False\n")
+        result = dict(embed.collect_resources(self.root, override))
+        self.assertEqual(result["GameSettings/GDJEB2.ini"], override.read_bytes())
+        self.assertIn("GameSettings/GDJ.ini", result)
+        self.assertIn("GameSettings/G.ini", result)
+        self.assertIn("GameSettings/GDJEB2r12.ini", result)
+        self.assertNotIn("GameSettings/GDJEB2random.ini", result)
+
+    def test_wrong_override_name_rejected(self):
+        override = Path(self.temporary.name) / "other.ini"
+        override.write_text("[Core]")
+        with self.assertRaisesRegex(ValueError, "GDJEB2.ini"):
+            embed.collect_resources(self.root, override)
+
+    def test_missing_required_resource_rejected(self):
+        (self.root / "GC/dsp_rom.bin").unlink()
+        with self.assertRaises(FileNotFoundError):
+            embed.collect_resources(self.root)
+
+    def test_wrong_dsp_size_rejected(self):
+        (self.root / "GC/dsp_coef.bin").write_bytes(b"invalid")
+        with self.assertRaisesRegex(ValueError, "4096"):
+            embed.collect_resources(self.root)
+
+    def test_empty_or_oversized_resource_rejected(self):
+        font = self.root / "Resources/OSD_Font.ttf"
+        font.write_bytes(b"")
+        with self.assertRaisesRegex(ValueError, "invalid size"):
+            embed.collect_resources(self.root)
+        with font.open("wb") as stream:
+            stream.truncate(embed.MAX_RESOURCE_BYTES + 1)
+        with self.assertRaisesRegex(ValueError, "invalid size"):
+            embed.collect_resources(self.root)
+
+    def test_output_is_deterministic(self):
+        embed.generate(self.root, self.output, self.manifest)
+        first = (self.output.read_bytes(), self.manifest.read_bytes())
+        embed.generate(self.root, self.output, self.manifest)
+        self.assertEqual(first, (self.output.read_bytes(), self.manifest.read_bytes()))
+
+
+class SuppliedServiceResourceTests(unittest.TestCase):
+    def test_generated_payloads_match_actual_service_files(self):
+        root = Path(__file__).resolve().parents[1] / "vendor/dolphin/Data/Sys"
+        with tempfile.TemporaryDirectory() as directory:
+            output = Path(directory) / "resources.inc"
+            manifest = Path(directory) / "resources.json"
+            records = embed.generate(root, output, manifest)
+            decoded = decode_generated(output)
+            self.assertGreater(len(records), 0)
+            for record in records:
+                original = (root / record["path"]).read_bytes()
+                self.assertEqual(decoded[record["path"]], original)
+                self.assertEqual(hashlib.sha256(original).hexdigest(), record["sha256"])
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
