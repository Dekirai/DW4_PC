+    MENU_KEY(KeypadMultiply, KeypadMultiply); MENU_KEY(KeypadSubtract, KeypadSubtract);
+    MENU_KEY(KeypadAdd, KeypadAdd); MENU_KEY(KeypadEnter, KeypadEnter);
