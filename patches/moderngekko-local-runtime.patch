+    "vendor/dolphin/GXRuntime/include/core/types.h",
+    "vendor/dolphin/GXRuntime/include/cpu/cpu.h",
+    "vendor/dolphin/module-template/CMakeLists.txt",
+    "vendor/dolphin/module-template/module_export.c",
+    "vendor/dolphin/module-template/module.exports",
+    "vendor/dolphin/module-template/gen_module_tables.py",
+    "vendor/dolphin/Source/Core/Core/PowerPC/StaticRecomp/StaticRecompABI.h",
+    "include/moderngekko/cpu_state.h",
+    "include/moderngekko/module_abi.h"};
+
+struct ModuleSourceIdentity
+{
+  std::string sha256;
+  std::vector<std::pair<std::string, std::string>> files;
+
+  std::string Manifest() const
+  {
+    std::string text = "module_sources_version=1\nmodule_sources_sha256=" + sha256 +
+                       "\nmodule_sources_count=" + std::to_string(files.size()) + "\n";
+    for (const auto& [path, hash] : files)
+      text += "module_source=" + hash + " " + path + "\n";
+    return text;
+  }
+};
+
+namespace module_source_detail
+{
+inline std::string PathText(const std::filesystem::path& path)
+{
+  const auto utf8 = path.generic_u8string();
+  return std::string(utf8.begin(), utf8.end());
+}
+
+inline bool IgnoredDirectory(const std::filesystem::path& path)
+{
+  const auto name = PathText(path.filename());
+  return name == "build" || name == "dist" || name == "generated" ||
+         name == "CMakeFiles" || name == ".git" || name == "__pycache__" ||
+         name.starts_with("cmake-build-");
+}
+
+inline bool IsInput(const std::filesystem::path& path)
+{
+  if (path.filename() == "CMakeLists.txt")
+    return true;
+  const auto extension = PathText(path.extension());
+  constexpr std::array extensions = {".c", ".h", ".cc", ".hh", ".cpp", ".hpp",
+      ".cxx", ".hxx", ".inc", ".inl", ".s", ".S", ".asm", ".cmake", ".py",
+      ".exports", ".def", ".map", ".in"};
+  return std::find(extensions.begin(), extensions.end(), extension) != extensions.end();
+}
+
+inline void RequireOrdinaryPath(const std::filesystem::path& root,
+                               const std::filesystem::path& relative, bool directory)
+{
+  namespace fs = std::filesystem;
+  fs::path current = root;
+  if (!fs::is_directory(fs::symlink_status(current)))
+    throw std::runtime_error("Module source root is missing or is not an ordinary directory: " +
+                             PathText(root));
+  for (const auto& component : relative)
+  {
+    current /= component;
+    const auto status = fs::symlink_status(current);
+    if (fs::is_symlink(status))
+      throw std::runtime_error("Module source symlinks are unsupported: " + PathText(current));
+    if (current != root / relative && !fs::is_directory(status))
+      throw std::runtime_error("Module source directory is missing: " + PathText(current));
+  }
+  const auto status = fs::symlink_status(current);
+  if (directory ? !fs::is_directory(status) : !fs::is_regular_file(status))
+    throw std::runtime_error("Required module source is missing or has the wrong file type: " +
+                             PathText(current));
+}
+
+inline std::string FileHash(const std::filesystem::path& path)
+{
+  // Source files should be small; bound allocation and reject short or growing reads.
+  std::ifstream input(path, std::ios::binary | std::ios::ate);
+  const auto size = input.tellg();
+  if (!input || size < 0 || size > 64 * 1024 * 1024)
+    throw std::runtime_error("Could not read bounded module source: " + PathText(path));
+  std::string bytes(static_cast<std::size_t>(size), '\0');
+  input.seekg(0);
+  if ((!bytes.empty() && !input.read(bytes.data(), size)) ||
+      input.peek() != std::char_traits<char>::eof() || input.bad())
+    throw std::runtime_error("Could not completely read module source: " + PathText(path));
+  return Sha256(std::string_view(bytes));
+}
+}  // namespace module_source_detail
+
+inline ModuleSourceIdentity CollectModuleSourceIdentity(const std::filesystem::path& source_root)
+{
+  namespace fs = std::filesystem;
+  using namespace module_source_detail;
+  const fs::path root = source_root.lexically_normal();
+  std::vector<fs::path> paths;
+  for (const auto* required : REQUIRED_MODULE_SOURCE_FILES)
+  {
+    RequireOrdinaryPath(root, required, false);
+    paths.emplace_back(required);
+  }
+  for (const auto* tree : {"vendor/dolphin/GXRuntime/src", "vendor/dolphin/GXRuntime/include",
+                           "vendor/dolphin/module-template"})
+  {
+    RequireOrdinaryPath(root, tree, true);
+    for (fs::recursive_directory_iterator entry(root / tree), end; entry != end; ++entry)
+    {
+      const auto status = entry->symlink_status();
+      if (fs::is_symlink(status))
+        throw std::runtime_error("Module source symlinks are unsupported: " + PathText(entry->path()));
+      if (fs::is_directory(status))
+      {
+        if (IgnoredDirectory(entry->path()))
+          entry.disable_recursion_pending();
+        continue;
+      }
+      if (!IsInput(entry->path()))
+        continue;
+      if (!fs::is_regular_file(status))
+        throw std::runtime_error("Module source is not an ordinary file: " + PathText(entry->path()));
+      paths.push_back(entry->path().lexically_relative(root));
+    }
+  }
+
+  ModuleSourceIdentity result;
+  for (const auto& path : paths)
+  {
+    const auto relative = PathText(path);
+    if (relative.find_first_of("\r\n\t") != std::string::npos)
+      throw std::runtime_error("Unsupported control character in module source path");
+    result.files.emplace_back(relative, std::string{});
+  }
+  std::sort(result.files.begin(), result.files.end());
+  result.files.erase(std::unique(result.files.begin(), result.files.end()), result.files.end());
+  std::string identity = "moderngekko-module-sources-v1\n";
+  for (auto& [path, hash] : result.files)
+  {
+    const fs::path relative(std::u8string(path.begin(), path.end()));
+    RequireOrdinaryPath(root, relative, false);
+    hash = FileHash(root / relative);
+    // Length-prefix UTF-8 paths so every path/content pair has an unambiguous identity.
+    identity += std::to_string(path.size()) + ":" + path + ":" + hash + "\n";
+  }
+  result.sha256 = Sha256(std::string_view(identity));
+  return result;
+}
+
+inline bool ModuleSourceRecordMatches(const std::filesystem::path& path,
+                                     std::string_view expected, bool allow_prefix = false)
+{
+  if (!std::filesystem::is_regular_file(std::filesystem::symlink_status(path)))
+    return false;
+  std::ifstream input(path, std::ios::binary | std::ios::ate);
+  const auto size = input.tellg();
+  if (!input || size < 0 || size > 4 * 1024 * 1024)
+    return false;
+  std::string text(static_cast<std::size_t>(size), '\0');
+  input.seekg(0);
+  if ((!text.empty() && !input.read(text.data(), size)) ||
+      input.peek() != std::char_traits<char>::eof() || input.bad())
+    return false;
+  return allow_prefix ? text.ends_with(expected) : text == expected;
+}
+}  // namespace moderngekko::port
