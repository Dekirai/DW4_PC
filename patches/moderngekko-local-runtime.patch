+
+std::string Quote(std::string_view text) {
+  std::string result = "\"";
+  constexpr char hex[] = "0123456789abcdef";
+  for (const unsigned char value : text) {
+    if (value == '"' || value == '\\') {
+      result += '\\';
+      result += static_cast<char>(value);
+    } else if (value < 0x20) {
+      result += "\\u00";
+      result += hex[value >> 4];
+      result += hex[value & 15];
+    } else {
+      result += static_cast<char>(value);
+    }
+  }
+  return result + '"';
+}
+
+const char* CaptureState(VideoCommon::ComposedCaptureState state) {
+  using VideoCommon::ComposedCaptureState;
+  switch (state) {
+  case ComposedCaptureState::Idle: return "idle";
+  case ComposedCaptureState::Pending: return "pending";
+  case ComposedCaptureState::Capturing: return "capturing";
+  case ComposedCaptureState::Succeeded: return "succeeded";
+  case ComposedCaptureState::Failed: return "failed";
+  }
+  return "unknown";
+}
+}
+
+struct InGameMenuSmoke::Impl {
+  struct FrameProgress {
+    std::atomic<std::uint64_t> unique_presents{0};
+    std::atomic<std::uint64_t> last_guest_frame{0};
+  };
+  enum class Phase {
+    WaitReady, Open, Repeat, Close, Reopen, Escape, OpenAgain,
+    BackgroundMove, BackgroundDown, BackgroundUp, SpaceDown, SpaceUp,
+    PauseMove, PauseDown, WaitPaused, PauseSettle, PausedRedraw, Capture,
+    ResumeMove, ResumeDown, WaitResumed, FinalClose, Finished
+  };
+  struct Event {
+    std::string phase;
+    double elapsed = 0;
+    std::uint64_t draws = 0, game_frames = 0, inputs = 0, actions = 0;
+  };
+  using StateInventory = std::map<std::string, std::pair<std::uintmax_t, fs::file_time_type>>;
+
+  Platform& platform;
+  const std::shared_ptr<InGameMenu> menu;
+  const std::shared_ptr<VideoCommon::ComposedFrameCapture> capture;
+  const fs::path output_directory;
+  const fs::path capture_path;
+  const Clock::time_point started = Clock::now();
+  const std::shared_ptr<FrameProgress> frames = std::make_shared<FrameProgress>();
+  Common::EventHook frame_hook;
+  Phase phase = Phase::WaitReady;
+  Clock::time_point phase_started = started;
+  InGameMenuSnapshot marker;
+  std::uint64_t marker_frames = 0, paused_frames = 0, paused_draws = 0, capture_id = 0;
+  std::uint64_t window_checks = 0, audio_generation = 0;
+  bool actual_null_audio_verified = false;
+  bool title_update_verified = false;
+  std::vector<Event> events;
+  std::string error;
+  StateInventory initial_states;
+  fs::path states_directory;
+  float initial_speed = 0;
+  bool inventory_ready = false, finished = false, passed = false;
+  bool f1_open = false, repeat_ignored = false, f1_closed = false, escape_closed = false;
+  bool space_suppressed = false, paused_redraw = false, resumed = false, states_unchanged = false;
+#ifdef _WIN32
+  HWND window = nullptr;
+  DWORD host_thread = GetCurrentThreadId();
+  int mouse_x = 0, mouse_y = 0;
+  bool mouse_down = false, f1_down = false, space_down = false;
+#endif
+
+  Impl(Platform& platform_, std::shared_ptr<InGameMenu> menu_,
+       std::shared_ptr<VideoCommon::ComposedFrameCapture> capture_, fs::path output_)
+      : platform(platform_), menu(std::move(menu_)), capture(std::move(capture_)),
+        output_directory(fs::absolute(std::move(output_)).lexically_normal()),
+        capture_path(output_directory / "composed-menu.png") {
+    if (!menu || !capture)
+      throw std::invalid_argument("The hidden UI diagnostic requires a menu and capture channel.");
+    fs::create_directories(output_directory);
+    if (fs::exists(capture_path) || fs::exists(output_directory / "ingame-menu-smoke.json"))
+      throw std::invalid_argument("The hidden UI diagnostic requires a fresh output directory.");
+    const std::weak_ptr<FrameProgress> weak = frames;
+    frame_hook = GetVideoEvents().after_present_event.Register([weak](const PresentInfo& info) {
+      if (info.reason == PresentInfo::PresentReason::VideoInterfaceDuplicate)
+        return;
+      if (const auto owner = weak.lock()) {
+        owner->last_guest_frame.store(info.frame_count, std::memory_order_relaxed);
+        owner->unique_presents.fetch_add(1, std::memory_order_relaxed);
+      }
+    });
+    Note("wait_ready");
+  }
+
+  double Elapsed() const { return std::chrono::duration<double>(Clock::now() - started).count(); }
+  double PhaseElapsed() const {
+    return std::chrono::duration<double>(Clock::now() - phase_started).count();
+  }
+  std::uint64_t GameFrames() const { return frames->unique_presents.load(std::memory_order_relaxed); }
+
+  void Note(const char* name) {
+    const auto current = menu->Snapshot();
+    events.push_back({name, Elapsed(), current.draw_frames, GameFrames(), current.input_events,
+                      current.actions_completed});
+    std::fprintf(stderr, "[ui-smoke] phase=%s elapsed=%.3f draws=%llu game_frames=%llu\n", name,
+                 events.back().elapsed, static_cast<unsigned long long>(current.draw_frames),
+                 static_cast<unsigned long long>(GameFrames()));
+  }
+
+  void Next(Phase next, const char* name) {
+    phase = next;
+    phase_started = Clock::now();
+    marker = menu->Snapshot();
+    marker_frames = GameFrames();
+    Note(name);
+  }
+
+  StateInventory Inventory() const {
+    StateInventory result;
+    if (!fs::exists(states_directory))
+      return result;
+    for (const auto& entry : fs::directory_iterator(states_directory)) {
+      if (!entry.is_regular_file())
+        continue;
+      if (result.size() == 4096)
+        throw std::runtime_error("The diagnostic save-state directory is unexpectedly large.");
+      result.emplace(PathToString(entry.path().filename()),
+                     std::make_pair(entry.file_size(), entry.last_write_time()));
+    }
+    return result;
+  }
+
+  void WriteEvidence() const {
+    const auto snapshot = menu->Snapshot();
+    const auto image = capture->Snapshot();
+    const auto audio = AudioCommon::GetAudioTelemetrySnapshot();
+    const fs::path result = output_directory / "ingame-menu-smoke.json";
+    const fs::path temporary = output_directory / "ingame-menu-smoke.json.tmp";
+    std::ostringstream json;
+    json << std::boolalpha << "{\n  \"schema\":1,\n  \"finished\":" << finished
+         << ",\n  \"passed\":" << passed << ",\n  \"error\":" << Quote(error)
+         << ",\n  \"deadline_seconds\":60,\n  \"elapsed_seconds\":" << Elapsed()
+         << ",\n  \"window_checks\":" << window_checks
+         << ",\n  \"title_updates_verified\":" << title_update_verified
+         << ",\n  \"f1_opened\":" << f1_open << ",\n  \"f1_repeat_ignored\":" << repeat_ignored
+         << ",\n  \"f1_closed\":" << f1_closed << ",\n  \"escape_closed_without_shutdown\":" << escape_closed
+         << ",\n  \"space_fast_forward_suppressed\":" << space_suppressed
+         << ",\n  \"paused_redraw_without_game_frames\":" << paused_redraw
+         << ",\n  \"resumed_game_frames\":" << resumed
+         << ",\n  \"save_states_unchanged\":" << states_unchanged
+         << ",\n  \"initial_save_state_files\":" << initial_states.size()
+         << ",\n  \"save_state_directory\":" << Quote(PathToString(states_directory))
+         << ",\n  \"input_overflows\":" << snapshot.input_overflows
+         << ",\n  \"menu_open_at_finish\":" << snapshot.open
+         << ",\n  \"menu_draws\":" << snapshot.draw_frames
+         << ",\n  \"game_unique_presents\":" << GameFrames()
+         << ",\n  \"last_guest_frame\":" << frames->last_guest_frame.load()
+         << ",\n  \"paused_game_frame_baseline\":" << paused_frames
+         << ",\n  \"audio\":{\"verified_null\":" << actual_null_audio_verified
+         << ",\"available\":" << audio.available << ",\"stream_alive\":" << audio.stream_alive
+         << ",\"generation\":" << audio.generation
+         << ",\"backend\":" << Quote(audio.device.backend == AudioCommon::AudioTelemetryBackend::Null ? "Null" :
+                                              audio.device.backend == AudioCommon::AudioTelemetryBackend::Cubeb ? "Cubeb" : "Unknown")
+         << ",\"output_sample_rate\":" << audio.mixer.output_sample_rate
+         << ",\"device_started\":" << (audio.device.start_succeeded || audio.device.state_started != 0)
+         << ",\"device_callbacks\":" << audio.device.callbacks << "}"
+         << ",\n  \"capture\":{\"id\":" << image.id
+         << ",\"state\":" << Quote(CaptureState(image.state))
+         << ",\"path\":" << Quote(image.path) << ",\"width\":" << image.width
+         << ",\"height\":" << image.height << ",\"error\":" << Quote(image.error)
+         << ",\"supported\":" << image.supported << "},\n  \"events\":[";
+    for (std::size_t i = 0; i < events.size(); ++i) {
+      if (i) json << ',';
+      const auto& event = events[i];
+      json << "\n    {\"phase\":" << Quote(event.phase) << ",\"elapsed_seconds\":" << event.elapsed
+           << ",\"draws\":" << event.draws << ",\"game_frames\":" << event.game_frames
+           << ",\"inputs\":" << event.inputs << ",\"actions\":" << event.actions << '}';
+    }
+    json << "\n  ]\n}\n";
+    std::ofstream output(temporary, std::ios::binary | std::ios::trunc);
+    output << json.str();
+    output.close();
+    if (!output)
+      throw std::runtime_error("Cannot write the hidden UI diagnostic evidence.");
+#ifdef _WIN32
+    if (!MoveFileExW(temporary.c_str(), result.c_str(), MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH))
+      throw std::runtime_error("Cannot publish the hidden UI diagnostic evidence.");
+#else
+    fs::rename(temporary, result);
+#endif
+  }
+
+  void Finish(bool success, std::string reason = {}) {
+    if (finished)
+      return;
+    error = std::move(reason);
+    passed = success;
+    finished = true;
+    phase = Phase::Finished;
+    Note(success ? "passed" : "failed");
+    try {
+      WriteEvidence();
+    } catch (const std::exception& failure) {
+      passed = false;
+      error += (error.empty() ? "" : "; ") + std::string(failure.what());
+    }
+    if (!passed)
+      std::fprintf(stderr, "[ui-smoke] failed: %s\n", error.c_str());
+    // Stop is the immediate host-loop request. RequestShutdown may only deliver a guest power hook.
+    platform.Stop();
+  }
+
+#ifdef _WIN32
+  void CheckWindow() {
+    if (GetCurrentThreadId() != host_thread)
+      throw std::runtime_error("The UI diagnostic was ticked off its host/window owner thread.");
+    const auto wsi = platform.GetWindowSystemInfo();
+    if (wsi.type != WindowSystemType::Windows)
+      throw std::runtime_error("The UI diagnostic requires a Windows surface, not a headless backend.");
+    const auto current = static_cast<HWND>(wsi.render_surface);
+    if (!current) {
+      if (window)
+        throw std::runtime_error("The diagnostic HWND disappeared before completion.");
+      return;
+    }
+    if (window && current != window)
+      throw std::runtime_error("The diagnostic HWND identity changed during the test.");
+    window = current;
+    DWORD process = 0;
+    const auto thread = GetWindowThreadProcessId(window, &process);
+    if (!IsWindow(window) || thread != host_thread || process != GetCurrentProcessId())
+      throw std::runtime_error("The diagnostic HWND is not owned by this process and host thread.");
+    ++window_checks;
+    const auto foreground = GetForegroundWindow();
+    if (IsWindowVisible(window) || (GetWindowLongPtrW(window, GWL_STYLE) & WS_VISIBLE) ||
+        foreground == window || (foreground && GetAncestor(foreground, GA_ROOTOWNER) == window))
+      throw std::runtime_error("The diagnostic game window became visible or foreground.");
+    if (GetMenu(window) != nullptr)
+      throw std::runtime_error("The obsolete native menu is still attached to the game window.");
+  }
+
+  void Post(UINT message, WPARAM value, LPARAM flags) {
+    if (!window || !PostMessageW(window, message, value, flags))
+      throw std::runtime_error("Posting a diagnostic input to its own HWND failed.");
+  }
+
+  void Key(UINT key, bool down, bool repeat = false) {
+    const auto scan = static_cast<ULONG_PTR>(MapVirtualKeyW(key, MAPVK_VK_TO_VSC) & 0xff);
+    ULONG_PTR flags = 1 | (scan << 16);
+    if (repeat || !down) flags |= ULONG_PTR{1} << 30;
+    if (!down) flags |= ULONG_PTR{1} << 31;
+    Post(down ? WM_KEYDOWN : WM_KEYUP, key, static_cast<LPARAM>(flags));
+    if (key == VK_F1) f1_down = down;
+    if (key == VK_SPACE) space_down = down;
+  }
+
+  void Tap(UINT key) { Key(key, true); Key(key, false); }
+
+  LPARAM MousePosition() const {
+    return static_cast<LPARAM>(static_cast<unsigned>(mouse_x) |
+                               (static_cast<unsigned>(mouse_y) << 16));
+  }
+
+  void Move(int x, int y) {
+    RECT client{};
+    if (!GetClientRect(window, &client) || x < 0 || y < 0 || x >= client.right ||
+        y >= client.bottom || x > 32767 || y > 32767)
+      throw std::runtime_error("The requested menu input is outside the diagnostic client area.");
+    mouse_x = x; mouse_y = y;
+    Post(WM_MOUSEMOVE, mouse_down ? MK_LBUTTON : 0, MousePosition());
+  }
+
+  void Mouse(bool down) {
+    Post(down ? WM_LBUTTONDOWN : WM_LBUTTONUP, down ? MK_LBUTTON : 0, MousePosition());
+    mouse_down = down;
+  }
+
+  bool MoveToButton(const InGameMenuSnapshot& snapshot, const char* id) {
+    const auto found = std::find_if(snapshot.buttons.begin(), snapshot.buttons.end(),
+                                  [id](const auto& button) { return button.id == id && button.enabled; });
+    if (found == snapshot.buttons.end())
+      return false;
+    const float x = found->x + found->width * 0.5f;
+    const float y = found->y + found->height * 0.5f;
+    if (!std::isfinite(x) || !std::isfinite(y) || x < 0 || y < 0 || x > 32767 || y > 32767 ||
+        found->width <= 0 || found->height <= 0)
+      throw std::runtime_error("The live menu button has invalid bounds.");
+    Move(static_cast<int>(x), static_cast<int>(y));
+    return true;
+  }
+
+  void VerifyPNG(const VideoCommon::ComposedCaptureResult& image) const {
+    if (image.path != PathToString(capture_path) || image.width == 0 || image.height == 0)
+      throw std::runtime_error("The composed capture result has a different path or invalid dimensions.");
+    std::ifstream file(capture_path, std::ios::binary);
+    std::array<unsigned char, 24> bytes{};
+    file.read(reinterpret_cast<char*>(bytes.data()), bytes.size());
+    constexpr std::array<unsigned char, 8> signature{137, 80, 78, 71, 13, 10, 26, 10};
+    if (!file || !std::equal(signature.begin(), signature.end(), bytes.begin()) ||
+        bytes[12] != 'I' || bytes[13] != 'H' || bytes[14] != 'D' || bytes[15] != 'R')
+      throw std::runtime_error("The composed capture did not publish a valid PNG header.");
+    const auto be = [&](std::size_t offset) {
+      return (static_cast<std::uint32_t>(bytes[offset]) << 24) |
+             (static_cast<std::uint32_t>(bytes[offset + 1]) << 16) |
+             (static_cast<std::uint32_t>(bytes[offset + 2]) << 8) | bytes[offset + 3];
+    };
+    if (be(8) != 13 || be(16) != image.width || be(20) != image.height)
+      throw std::runtime_error("The composed PNG dimensions differ from the renderer result.");
+  }
+
+  void CheckNullAudio() {
+    const auto audio = AudioCommon::GetAudioTelemetrySnapshot();
+    if (!audio.available || !audio.stream_alive || audio.generation == 0 ||
+        audio.device.backend != AudioCommon::AudioTelemetryBackend::Null ||
+        audio.mixer.output_sample_rate != 0 || audio.device.start_succeeded ||
+        audio.device.state_started != 0 || audio.device.callbacks != 0 ||
+        (audio_generation != 0 && audio.generation != audio_generation))
+      throw std::runtime_error("The hidden UI diagnostic did not observe a live unchanged NullSound backend with no device start/callbacks.");
+    audio_generation = audio.generation;
+    actual_null_audio_verified = true;
+  }
+
+  void TickWindows() {
+    CheckWindow();
+    if (!platform.IsRunning())
+      throw std::runtime_error("The platform stopped before the diagnostic completed.");
+    if (!menu->Snapshot().alive)
+      throw std::runtime_error("The in-game menu session retired before the diagnostic completed.");
+    if (Elapsed() >= 60)
+      throw std::runtime_error("The hidden UI diagnostic exceeded its 60-second internal deadline.");
+    if (inventory_ready)
+      CheckNullAudio();
+    const auto current = menu->Snapshot();
+    if (current.input_overflows != 0)
+      throw std::runtime_error("The bounded menu input queue overflowed during the diagnostic.");
+    const auto state = Core::GetState(Core::System::GetInstance());
+    const bool drew = current.draw_frames >= marker.draw_frames + 2;
+    switch (phase) {
+    case Phase::WaitReady:
+      // Initial XFBs can be black. Leave startup time for an original logo or
+      // movie image, so visual review can inspect the game and menu together.
+      if (!window || state != Core::State::Running || GameFrames() < 100 || Elapsed() < 35)
+        return;
+      {
+        std::array<wchar_t, 512> title{};
+        if (GetWindowTextW(window, title.data(), static_cast<int>(title.size())) <= 0 ||
+            std::wstring_view(title.data()).find(L" FPS") == std::wstring_view::npos)
+          throw std::runtime_error("The ordinary host-thread FPS title update was not observed.");
+        title_update_verified = true;
+      }
+      if (!capture->Snapshot().supported)
+        throw std::runtime_error("Composed surface capture unavailable: " + capture->Snapshot().support_error);
+      states_directory = StringToPath(File::GetUserPath(D_STATESAVES_IDX));
+      if (states_directory.empty())
+        throw std::runtime_error("The diagnostic save-state directory is unavailable.");
+      initial_states = Inventory();
+      CheckNullAudio();
+      inventory_ready = true;
+      initial_speed = Config::Get(Config::MAIN_EMULATION_SPEED);
+      Key(VK_F1, true);
+      Next(Phase::Open, "f1_open");
+      break;
+    case Phase::Open:
+      if (!current.open || !current.capture || !drew) return;
+      f1_open = true;
+      Key(VK_F1, true, true);
+      Next(Phase::Repeat, "f1_repeat");
+      break;
+    case Phase::Repeat:
+      if (current.input_events <= marker.input_events) return;
+      if (!current.open || !current.capture)
+        throw std::runtime_error("An auto-repeat F1 key-down closed the menu.");
+      if (!drew) return;
+      repeat_ignored = true;
+      Key(VK_F1, false);
+      Tap(VK_F1);
+      Next(Phase::Close, "f1_close");
+      break;
+    case Phase::Close:
+      if (current.open || current.capture || current.input_events < marker.input_events + 3 ||
+          PhaseElapsed() < 0.15) return;
+      f1_closed = true;
+      Tap(VK_F1);
+      Next(Phase::Reopen, "f1_reopen");
+      break;
+    case Phase::Reopen:
+      if (!current.open || !drew) return;
+      Tap(VK_ESCAPE);
+      Next(Phase::Escape, "escape_close");
+      break;
+    case Phase::Escape:
+      if (current.open || current.capture || current.input_events < marker.input_events + 2 ||
+          PhaseElapsed() < 0.15) return;
+      escape_closed = true;
+      Tap(VK_F1);
+      Next(Phase::OpenAgain, "open_for_controls");
+      break;
+    case Phase::OpenAgain:
+      if (!current.open || !drew) return;
+      // Click outside the centered ImGui window first. This clears its keyboard activation target,
+      // so Space tests native fast-forward capture without also activating an ImGui Pause button.
+      Move(2, 2);
+      Next(Phase::BackgroundMove, "background_move");
+      break;
+    case Phase::BackgroundMove:
+      if (!drew) return;
+      Mouse(true);
+      Next(Phase::BackgroundDown, "background_down");
+      break;
+    case Phase::BackgroundDown:
+      if (!drew) return;
+      Mouse(false);
+      Next(Phase::BackgroundUp, "background_up");
+      break;
+    case Phase::BackgroundUp:
+      if (!drew) return;
+      Key(VK_SPACE, true);
+      Next(Phase::SpaceDown, "space_capture");
+      break;
+    case Phase::SpaceDown:
+      if (current.input_events <= marker.input_events) return;
+      if (Config::Get(Config::MAIN_EMULATION_SPEED) != initial_speed)
+        throw std::runtime_error("Space changed emulation speed while the menu was capturing input.");
+      if (!drew || PhaseElapsed() < 0.15) return;
+      Key(VK_SPACE, false);
+      Next(Phase::SpaceUp, "space_release");
+      break;
+    case Phase::SpaceUp:
+      if (!drew || current.input_events <= marker.input_events) return;
+      if (Config::Get(Config::MAIN_EMULATION_SPEED) != initial_speed || !current.open ||
+          state != Core::State::Running)
+        throw std::runtime_error("Space release changed the captured session state.");
+      space_suppressed = true;
+      if (!MoveToButton(current, "pause")) return;
+      Next(Phase::PauseMove, "pause_move");
+      break;
+    case Phase::PauseMove:
+      if (!drew) return;
+      Mouse(true);
+      Next(Phase::PauseDown, "pause_down");
+      break;
+    case Phase::PauseDown:
+      if (!drew) return;
+      Mouse(false);
+      Next(Phase::WaitPaused, "pause_release");
+      break;
+    case Phase::WaitPaused:
+      if (state != Core::State::Paused || !current.paused || current.last_action != "pause" ||
+          current.actions_completed <= marker.actions_completed) return;
+      Next(Phase::PauseSettle, "pause_settle");
+      break;
+    case Phase::PauseSettle:
+      if (state != Core::State::Paused)
+        throw std::runtime_error("The game resumed without a diagnostic Resume click.");
+      if (PhaseElapsed() < 0.25 || !drew) return;
+      paused_frames = GameFrames();
+      paused_draws = current.draw_frames;
+      Next(Phase::PausedRedraw, "paused_redraw");
+      break;
+    case Phase::PausedRedraw:
+      if (state != Core::State::Paused || GameFrames() != paused_frames)
+        throw std::runtime_error("Paused menu redraw advanced original game presentation frames.");
+      if (PhaseElapsed() < 0.5 || current.draw_frames < paused_draws + 3) return;
+      paused_redraw = true;
+      capture_id = capture->Request(PathToString(capture_path));
+      if (!capture_id)
+        throw std::runtime_error("The composed capture channel rejected the diagnostic request.");
+      Next(Phase::Capture, "composed_capture");
+      break;
+    case Phase::Capture: {
+      if (state != Core::State::Paused || GameFrames() != paused_frames || !current.open)
+        throw std::runtime_error("The paused menu changed state before composed capture completed.");
+      const auto result = capture->Snapshot();
+      if (result.id != capture_id)
+        throw std::runtime_error("A different capture replaced the diagnostic request.");
+      if (result.state == VideoCommon::ComposedCaptureState::Failed)
+        throw std::runtime_error("Composed capture failed: " + result.error);
+      if (result.state != VideoCommon::ComposedCaptureState::Succeeded) return;
+      VerifyPNG(result);
+      if (!MoveToButton(current, "resume")) return;
+      Next(Phase::ResumeMove, "resume_move");
+      break;
+    }
+    case Phase::ResumeMove:
+      if (!drew) return;
+      Mouse(true);
+      Next(Phase::ResumeDown, "resume_down");
+      break;
+    case Phase::ResumeDown:
+      if (!drew) return;
+      Mouse(false);
+      Next(Phase::WaitResumed, "resume_release");
+      break;
+    case Phase::WaitResumed:
+      if (state != Core::State::Running || current.paused || current.last_action != "resume" ||
+          current.actions_completed <= marker.actions_completed || GameFrames() < marker_frames + 2) return;
+      resumed = true;
+      Tap(VK_F1);
+      Next(Phase::FinalClose, "final_close");
+      break;
+    case Phase::FinalClose:
+      if (current.open || current.capture || current.input_events < marker.input_events + 2 ||
+          PhaseElapsed() < 0.25) return;
+      if (Config::Get(Config::MAIN_EMULATION_SPEED) != initial_speed)
+        throw std::runtime_error("The diagnostic changed the configured emulation speed.");
+      if (!inventory_ready || Inventory() != initial_states)
+        throw std::runtime_error("F1 or UI input changed the save-state file inventory.");
+      states_unchanged = true;
+      if (mouse_down || f1_down || space_down)
+        throw std::runtime_error("The diagnostic finished with an injected input still held.");
+      Finish(true);
+      break;
+    case Phase::Finished: break;
+    }
+  }
+#endif
+
+  void Tick() {
+    if (finished)
+      return;
+    try {
+#ifdef _WIN32
+      TickWindows();
+#else
+      throw std::runtime_error("The hidden in-game UI diagnostic is supported only on Windows.");
+#endif
+    } catch (const std::exception& failure) {
+      Finish(false, failure.what());
+    }
+  }
+};
+
+InGameMenuSmoke::InGameMenuSmoke(Platform& platform, std::shared_ptr<InGameMenu> menu,
+                               std::shared_ptr<VideoCommon::ComposedFrameCapture> capture,
+                               fs::path output_directory)
+    : m_impl(std::make_unique<Impl>(platform, std::move(menu), std::move(capture),
+                                    std::move(output_directory))) {}
+InGameMenuSmoke::~InGameMenuSmoke() = default;
+void InGameMenuSmoke::Tick() { m_impl->Tick(); }
+bool InGameMenuSmoke::Finished() const { return m_impl->finished; }
+bool InGameMenuSmoke::Passed() const { return m_impl->finished && m_impl->passed; }
+std::string InGameMenuSmoke::Error() const { return m_impl->error; }
+} // namespace moderngekko::detail
