 namespace moderngekko::frontend {
+// Disc names become host path components during import. Keep the supported
+// Windows name rules explicit before any file is exported.
+inline bool SafeImportComponent(std::string_view name) {
+  if (name.empty() || name.size() > 255 || name == "." || name == ".." ||
+      name.back() == '.' || name.back() == ' ')
+    return false;
+  std::string stem;
+  for (unsigned char c : name) {
+    if (c < 32 || c >= 127 || std::string_view("<>:\"/\\|?*").find(c) != std::string_view::npos)
+      return false;
+    stem.push_back(c >= 'a' && c <= 'z' ? static_cast<char>(c - 'a' + 'A') : static_cast<char>(c));
+  }
+  stem.resize(stem.find('.') == std::string::npos ? stem.size() : stem.find('.'));
+  if (!stem.empty() && stem.back() == ' ')
+    return false;
+  return stem != "CON" && stem != "PRN" && stem != "AUX" && stem != "NUL" &&
+         stem != "CONIN$" && stem != "CONOUT$" &&
+         !(stem.size() == 4 && (stem.starts_with("COM") || stem.starts_with("LPT")) &&
+           stem[3] >= '1' && stem[3] <= '9');
+}
