+ImGuiKey ToImGuiKey(FrontendUI::Key key) {
+  using FrontendUI::Key;
+  // These ranges are contiguous in both the portable protocol and ImGui.
+  if (key >= Key::A && key <= Key::Z)
+    return static_cast<ImGuiKey>(ImGuiKey_A + static_cast<int>(key) - static_cast<int>(Key::A));
+  if (key >= Key::Num0 && key <= Key::Num9)
+    return static_cast<ImGuiKey>(ImGuiKey_0 + static_cast<int>(key) - static_cast<int>(Key::Num0));
+  if (key >= Key::F1 && key <= Key::F12)
+    return static_cast<ImGuiKey>(ImGuiKey_F1 + static_cast<int>(key) - static_cast<int>(Key::F1));
+  if (key >= Key::Keypad0 && key <= Key::Keypad9)
+    return static_cast<ImGuiKey>(ImGuiKey_Keypad0 + static_cast<int>(key) - static_cast<int>(Key::Keypad0));
+#define MENU_KEY(host, imgui) case Key::host: return ImGuiKey_##imgui
+  switch (key) {
+    MENU_KEY(Tab, Tab); MENU_KEY(Left, LeftArrow); MENU_KEY(Right, RightArrow);
+    MENU_KEY(Up, UpArrow); MENU_KEY(Down, DownArrow); MENU_KEY(PageUp, PageUp);
+    MENU_KEY(PageDown, PageDown); MENU_KEY(Home, Home); MENU_KEY(End, End);
+    MENU_KEY(Insert, Insert); MENU_KEY(Delete, Delete); MENU_KEY(Backspace, Backspace);
+    MENU_KEY(Space, Space); MENU_KEY(Enter, Enter); MENU_KEY(Escape, Escape);
+    MENU_KEY(LeftCtrl, LeftCtrl); MENU_KEY(RightCtrl, RightCtrl);
+    MENU_KEY(LeftShift, LeftShift); MENU_KEY(RightShift, RightShift);
+    MENU_KEY(LeftAlt, LeftAlt); MENU_KEY(RightAlt, RightAlt);
+    MENU_KEY(LeftSuper, LeftSuper); MENU_KEY(RightSuper, RightSuper);
+    MENU_KEY(Apostrophe, Apostrophe); MENU_KEY(Comma, Comma); MENU_KEY(Minus, Minus);
+    MENU_KEY(Period, Period); MENU_KEY(Slash, Slash); MENU_KEY(Semicolon, Semicolon);
+    MENU_KEY(Equal, Equal); MENU_KEY(LeftBracket, LeftBracket); MENU_KEY(Backslash, Backslash);
+    MENU_KEY(RightBracket, RightBracket); MENU_KEY(GraveAccent, GraveAccent);
+    MENU_KEY(CapsLock, CapsLock); MENU_KEY(ScrollLock, ScrollLock); MENU_KEY(NumLock, NumLock);
+    MENU_KEY(PrintScreen, PrintScreen); MENU_KEY(Pause, Pause);
+    MENU_KEY(KeypadDecimal, KeypadDecimal); MENU_KEY(KeypadDivide, KeypadDivide);
+    MENU_KEY(KeypadMultiply, KeypadMultiply); MENU_KEY(KeypadSubtract, KeypadSubtract);
+    MENU_KEY(KeypadAdd, KeypadAdd); MENU_KEY(KeypadEnter, KeypadEnter);
+    default: return ImGuiKey_None;
+  }
+#undef MENU_KEY
+}
