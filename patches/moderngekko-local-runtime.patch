+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "DolphinNoGUI/UIInput.h"
+
+namespace moderngekko::detail {
+
+struct InGameMenuButtonRect {
+  std::string id;
+  float x = 0, y = 0, width = 0, height = 0;
+  bool enabled = false;
+};
+
+struct InGameMenuSnapshot {
+  std::uint64_t generation = 0;
+  bool alive = false;
+  bool open = false;
+  bool capture = false;
+  bool paused = false;
+  bool netplay = false;
+  std::uint64_t input_events = 0;
+  std::uint64_t input_overflows = 0;
+  std::uint64_t draw_frames = 0;
+  std::uint64_t actions_queued = 0;
+  std::uint64_t actions_completed = 0;
+  std::string last_action;
+  std::string message;
+  std::vector<InGameMenuButtonRect> buttons;
+};
+
+class InGameMenu final {
+public:
+  struct HostActions {
+    // Called only on the host/window owner thread, before Retire().
+    std::function<void()> toggle_fullscreen;
+    std::function<bool()> is_fullscreen;
+    std::function<void()> request_shutdown;
+    std::function<void()> on_settings_changed;
+    bool allow_audio_unmute = true;
+  };
+
+  static std::shared_ptr<InGameMenu> Create(HostActions actions);
+  ~InGameMenu();
+  InGameMenu(const InGameMenu&) = delete;
+  InGameMenu& operator=(const InGameMenu&) = delete;
+
+  // Host thread. F1/Escape update modal capture synchronously, before native
+  // hotkeys run; other events enter a bounded queue. No ImGui calls occur here.
+  bool HandleInput(const FrontendUI::InputEvent& event);
+  void Tick();
+  // Call before stopping the core/destroying the platform. Queued jobs retain
+  // weak session ownership and cannot invoke platform callbacks after this.
+  void Retire();
+
+  // Video owner thread, with the existing OnScreenUI ImGui mutex already held.
+  // BeginFrame runs before NewFrame; Draw runs before Render. Neither waits
+  // for host/CPU work or acquires the ImGui mutex again.
+  void BeginFrame();
+  void Draw();
+
+  bool IsOpen() const;
+  bool BlocksGameInput() const;
+  InGameMenuSnapshot Snapshot() const;
+
+private:
+  struct Impl;
+  explicit InGameMenu(HostActions actions);
+  std::shared_ptr<Impl> m_impl;
+};
