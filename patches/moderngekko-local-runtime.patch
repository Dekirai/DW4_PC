+const char* AspectName(AspectMode mode) {
+  switch (mode) {
+    case AspectMode::Auto: return "Automatic";
+    case AspectMode::ForceStandard: return "4:3";
+    case AspectMode::ForceWide: return "16:9 (stretch)";
+    case AspectMode::Stretch: return "Fill window";
+    default: return "Custom (configured externally)";
+  }
