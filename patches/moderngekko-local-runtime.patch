+unsigned BuildJobs()
+{
+  if (const char* setting = std::getenv("MODERNGEKKO_BUILD_JOBS"))
+  {
+    const std::string_view value(setting);
+    unsigned jobs{};
+    const auto parsed = std::from_chars(value.data(), value.data() + value.size(), jobs);
+    if (parsed.ec == std::errc{} && parsed.ptr == value.data() + value.size() && jobs >= 1 && jobs <= 64)
+      return jobs;
+    throw std::runtime_error("MODERNGEKKO_BUILD_JOBS must be an integer from 1 to 64");
+  }
+  return std::min(4u, std::max(1u, std::thread::hardware_concurrency()));
+}
