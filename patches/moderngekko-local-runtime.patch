+  if (key >= Key::Num0 && key <= Key::Num9)
+    return static_cast<ImGuiKey>(ImGuiKey_0 + static_cast<int>(key) - static_cast<int>(Key::Num0));
+  if (key >= Key::F1 && key <= Key::F12)
