+struct InGameMenu::Impl : std::enable_shared_from_this<Impl> {
+  explicit Impl(HostActions actions_) : actions(std::move(actions_)), generation(++s_next_generation) {}
+
+  struct View {
+    bool running = false, paused = false, netplay = false, muted = false, fullscreen = false;
+    bool vsync = false, ssaa = false, hires = false;
+    int scale = 1;
+    u32 msaa = 1;
+    AspectMode aspect = AspectMode::Auto;
+    std::vector<fs::path> states;
+    std::string message;
+    std::string last_action;
+    std::vector<InGameMenuButtonRect> buttons;
+  };
+
+  HostActions actions; // Host-thread callbacks, immutable for this session.
+  const std::uint64_t generation;
+  InGameMenuInput input;
+  mutable std::mutex mutex;
+  View view;
+  std::atomic<bool> pending_action{false}, redraw_outstanding{false}, redraw_needed{false};
+  std::atomic<bool> refresh_states{true};
+  std::atomic<std::uint64_t> draw_frames{0}, actions_queued{0}, actions_completed{0};
+  Clock::time_point next_snapshot{}, next_redraw{}, next_state_refresh{}; // Host only.
+  std::time_t last_save_time = 0;
+  std::size_t save_sequence = 0;
+  std::string selected_state; // Video only; UTF-8 identity, not an unchecked path from input.
+  bool drawn_open = false;
+  std::array<bool, 8> modifiers{}; // Video only.
+
+  bool IsLive(std::uint64_t expected) const {
+    return generation == expected && input.IsAlive();
+  }
+
+  void Message(std::string text) {
+    std::lock_guard lock(mutex);
+    view.message = std::move(text);
+  }
+
+  void Queue(std::string name, std::function<void(Impl&, Core::System&)> action) {
+    if (!input.IsAlive() || pending_action.exchange(true))
+      return;
+    ++actions_queued;
+    const std::weak_ptr<Impl> weak = weak_from_this();
+    const auto expected = generation;
+    // Only enqueuing occurs under ImGui's lock. Host callbacks may pause/lock
+    // the CPU/GPU, so none may execute inline on the drawing thread.
+    Core::QueueHostJob([weak, expected, name = std::move(name), action = std::move(action)]
+                       (Core::System& system) {
+      const auto self = weak.lock();
+      if (!self || !self->IsLive(expected))
+        return;
+      if (Core::IsRunning(system)) {
+        {
+          std::lock_guard lock(self->mutex);
+          self->view.last_action = name;
+        }
+        try {
+          action(*self, system);
+        } catch (const std::exception& error) {
+          self->Message(std::string("Action failed: ") + error.what());
+        }
+        ++self->actions_completed; // Host dispatch, not asynchronous state-file completion.
+      }
+      self->pending_action.store(false);
+      self->next_snapshot = {};
+      self->redraw_needed.store(true);
+    });
+  }
+
+  void SettingsChanged() {
+    if (actions.on_settings_changed)
+      actions.on_settings_changed();
+    Message("Settings applied to this session.");
+  }
+
+  void SaveState(Core::System& system) {
+    if (NetPlay::IsNetPlayRunning()) {
+      Message("Save states are unavailable during online play.");
+      return;
+    }
+    const fs::path directory = fs::u8path(File::GetUserPath(D_STATESAVES_IDX));
+    if (directory.empty())
+      throw std::runtime_error("The save-state directory is unavailable.");
+    fs::create_directories(directory);
+    const std::time_t now = std::time(nullptr);
+    if (now != last_save_time) {
+      last_save_time = now;
+      save_sequence = 0;
+    }
+    fs::path path;
+    for (unsigned attempts = 0; attempts < 10000; ++attempts) {
+      path = directory / State::Layout::TimestampedName(now, save_sequence++, State::Layout::MANUAL_PREFIX);
+      if (!fs::exists(path))
+        break;
+      path.clear();
+    }
+    if (path.empty())
+      throw std::runtime_error("Cannot allocate a new save-state filename.");
+    State::SaveAs(system, PathToString(path));
+    Message("Save requested. The game reports completion on screen.");
+    next_state_refresh = Clock::now() + std::chrono::seconds(2);
+  }
+
+  void LoadState(Core::System& system, const fs::path& path) {
+    if (NetPlay::IsNetPlayRunning()) {
+      Message("Loading states is unavailable during online play.");
+      return;
+    }
+    const fs::path directory = fs::u8path(File::GetUserPath(D_STATESAVES_IDX));
+    // GetUserPath conventionally has a trailing separator; path comparison
+    // alone would reject every listed file even though the directory is equal.
+    if (!fs::equivalent(path.parent_path(), directory) || path.extension() != State::Layout::EXTENSION ||
+        !fs::is_regular_file(path))
+      throw std::runtime_error("The selected save state is no longer available.");
+    State::LoadAs(system, PathToString(path));
+    Message("Load requested. The game reports the result on screen.");
+  }
+
+  void RedrawPaused(Core::System& system) {
+    const auto now = Clock::now();
+    if (Core::GetState(system) != Core::State::Paused || now < next_redraw ||
+        (!input.IsOpen() && !redraw_needed.load()) || redraw_outstanding.exchange(true))
+      return;
+    redraw_needed.store(false);
+    next_redraw = now + std::chrono::milliseconds(33);
+    const std::weak_ptr<Impl> weak = weak_from_this();
+    const auto expected = generation;
+    Core::RunOnCPUThread(system, [weak, expected] {
+      const auto self = weak.lock();
+      if (!self || !self->IsLive(expected))
+        return;
+      // AsyncRequests has a single CPU producer. A host/window timer must not
+      // push directly into it, including while the emulation CPU is stepping.
+      AsyncRequests::GetInstance()->PushEvent([weak, expected] {
+        const auto owner = weak.lock();
+        if (!owner)
+          return;
+        if (owner->IsLive(expected) &&
+            Core::GetState(Core::System::GetInstance()) == Core::State::Paused && g_presenter)
+          g_presenter->Present(nullptr);
+        owner->redraw_outstanding.store(false);
+      });
+    });
+  }
+
+  void Tick() {
+    if (!input.IsAlive())
+      return;
+    auto& system = Core::System::GetInstance();
+    const auto now = Clock::now();
+    if (now >= next_snapshot) {
+      const auto state = Core::GetState(system);
+      const bool running = state == Core::State::Running || state == Core::State::Paused;
+      View update;
+      update.running = running;
+      update.paused = state == Core::State::Paused;
+      update.netplay = NetPlay::IsNetPlayRunning();
+      update.fullscreen = actions.is_fullscreen && actions.is_fullscreen();
+      if (running) {
+        update.muted = Config::Get(Config::MAIN_AUDIO_MUTED);
+        update.vsync = Config::Get(Config::GFX_VSYNC);
+        update.scale = Config::Get(Config::GFX_EFB_SCALE);
+        update.aspect = Config::Get(Config::GFX_ASPECT_RATIO);
+        update.msaa = Config::Get(Config::GFX_MSAA);
+        update.ssaa = Config::Get(Config::GFX_SSAA);
+        update.hires = Config::Get(Config::GFX_HIRES_TEXTURES);
+      }
+      {
+        std::lock_guard lock(mutex);
+        update.states = std::move(view.states);
+        update.buttons = std::move(view.buttons);
+        update.message = std::move(view.message);
+        update.last_action = std::move(view.last_action);
+        view = std::move(update);
+      }
+      next_snapshot = now + std::chrono::milliseconds(50);
+    }
+    if (input.IsOpen() && (refresh_states.exchange(false) ||
+        (next_state_refresh != Clock::time_point{} && now >= next_state_refresh))) {
+      next_state_refresh = {};
+      const fs::path directory = fs::u8path(File::GetUserPath(D_STATESAVES_IDX));
+      auto files = State::Layout::List(directory);
+      // Keep rendering/snapshots bounded even if a developer has a large archive.
+      if (files.size() > 128)
+        files.resize(128);
+      std::lock_guard lock(mutex);
+      view.states = std::move(files);
+    }
+    RedrawPaused(system);
+  }
+};
+
+std::shared_ptr<InGameMenu> InGameMenu::Create(HostActions actions) {
+  return std::shared_ptr<InGameMenu>(new InGameMenu(std::move(actions)));
+}
+InGameMenu::InGameMenu(HostActions actions) : m_impl(std::make_shared<Impl>(std::move(actions))) {}
+InGameMenu::~InGameMenu() { m_impl->input.Retire(); }
+bool InGameMenu::IsOpen() const { return m_impl->input.IsOpen(); }
+bool InGameMenu::BlocksGameInput() const { return IsOpen(); }
+void InGameMenu::Retire() { m_impl->input.Retire(); }
+bool InGameMenu::HandleInput(const FrontendUI::InputEvent& event) {
+  const bool was_open = IsOpen();
+  const bool consumed = m_impl->input.Handle(event);
+  if (!was_open && IsOpen())
+    m_impl->refresh_states.store(true);
+  if (consumed || was_open)
+    m_impl->redraw_needed.store(true);
+  return consumed;
+}
+void InGameMenu::Tick() { m_impl->Tick(); }
+
+void InGameMenu::BeginFrame() {
+  auto& self = *m_impl;
+  if (!self.input.IsAlive() || !ImGui::GetCurrentContext())
+    return;
+  auto& io = ImGui::GetIO();
+  io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard;
+  io.MouseDrawCursor = self.input.IsOpen();
+  const auto batch = self.input.Drain();
+  if (batch.reset) {
+    // ImGui can retain transitions for later frames when its input trickle
+    // queue is enabled. Clearing only held state would let those reassert it.
+    io.ClearEventsQueue();
+    io.ClearInputKeys();
+    io.ClearInputMouse();
+    self.modifiers.fill(false);
+  }
+  using namespace FrontendUI;
+  for (std::size_t i = 0; i < batch.size; ++i) {
+    const auto& event = batch.events[i];
+    switch (event.kind) {
+      case InputKind::Key: {
+        if (event.repeat)
+          break; // ImGui owns repeat timing from the original down transition.
+        const ImGuiKey key = ToImGuiKey(event.key);
+        if (key != ImGuiKey_None)
+          io.AddKeyEvent(key, event.down);
+        if (event.key >= Key::LeftCtrl && event.key <= Key::RightSuper) {
+          self.modifiers[static_cast<std::size_t>(event.key) - static_cast<std::size_t>(Key::LeftCtrl)] = event.down;
+          io.AddKeyEvent(ImGuiMod_Ctrl, self.modifiers[0] || self.modifiers[1]);
+          io.AddKeyEvent(ImGuiMod_Shift, self.modifiers[2] || self.modifiers[3]);
+          io.AddKeyEvent(ImGuiMod_Alt, self.modifiers[4] || self.modifiers[5]);
+          io.AddKeyEvent(ImGuiMod_Super, self.modifiers[6] || self.modifiers[7]);
+        }
+        break;
+      }
+      case InputKind::Character:
+        if (event.character > 0 && event.character <= 0x10ffff &&
+            (event.character < 0xd800 || event.character > 0xdfff))
+          io.AddInputCharacter(event.character);
+        break;
+      case InputKind::MousePosition:
+        if (std::isfinite(event.x) && std::isfinite(event.y))
+          io.AddMousePosEvent(event.x, event.y);
+        break;
+      case InputKind::MouseButton:
+        if (event.button >= 0 && event.button < 5)
+          io.AddMouseButtonEvent(event.button, event.down);
+        break;
+      case InputKind::MouseWheel:
+        if (std::isfinite(event.x) && std::isfinite(event.y))
+          io.AddMouseWheelEvent(event.x, event.y);
+        break;
+      case InputKind::Focus: io.AddFocusEvent(event.down); break;
+      case InputKind::Reset: break; // Drain's reset flag already released every key/button.
+    }
+  }
+}
+
+void InGameMenu::Draw() {
+  auto& self = *m_impl;
+  if (!self.input.IsAlive() || !ImGui::GetCurrentContext())
+    return;
+  if (!self.input.IsOpen()) {
+    self.drawn_open = false;
+    std::lock_guard lock(self.mutex);
+    self.view.buttons.clear();
+    return;
+  }
+  ++self.draw_frames;
+  Impl::View view;
+  {
+    std::lock_guard lock(self.mutex);
+    view = self.view;
+  }
+  std::vector<InGameMenuButtonRect> buttons;
+  const bool pending = self.pending_action.load();
+  const bool active = view.running && !pending;
+  const auto& io = ImGui::GetIO();
+  if (!self.drawn_open) {
+    ImGui::SetNextWindowPos(ImVec2(io.DisplaySize.x * 0.5f, io.DisplaySize.y * 0.5f),
+                            ImGuiCond_Always, ImVec2(0.5f, 0.5f));
+    ImGui::SetNextWindowFocus();
+  }
+  self.drawn_open = true;
+  ImGui::SetNextWindowSize(ImVec2(std::max(1.0f, std::min(650.0f, io.DisplaySize.x - 24.0f)),
+                                std::max(1.0f, std::min(650.0f, io.DisplaySize.y - 24.0f))), ImGuiCond_FirstUseEver);
+  auto record = [&](const char* id, bool enabled) {
+    const auto min = ImGui::GetItemRectMin();
+    const auto max = ImGui::GetItemRectMax();
+    buttons.push_back({id, min.x, min.y, max.x - min.x, max.y - min.y,
+                       enabled && ImGui::IsItemVisible()});
+  };
+  auto button = [&](const char* label, const char* id, bool enabled) {
+    ImGui::BeginDisabled(!enabled);
+    const bool pressed = ImGui::Button(label);
+    record(id, enabled);
+    ImGui::EndDisabled();
+    return pressed;
+  };
+  bool open = true;
+  if (ImGui::Begin("Digimon World 4 - Settings", &open, ImGuiWindowFlags_NoCollapse)) {
+    ImGui::TextUnformatted("F1 or Escape closes this menu. Opening it keeps the game running.");
+    ImGui::Text("Session: %s%s", view.paused ? "Paused" : "Running", view.netplay ? " | Online" : "");
+    if (button(view.paused ? "Resume" : "Pause", view.paused ? "resume" : "pause", active && !view.netplay)) {
+      const bool pause = !view.paused;
+      self.Queue(pause ? "pause" : "resume", [pause](Impl& owner, Core::System& system) {
+        if (NetPlay::IsNetPlayRunning()) {
+          owner.Message("Pause is unavailable during online play.");
+          return;
+        }
+        Core::SetState(system, pause ? Core::State::Paused : Core::State::Running);
+        owner.Message(Core::GetState(system) == Core::State::Paused ? "Game paused." : "Game running.");
+      });
+    }
+    ImGui::SameLine();
+    if (button(view.muted ? "Unmute" : "Mute", "mute",
+               active && (!view.muted || self.actions.allow_audio_unmute))) {
+      const bool mute = !view.muted;
+      self.Queue("mute", [mute](Impl& owner, Core::System& system) {
+        if (!mute && !owner.actions.allow_audio_unmute)
+          return;
+        const std::weak_ptr<Impl> weak = owner.weak_from_this();
+        const auto generation = owner.generation;
+        Core::RunOnCPUThread(system, [weak, generation, mute] {
+          const auto session = weak.lock();
+          if (!session || !session->IsLive(generation))
+            return;
+          Config::SetCurrent(Config::MAIN_AUDIO_MUTED, mute);
+          AudioCommon::UpdateSoundStream(Core::System::GetInstance());
+        });
+        owner.Message(mute ? "Mute requested." : "Unmute requested.");
+      });
+    }
+    ImGui::SameLine();
+    if (button(view.fullscreen ? "Windowed" : "Fullscreen", "fullscreen",
+               active && static_cast<bool>(self.actions.toggle_fullscreen))) {
+      self.Queue("fullscreen", [](Impl& owner, Core::System&) {
+        if (owner.actions.toggle_fullscreen)
+          owner.actions.toggle_fullscreen();
+      });
+    }
+    if (view.netplay)
+      ImGui::TextWrapped("Pause, save states and graphics changes are disabled during online play.");
+    if (!self.actions.allow_audio_unmute)
+      ImGui::TextDisabled("This diagnostic session requires silent audio.");
+
+    ImGui::SeparatorText("Save states");
+    if (button("Save new state", "save_state", active && !view.netplay))
+      self.Queue("save_state", [](Impl& owner, Core::System& system) { owner.SaveState(system); });
+    ImGui::SameLine();
+    if (button("Refresh list", "refresh_states", active))
+      self.refresh_states.store(true);
+    if (self.selected_state.empty() && !view.states.empty())
+      self.selected_state = PathToString(view.states.front());
+    const auto selected = std::find_if(view.states.begin(), view.states.end(), [&](const fs::path& path) {
+      return PathToString(path) == self.selected_state;
+    });
+    const std::string selected_label = selected == view.states.end() ? "Select a state" : PathToString(selected->filename());
+    ImGui::SetNextItemWidth(-1);
+    if (ImGui::BeginCombo("##saved_states", selected_label.c_str())) {
+      for (const auto& path : view.states) {
+        const std::string name = PathToString(path.filename());
+        if (ImGui::Selectable(name.c_str(), PathToString(path) == self.selected_state))
+          self.selected_state = PathToString(path);
+      }
+      ImGui::EndCombo();
+    }
+    if (button("Load selected state", "load_state", active && !view.netplay && selected != view.states.end())) {
+      const fs::path path = *selected;
+      self.Queue("load_state", [path](Impl& owner, Core::System& system) { owner.LoadState(system, path); });
+    }
+    ImGui::TextDisabled("Newest 128 states. Loading replaces your current game progress.");
+
+    ImGui::SeparatorText("Graphics");
+    ImGui::TextDisabled("Changes apply to this session. Game speed is unchanged.");
+    ImGui::BeginDisabled(!active || view.netplay);
+    const int max_scale = std::min(12, static_cast<int>(g_backend_info.MaxTextureSize / 640));
+    const std::string current_scale = view.scale == 0 ? "Automatic" :
+      std::to_string(view.scale) + "x (" + std::to_string(view.scale * 640) + " x " + std::to_string(view.scale * 528) + ")";
+    if (ImGui::BeginCombo("Internal resolution", current_scale.c_str())) {
+      for (int scale : {1, 2, 3, 4, 5, 6, 8, 10, 12}) {
+        if (scale > max_scale)
+          continue;
+        const std::string label = std::to_string(scale) + "x (" + std::to_string(scale * 640) + " x " + std::to_string(scale * 528) + ")";
+        if (ImGui::Selectable(label.c_str(), view.scale == scale))
+          self.Queue("internal_resolution", [scale](Impl& owner, Core::System&) {
+            if (!NetPlay::IsNetPlayRunning()) {
+              Config::SetCurrent(Config::GFX_EFB_SCALE, scale);
+              owner.SettingsChanged();
+            }
+          });
+      }
+      ImGui::EndCombo();
+    }
+    if (ImGui::BeginCombo("Aspect ratio", AspectName(view.aspect))) {
+      for (const auto aspect : {AspectMode::Auto, AspectMode::ForceStandard, AspectMode::ForceWide, AspectMode::Stretch}) {
+        if (ImGui::Selectable(AspectName(aspect), view.aspect == aspect))
+          self.Queue("aspect_ratio", [aspect](Impl& owner, Core::System&) {
+            if (!NetPlay::IsNetPlayRunning()) {
+              Config::SetCurrent(Config::GFX_ASPECT_RATIO, aspect);
+              owner.SettingsChanged();
+            }
+          });
+      }
+      ImGui::EndCombo();
+    }
+    const std::string aa_label = view.msaa <= 1 ? "Off" : std::to_string(view.msaa) + (view.ssaa ? "x SSAA" : "x MSAA");
+    if (ImGui::BeginCombo("Anti-aliasing", aa_label.c_str())) {
+      for (const u32 samples : g_backend_info.AAModes) {
+        const std::string label = samples <= 1 ? "Off" : std::to_string(samples) + "x MSAA";
+        if (ImGui::Selectable(label.c_str(), view.msaa == samples && !view.ssaa))
+          self.Queue("anti_aliasing", [samples](Impl& owner, Core::System&) {
+            if (!NetPlay::IsNetPlayRunning()) {
+              const Config::ConfigChangeCallbackGuard guard;
+              Config::SetCurrent(Config::GFX_MSAA, samples);
+              Config::SetCurrent(Config::GFX_SSAA, false);
+              owner.SettingsChanged();
+            }
+          });
+      }
+      ImGui::EndCombo();
+    }
+    bool vsync = view.vsync;
+    if (ImGui::Checkbox("VSync", &vsync))
+      self.Queue("vsync", [vsync](Impl& owner, Core::System&) {
+        if (!NetPlay::IsNetPlayRunning()) {
+          Config::SetCurrent(Config::GFX_VSYNC, vsync);
+          owner.SettingsChanged();
+        }
+      });
+    bool hires = view.hires;
+    if (ImGui::Checkbox("Load installed HD texture packs", &hires))
+      self.Queue("hd_textures", [hires](Impl& owner, Core::System&) {
+        if (!NetPlay::IsNetPlayRunning()) {
+          Config::SetCurrent(Config::GFX_HIRES_TEXTURES, hires);
+          owner.SettingsChanged();
+        }
+      });
+    ImGui::EndDisabled();
+    ImGui::Separator();
+    if (!view.message.empty())
+      ImGui::TextWrapped("%s", view.message.c_str());
+    if (pending)
+      ImGui::TextDisabled("Applying action...");
+    if (button("Close menu", "close", true))
+      open = false;
+    ImGui::SameLine();
+    if (button("Exit game", "exit", active && static_cast<bool>(self.actions.request_shutdown)))
+      self.Queue("exit", [](Impl& owner, Core::System&) {
+        if (owner.actions.request_shutdown)
+          owner.actions.request_shutdown();
+      });
+  }
+  ImGui::End();
+  if (!open) {
+    self.input.Close();
+    self.redraw_needed.store(true);
+  }
+  {
+    std::lock_guard lock(self.mutex);
+    self.view.buttons = std::move(buttons);
+  }
+}
+
+InGameMenuSnapshot InGameMenu::Snapshot() const {
+  const auto& self = *m_impl;
+  InGameMenuSnapshot snapshot;
+  snapshot.generation = self.generation;
+  snapshot.alive = self.input.IsAlive();
+  snapshot.open = self.input.IsOpen();
+  snapshot.capture = snapshot.open;
+  snapshot.input_events = self.input.Events();
+  snapshot.input_overflows = self.input.Overflows();
+  snapshot.draw_frames = self.draw_frames.load();
+  snapshot.actions_queued = self.actions_queued.load();
+  snapshot.actions_completed = self.actions_completed.load();
+  std::lock_guard lock(self.mutex);
+  snapshot.paused = self.view.paused;
+  snapshot.netplay = self.view.netplay;
+  snapshot.last_action = self.view.last_action;
+  snapshot.message = self.view.message;
+  snapshot.buttons = self.view.buttons;
+  return snapshot;
+}
