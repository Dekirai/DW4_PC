    {
      "name": "end reason",
      "sql": "SELECT end_reason FROM instance_history",
      "expect": "^host_left$"
    }
  ],
  "clients": [
    {
      "name": "a",
      "script": "a.script",
      "card": "k5",
      "start": 0
    },
    {
      "name": "b",
      "script": "b.script",
      "card": "k9",
      "start": 3,
      "seed_story": true,
      "upload_card": true
    }
  ]
