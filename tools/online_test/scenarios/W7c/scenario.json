{
  "desc": "a half-open cut: the proxy holds a's packets for 20 s without closing; the grace starts within 5 s, no lagOut, a resumes",
  "world": true,
  "autochoice": "first",
  "seed_story": true,
  "frames": 60000,
  "timeout": 1000,
  "min_shared_ticks": 0,
  "allow_close": true,
  "db_checks": [
    {
      "name": "not ended by the cut",
      "sql": "SELECT COUNT(*), SUM(end_reason = 'host_lost') FROM instance_history",
      "expect": "^1\t0$"
    }
  ],
  "clients": [
    {
      "name": "a",
      "script": "a.script",
      "card": "k5",
      "start": 0,
      "cut": {
        "at": 200,
        "seconds": 20,
        "mode": "half"
      }
    },
    {
      "name": "b",
      "script": "b.script",
      "card": "k2",
      "start": 3,
      "seed_story": true
    }
  ]
}
