# W25, host a (k4): in stag0101 with b when the server is killed.
campaign until stage=stagml11,control
idle until epoch>=@80
explore mate00 yes until stage=stag0101,control
log a hosts
wander -150 -60 20 until present=2,sealed>=600
log b joined
wander -150 -60 20 until stage=stagml11,control fail epoch>=@330
log a home
idle until frames>=120
