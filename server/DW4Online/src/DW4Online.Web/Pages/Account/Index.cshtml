@page "/account"
@model DW4Online.Web.Pages.Account.IndexModel
@{
    ViewData["Title"] = "Account";
    var locked = Model.Account.MustChangePassword;
}
<h1>Account: @Model.Account.Username</h1>

@if (Model.Message is not null)
{
    <div class="notice ok">@Model.Message</div>
}
@if (Model.Error is not null)
{
    <div class="notice error">@Model.Error</div>
}
@if (locked)
{
    <div class="notice warn">You logged in with a temporary password. Choose a new password before you continue.</div>
}
@if (Model.NewRecoveryCode is not null)
{
    <div class="panel">
        <h2>Your new recovery code</h2>
        <p>Write it down; it is shown <strong>once</strong>.</p>
        <p class="secret">@Model.NewRecoveryCode</p>
    </div>
}

<div class="grid">
    <div class="panel">
        <h2>Overview</h2>
        <dl class="facts">
            <dt>User name</dt><dd>@Model.Account.Username</dd>
            <dt>Role</dt><dd>@Model.Account.Role</dd>
            <dt>Member since</dt><dd>@Format.Day(Model.Account.CreatedAt)</dd>
            <dt>Last login</dt><dd>@Format.Date(Model.Account.LastLoginAt)</dd>
            <dt>E-mail</dt><dd>@(Model.Account.Email ?? "none")</dd>
            <dt>Profile</dt><dd><a href="~/u/@Model.Account.Username">@(Model.Account.ProfilePublic ? "public" : "private")</a></dd>
        </dl>
    </div>
    <div class="panel">
        <h2>Online character</h2>
        @if (Model.Character is { } c)
        {
            <dl class="facts">
                <dt>Digimon</dt><dd>@Model.DigimonName(c.Summary.Digimon)</dd>
                <dt>Name</dt><dd>@c.Summary.PlayerName</dd>
                <dt>Level</dt><dd>@c.Summary.Level</dd>
                <dt>Play time</dt><dd>@Format.Duration(c.PlaySeconds)</dd>
                <dt>Saved</dt><dd>@Format.Date(c.UpdatedAt) (revision @c.Revision)</dd>
            </dl>
        }
        else
        {
            <p class="muted">No online character yet. It starts from zero the first time you play online.</p>
        }
    </div>
</div>

<h2>Password</h2>
<div class="panel">
    <form method="post" asp-page-handler="Password" class="stack">
        <input type="text" name="username" value="@Model.Account.Username" autocomplete="username" hidden />
        <label>Current password <input type="password" asp-for="CurrentPassword" autocomplete="current-password" required maxlength="128" /></label>
        <label>New password <input type="password" asp-for="NewPassword" autocomplete="new-password" required minlength="10" maxlength="128" /></label>
        <label>Repeat the new password <input type="password" asp-for="ConfirmPassword" autocomplete="new-password" required minlength="10" maxlength="128" /></label>
        <button type="submit">Change password</button>
        <span class="muted small">Changing the password logs out every other session (game and website).</span>
    </form>
</div>

@if (!locked)
{
    <h2>E-mail</h2>
    <div class="panel">
        <p class="muted small">Optional. It is not shown to anyone and not used yet (no e-mails are sent today).</p>
        <form method="post" asp-page-handler="Email" class="stack">
            <label>E-mail address <input type="email" asp-for="Email" autocomplete="email" maxlength="254" /></label>
            <label>Current password <input type="password" asp-for="CurrentPassword" autocomplete="current-password" required maxlength="128" /></label>
            <button type="submit">Save e-mail</button>
            <span class="muted small">Leave the address empty to remove it.</span>
        </form>
    </div>

    <h2>Recovery code</h2>
    <div class="panel">
        <p>The recovery code resets a forgotten password. Make a new one if you lost it or think someone saw it.</p>
        <form method="post" asp-page-handler="Recovery" class="stack">
            <label>Current password <input type="password" asp-for="CurrentPassword" autocomplete="current-password" required maxlength="128" /></label>
            <button type="submit">Make a new recovery code</button>
        </form>
    </div>

    <h2>Profile</h2>
    <div class="panel">
        <form method="post" asp-page-handler="Visibility" class="stack">
            <label class="check"><input type="checkbox" asp-for="Public" /> Show my online character and achievements on my public profile</label>
            <button type="submit" class="secondary">Save</button>
        </form>
    </div>

    <h2>Cloud save</h2>
    <div class="panel">
        @if (Model.Cloud is { } cloud)
        {
            <p>Your private backup of the local save (only you can see it):</p>
            <dl class="facts">
                <dt>Revision</dt><dd>@cloud.Latest.Revision</dd>
                <dt>Uploaded</dt><dd>@Format.Date(cloud.Latest.UploadedAt)@(cloud.Latest.DeviceName is { } d ? $" from {d}" : "")</dd>
                <dt>Size</dt><dd>@Format.Number(cloud.Latest.SizeBytes) bytes (@cloud.Latest.Format)</dd>
                <dt>Older revisions</dt><dd>@cloud.History.Count</dd>
            </dl>
            <p><a class="button secondary" href="~/account?handler=CloudSave">Download</a></p>
            <h3>Delete the cloud save</h3>
            <form method="post" asp-page-handler="DeleteCloud" class="stack">
                <label>Current password <input type="password" asp-for="CurrentPassword" autocomplete="current-password" required maxlength="128" /></label>
                <label class="check"><input type="checkbox" asp-for="ConfirmCloudDelete" /> Yes, delete the cloud save and its older revisions</label>
                <button type="submit" class="danger">Delete cloud save</button>
                <span class="muted small">Your local save in the game stays as it is.</span>
            </form>
        }
        else
        {
            <p class="muted">No cloud save yet. Upload one from the game's online menu.</p>
        }
    </div>

    <h2>Sessions</h2>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Where</th><th>Kind</th><th>Last used</th><th>Expires</th><th></th></tr></thead>
            <tbody>
            @foreach (var s in Model.Sessions)
            {
                <tr>
                    <td>@(s.DeviceName ?? "unknown")@(s.Id == Model.Session.SessionId ? " (this browser)" : "")</td>
                    <td>@s.Kind</td>
                    <td>@Format.Date(s.LastUsedAt ?? s.CreatedAt)</td>
                    <td>@Format.Day(s.ExpiresAt)</td>
                    <td>
                        @if (s.Id != Model.Session.SessionId)
                        {
                            <form method="post" asp-page-handler="Revoke" class="inline">
                                <input type="hidden" name="SessionId" value="@s.Id" />
                                <button type="submit" class="link">Log out</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <form method="post" asp-page-handler="RevokeOthers">
        <p><button type="submit" class="secondary">Log out everywhere else</button></p>
    </form>

    <h2>Delete account</h2>
    <div class="panel">
        <p>Deletes your account with its online character, cloud save, achievements, statistics and sessions. This cannot
            be undone. See the <a href="~/privacy">privacy page</a> for what stays (anonymised security logs, backups until
            they roll over).</p>
        <form method="post" asp-page-handler="Delete" class="stack">
            <label>Current password <input type="password" asp-for="CurrentPassword" autocomplete="current-password" required maxlength="128" /></label>
            <label class="check"><input type="checkbox" asp-for="ConfirmDelete" /> Yes, delete my account and its data</label>
            <button type="submit" class="danger">Delete account</button>
        </form>
    </div>
}
