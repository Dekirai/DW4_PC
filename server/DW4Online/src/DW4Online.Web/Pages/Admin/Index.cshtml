@page "/admin"
@model DW4Online.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Admin";
}
<h1>Admin</h1>

<h2>Accounts</h2>
<form method="get" class="stack">
    <label>User name or e-mail starts with <input type="search" asp-for="Q" maxlength="254" /></label>
    <button type="submit" class="secondary">Search</button>
</form>
<div class="table-wrap">
    <table>
        <thead><tr><th>User</th><th>Role</th><th>Status</th><th>Created</th><th>Last login</th></tr></thead>
        <tbody>
        @foreach (var a in Model.Results)
        {
            <tr>
                <td><a href="~/admin/account/@a.Username">@a.Username</a>@(a.MustChangePassword ? " (temporary password)" : "")</td>
                <td>@a.Role</td>
                <td>
                    @if (a.Status == "active")
                    {
                        <span class="badge ok">active</span>
                    }
                    else
                    {
                        <span class="badge bad">@a.Status</span>
                    }
                </td>
                <td>@Format.Day(a.CreatedAt)</td>
                <td>@Format.Date(a.LastLoginAt)</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<h2>Reports</h2>
<p>@(Model.OpenReports == 0 ? "No open reports." : Model.OpenReports == 1 ? "1 open report." : $"{Model.OpenReports} open reports.")
    <a href="~/admin/reports">The players' reports</a>, with Done.</p>

<h2>World</h2>
<p>@Model.Counts.PlayersOnline players online, @Model.Counts.Instances instances
    (@string.Join(", ", Model.Counts.Areas.Select(a => $"{a.Name} {a.Instances}"))).
    <a href="~/admin/instances">Every instance</a>, Private ones included, with End and Remove;
    <a href="~/admin/audit">the staff audit list</a>.</p>
