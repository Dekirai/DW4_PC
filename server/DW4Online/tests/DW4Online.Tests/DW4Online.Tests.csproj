<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests without a database: record decoding (mirrors tests/save_data_tests.cpp), validation, security, rules, relay. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\DW4Online.Domain\DW4Online.Domain.csproj" />
    <ProjectReference Include="..\..\src\DW4Online.Relay\DW4Online.Relay.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\sql\*.sql" Link="sql\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The room story's census and golden vectors (SEAMLESS.md 8), shared with the game client's ctest online_story. -->
    <Content Include="..\..\..\..\data\online\story_sets.json" Link="story\story_sets.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\data\online\story_golden.json" Link="story\story_golden.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
