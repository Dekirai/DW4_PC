# Additions to the [mysqld] section of the MariaDB 11.4 instance's my.ini on the server (see DEPLOY.md, section 1).
# Restart only the MariaDB service afterwards: Restart-Service MariaDB
# (once DW4Online is installed it depends on MariaDB: Stop-Service DW4Online; Restart-Service MariaDB; Start-Service DW4Online)
[mysqld]
# Local connections only: the service runs on the same machine; port 3306 stays closed in the firewall.
bind-address=127.0.0.1
# The schema sets utf8mb4_unicode_ci explicitly; the server default matches it (11.x changed its default collation).
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci
# The service writes UTC; a UTC session time zone keeps CURRENT_TIMESTAMP defaults consistent.
default-time-zone='+00:00'
# Cloud saves are about 90 KB (at most 1 MiB); 16 MB leaves room for dumps and restores.
max_allowed_packet=16M
# Enough for tens of thousands of accounts; raise with more players.
innodb_buffer_pool_size=512M

# --- Variant 1b: an existing XAMPP MariaDB 10.4 (DEPLOY.md section 1.1) ----------------------------------------------
# XAMPP keeps its my.ini in <XAMPP folder>\mysql\bin\my.ini. Add only these two lines at the END of its [mysqld] section
# (just above the line [mysqldump]); a later line wins over XAMPP's own max_allowed_packet=1M further up:
#
#   bind-address=127.0.0.1
#   max_allowed_packet=16M
#
# Leave everything else as XAMPP ships it: other databases on that server rely on it, and DW4Online does not need more
# (its tables name utf8mb4_unicode_ci themselves, it writes every time in UTC itself, and its tests pass with XAMPP's
# default settings: sql_mode without STRICT_TRANS_TABLES, collation-server utf8mb4_general_ci, a 16 MB buffer pool).
# Then restart the service "mysql" (Restart-Service mysql; once DW4Online depends on it: Stop-Service DW4Online first).
