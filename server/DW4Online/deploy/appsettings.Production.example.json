{
  "_comment": "Copy to D:\\Dekirai\\Servers\\DW4Online\\config\\appsettings.Production.json (outside the app folder, readable only by Administrators, SYSTEM and NT SERVICE\\DW4Online). It holds secrets: never commit it.",
  "Kestrel": {
    "Endpoints": {
      "Https": { "Url": "https://0.0.0.0:443" }
    }
  },
  "Tls": {
    "StoreHostName": "dw4.example.org",
    "StoreName": "My",
    "StoreLocation": "LocalMachine",
    "AcmeChallengeDirectory": ""
  },
  "Database": {
    "ConnectionString": "Server=127.0.0.1;Port=3306;Database=dw4online;User ID=dw4online;Password=<service password>",
    "AutoMigrate": true
  },
  "Service": {
    "Name": "DW4Online",
    "Motd": "",
    "RelayHost": "dw4.example.org",
    "RelayPort": 52041
  },
  "Relay": {
    "Enabled": true,
    "ListenAddress": "0.0.0.0",
    "Port": 52041,
    "TicketKey": "<output of DW4Online.Server.exe gen-relay-key>"
  },
  "Play": {
    "RequireRoom": true,
    "MinimumProtocol": 41,
    "CurrentProtocol": 41,
    "MinimumClientVersion": "",
    "CurrentClientVersion": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Directory": "D:\\Dekirai\\Servers\\DW4Online\\logs",
      "MinimumLevel": "Information",
      "RetainDays": 30
    }
  }
}
