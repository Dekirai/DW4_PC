<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Only nuget.org. Exact versions already in the global packages folder restore without network access. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
